  cmb ( VUNOP SHAPE VUNOP_SHAPE ) : SpectecTerminal

      if typecheck(SHAPE, shape) /\ typecheck(VUNOP_SHAPE, vunop ( SHAPE )) .
  cmb ( VVBINOP VECTYPE VVBINOP ) : SpectecTerminal

      if typecheck(VECTYPE, vectype) /\ typecheck(VVBINOP, vvbinop) .
  cmb ( VVTERNOP VECTYPE VVTERNOP ) : SpectecTerminal

      if typecheck(VECTYPE, vectype) /\ typecheck(VVTERNOP, vvternop) .
  cmb ( VVTESTOP VECTYPE VVTESTOP ) : SpectecTerminal

      if typecheck(VECTYPE, vectype) /\ typecheck(VVTESTOP, vvtestop) .
  cmb ( VVUNOP VECTYPE VVUNOP ) : SpectecTerminal

      if typecheck(VECTYPE, vectype) /\ typecheck(VVUNOP, vvunop) .
  cmb ( ZERO SZ ) : SpectecTerminal



      if SZ >= 32 /\ typecheck(SZ, sz) .
  cmb ( lbrack U64 dotdot U64SEQ rbrack ) : SpectecTerminal

      if typecheck(U64, uN ( 64 )) /\ typecheck(U64SEQ, uN ( 64 )) .
  cmb ( lbrack U64 dotdot eps rbrack ) : SpectecTerminal

      if typecheck(U64, uN ( 64 )) .
  cmb ( lparenREF-EXN-ADDR EXNADDR rparenTHROW-REF ) : SpectecTerminal

      if EXNADDR : Exnaddr .
  cmb ( w--DEF RECTYPE LOWN ) : SpectecTerminal


      if typecheck(RECTYPE, rectype) .
  cmb ( w--IDX TYPEIDX ) : SpectecTerminal

      if typecheck(TYPEIDX, typeidx) .
  cmb ( w--RESULT VALTYPESEQ ) : SpectecTerminal

      if typecheck(VALTYPESEQ, valtype) .
  cmb ( w--VALS VALSEQ ) : SpectecTerminal

      if typecheck(VALSEQ, val) .
  mb ( {item('LOCALS, ( F-FRAME-LOCALS-0 )) ; item('MODULE, ( F-FRAME-MODULE-1 ))} ) : Frame
   .
  mb ( {item('TAGS, ( F-STORE-TAGS-0 )) ; item('GLOBALS, ( F-STORE-GLOBALS-1 )) ; item('MEMS, ( F-STORE-MEMS-2 )) ; item('TABLES, ( F-STORE-TABLES-3 )) ; item('FUNCS, ( F-STORE-FUNCS-4 )) ; item('DATAS, ( F-STORE-DATAS-5 )) ; item('ELEMS, ( F-STORE-ELEMS-6 )) ; item('STRUCTS, ( F-STORE-STRUCTS-7 )) ; item('ARRAYS, ( F-STORE-ARRAYS-8 )) ; item('EXNS, ( F-STORE-EXNS-9 ))} ) : Store
   .
  mb ( {item('TYPES, ( F-CONTEXT-TYPES-0 )) ; item('RECS, ( F-CONTEXT-RECS-1 )) ; item('TAGS, ( F-CONTEXT-TAGS-2 )) ; item('GLOBALS, ( F-CONTEXT-GLOBALS-3 )) ; item('MEMS, ( F-CONTEXT-MEMS-4 )) ; item('TABLES, ( F-CONTEXT-TABLES-5 )) ; item('FUNCS, ( F-CONTEXT-FUNCS-6 )) ; item('DATAS, ( F-CONTEXT-DATAS-7 )) ; item('ELEMS, ( F-CONTEXT-ELEMS-8 )) ; item('LOCALS, ( F-CONTEXT-LOCALS-9 )) ; item('LABELS, ( F-CONTEXT-LABELS-10 )) ; item('RETURN, ( F-CONTEXT-RETURN-11 )) ; item('REFS, ( F-CONTEXT-REFS-12 ))} ) : Context
   .
  mb ( {item('TYPES, ( F-CONTEXT-TYPES-0 )) ; item('RECS, ( F-CONTEXT-RECS-1 )) ; item('TAGS, ( F-CONTEXT-TAGS-2 )) ; item('GLOBALS, ( F-CONTEXT-GLOBALS-3 )) ; item('MEMS, ( F-CONTEXT-MEMS-4 )) ; item('TABLES, ( F-CONTEXT-TABLES-5 )) ; item('FUNCS, ( F-CONTEXT-FUNCS-6 )) ; item('DATAS, ( F-CONTEXT-DATAS-7 )) ; item('ELEMS, ( F-CONTEXT-ELEMS-8 )) ; item('LOCALS, ( F-CONTEXT-LOCALS-9 )) ; item('LABELS, ( F-CONTEXT-LABELS-10 )) ; item('RETURN, eps) ; item('REFS, ( F-CONTEXT-REFS-12 ))} ) : Context
   .
  eq typecheck(( AND ), vvbinop) = true .
  eq typecheck(( ANDNOT ), vvbinop) = true .
  eq typecheck(( ANY ), absheaptype) = true .
  eq typecheck(( ARRAY ), absheaptype) = true .
  eq typecheck(( BITSELECT ), vvternop) = true .
  eq typecheck(( BOT ), absheaptype) = true .
