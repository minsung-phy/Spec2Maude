--- Fixed modelcheck rules; the generated module supplies the input data.
load model-checker.maude

mod WASM-MODELCHECK-DRIVER is
  protecting WASM-BUILTINS .
  including MODEL-CHECKER .

  sort ModelState .
  subsort ModelState < State .
  op boot : -> ModelState [ctor] .
  op init : KState -> ModelState [ctor frozen (1)] .
  op ready : SpectecTerminal -> ModelState [ctor] .
  op exec : KState -> ModelState [ctor frozen (1)] .
  op finished : ValList -> ModelState [ctor] .
  --- $invoke is undefined unless the arguments satisfy Val_ok.
  op invalid-invocation : -> ModelState [ctor] .

  op inputModule : -> SpectecTerminal .
  op inputName : -> SpectecTerminals .
  op inputArgs : -> ValList .
  op emptyStore : -> SpectecTerminal .
  op expected : -> ValList .
  op rejected : -> ValList .
  op findFunc : SpectecTerminals SpectecTerminals ~> Nat .
  op hasExport : SpectecTerminals SpectecTerminals -> Bool .
  op invocation : SpectecTerminal -> SpectecTerminal .
  op isConfig : SpectecTerminal -> Bool .
  op returned : ValList -> Prop [ctor] .

  vars C C2 Z XA : SpectecTerminal .
  var IS : InstrList .
  vars NAME EXPORT-PREFIX EXPORTS : SpectecTerminals .
  var RESULT : ValList .
  var ADDR : Nat .
  var K : Holes .
  var ST : ModelState .
  var P : Prop .

  eq emptyStore = {
    field('TAGS, eps) ; field('GLOBALS, eps) ; field('MEMS, eps) ;
    field('TABLES, eps) ; field('FUNCS, eps) ; field('DATAS, eps) ;
    field('ELEMS, eps) ; field('STRUCTS, eps) ; field('ARRAYS, eps) ;
    field('EXNS, eps)
  } .

  ceq findFunc(
    EXPORT-PREFIX {field('NAME, NAME) ; field('ADDR, FUNC(ADDR))} EXPORTS,
    NAME) = ADDR
    if not hasExport(EXPORT-PREFIX, NAME) .
  eq hasExport(
    EXPORT-PREFIX {field('NAME, NAME) ; field('ADDR, XA)} EXPORTS,
    NAME) = true .
  eq hasExport(EXPORTS, NAME) = false [owise] .

  crl [instantiate] : boot => init(kstate(C, none))
    if instantiate(emptyStore, inputModule, eps) => C .
  crl [init-step] : init(kstate(C, K)) => init(kstate(C2, K))
    if Step(C) => C2 .
  rl [initialize] : init(kstate(Z ; eps, none)) => ready(Z) .
  eq invocation(Z) = invoke(spectec-store(Z),
      findFunc((spectec-moduleinst(Z) . 'EXPORTS), inputName), inputArgs) .
  eq isConfig(Z ; IS) = true .
  eq isConfig(C) = false [owise] .

  crl [invoke] : ready(Z) => exec(kstate(C2, none))
    if C2 := invocation(Z) /\ isConfig(C2) .
  crl [invalid-invocation] : ready(Z) => invalid-invocation
    if not isConfig(invocation(Z)) .
  crl [execute-step] : exec(kstate(C, K)) => exec(kstate(C2, K))
    if Step(C) => C2 .
  rl [finished] : exec(kstate(Z ; RESULT, none)) => finished(RESULT) .

  eq finished(RESULT) |= returned(RESULT) = true .
  eq ST |= P = false [owise] .
endm
