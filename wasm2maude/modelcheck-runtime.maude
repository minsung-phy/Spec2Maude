--- Fixed modelcheck rules; the generated module supplies the input data.
--- WASM-INVOCATION is in run-runtime.maude, beside this file.
load run-runtime.maude
load model-checker.maude

mod WASM-MODELCHECK-DRIVER is
  including WASM-INVOCATION .
  including MODEL-CHECKER .

  sort ModelState .
  subsort ModelState < State .
  op boot : -> ModelState [ctor] .
  op init : KState -> ModelState [ctor] .
  op ready : SpectecTerminal -> ModelState [ctor] .
  op exec : KState -> ModelState [ctor] .
  op finished : ValList -> ModelState [ctor] .
  --- $invoke is undefined unless the arguments satisfy Val_ok.
  op invalid-invocation : -> ModelState [ctor] .

  op expected : -> ValList .
  op rejected : -> ValList .
  op returned : ValList -> Prop [ctor] .

  vars C C2 Z : SpectecTerminal .
  var RESULT : ValList .
  var ST : ModelState .
  var P : Prop .

  crl [instantiate] : boot => init(kstate(C, none))
    if instantiate(emptyStore, inputModule, nil) => C .
  rl [initialize] : init(kstate(Step(Z ; nil), none)) => ready(Z) .

  crl [invoke] : ready(Z) => exec(kstate(C2, none))
    if C2 := invocation(Z) /\ isConfig(C2) .
  crl [invalid-invocation] : ready(Z) => invalid-invocation
    if not isConfig(invocation(Z)) .
  rl [finished] : exec(kstate(Step(Z ; RESULT), none)) => finished(RESULT) .

  eq finished(RESULT) |= returned(RESULT) = true .
  eq ST |= P = false [owise] .
endm
