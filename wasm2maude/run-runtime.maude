--- Fixed run rules; the generated module supplies the input data.

--- Invocation of an export of a fresh instance, shared with the modelcheck
--- runtime (modelcheck-runtime.maude). The generated module supplies the
--- empty store of its Wasm version and the input.
mod WASM-INVOCATION is
  protecting WASM-BUILTINS .

  op inputModule : -> SpectecTerminal .
  op inputName : -> SpectecTerminals .
  op inputArgs : -> ValList .
  op emptyStore : -> SpectecTerminal .
  op findFunc : SpectecTerminals SpectecTerminals ~> Nat .
  op hasExport : SpectecTerminals SpectecTerminals -> Bool .
  op invocation : SpectecTerminal -> SpectecTerminal .
  op isConfig : SpectecTerminal -> Bool .

  vars C Z XA : SpectecTerminal .
  --- The instructions of a configuration (InstrList in Wasm 3.0,
  --- AdmininstrList in 1.0 and 2.0).
  var IS : SpectecTerminals .
  vars NAME EXPORT-PREFIX EXPORTS : SpectecTerminals .
  var ADDR : Nat .

  ceq findFunc(
    EXPORT-PREFIX {field('NAME, NAME) ; field('ADDR, FUNC(ADDR))} EXPORTS,
    NAME) = ADDR
    if not hasExport(EXPORT-PREFIX, NAME) .
  eq hasExport(
    EXPORT-PREFIX {field('NAME, NAME) ; field('ADDR, XA)} EXPORTS,
    NAME) = true .
  eq hasExport(EXPORTS, NAME) = false [owise] .

  eq invocation(Z) = invoke(spectec-store(Z),
      findFunc((spectec-moduleinst(Z) . 'EXPORTS), inputName), inputArgs) .
  eq isConfig(Z ; IS) = true .
  eq isConfig(C) = false [owise] .
endm

mod WASM-RUN-DRIVER is
  including WASM-INVOCATION .

  --- One rewrite of init or exec is one source step: the condition
  --- Step(C) => C2 runs the heating, the inner rule, and the cooling of
  --- hint(k_heatcool) rules, so only configurations are states.
  sort RunState .
  op boot : -> RunState [ctor] .
  op init : SpectecTerminal -> RunState [ctor frozen (1)] .
  op exec : SpectecTerminal -> RunState [ctor frozen (1)] .
  --- $invoke is undefined unless the arguments satisfy Val_ok.
  op invalid-invocation : -> RunState [ctor] .

  vars C C2 Z : SpectecTerminal .

  crl [instantiate] : boot => init(C)
    if instantiate(emptyStore, inputModule, nil) => C .
  crl [init-step] : init(C) => init(C2)
    if Step(C) => C2 .
  crl [invoke] : init(Z ; nil) => exec(C2)
    if C2 := invocation(Z) /\ isConfig(C2) .
  crl [invalid-invocation] : init(Z ; nil) => invalid-invocation
    if not isConfig(invocation(Z)) .
  crl [step] : exec(C) => exec(C2)
    if Step(C) => C2 .
endm
