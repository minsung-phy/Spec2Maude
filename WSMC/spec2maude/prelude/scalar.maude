fmod DSL-SCALAR is
  protecting DSL-PRETYPE .

  --- Wrapper projections used by expression operators.

  op isTrue : SpectecTerminal ~> Bool .
  op ratValue : SpectecTerminal ~> Rat .
  op floatValue : SpectecTerminal ~> Float .

  var B : Bool .
  var R : Rat .
  var F : Float .

  eq isTrue(bool(B)) = B .
  eq ratValue(rat(R)) = R .
  eq floatValue(float(F)) = F .

endfm
