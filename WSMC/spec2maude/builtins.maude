  op iclz-bits : SpectecTerminals Nat -> Nat .
  op ictz-bits : SpectecTerminals Nat -> Nat .
  op ipopcnt-bits : SpectecTerminals Nat -> Nat .
  eq iclz-bits(eps, BC_ACC) = BC_ACC .
  eq iclz-bits(1 BC_BITS, BC_ACC) = BC_ACC .
  eq iclz-bits(0 BC_BITS, BC_ACC) = iclz-bits(BC_BITS, _+_(BC_ACC, 1)) .
  eq ictz-bits(eps, BC_ACC) = BC_ACC .
  eq ictz-bits(0 BC_BITS, BC_ACC) = ictz-bits(BC_BITS, _+_(BC_ACC, 1)) .
  eq ictz-bits(1 BC_BITS, BC_ACC) = ictz-bits(BC_BITS, 0) .
  eq ipopcnt-bits(eps, BC_ACC) = BC_ACC .
  eq ipopcnt-bits(0 BC_BITS, BC_ACC) = ipopcnt-bits(BC_BITS, BC_ACC) .
  eq ipopcnt-bits(1 BC_BITS, BC_ACC) = ipopcnt-bits(BC_BITS, _+_(BC_ACC, 1)) .

  --- Implemented builtin family: integer bitwise operations.
