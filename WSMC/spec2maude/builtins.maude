  op demote-f64-nan-shift : Nat -> Nat .
  op demote-f64-nan-payload : Nat -> Nat .
  op demote-f64 : SpectecTerminal -> SpectecTerminal .
  eq pow2-rat(0) = 1 .
  ceq pow2-rat(FI_N) = _*_(2, pow2-rat(_-_(FI_N, 1)))
    if _>_(FI_N, 0) .
  ceq scale-rat(FI_R, FI_E) = _*_(FI_R, pow2-rat(abs(FI_E)))
    if _>=_(FI_E, 0) .
  ceq scale-rat(FI_R, FI_E) = FI_R / pow2-rat(abs(FI_E))
    if _<_(FI_E, 0) .
  ceq fmag-rat(FI_N, NORM(FI_FRAC, FI_E)) =
      scale-rat(_/_( _+_(_^_(2, M-2(FI_N)), FI_FRAC), pow2-rat(M-2(FI_N))), FI_E)
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq fmag-rat(FI_N, SUBNORM(FI_FRAC)) =
      scale-rat(_/_(FI_FRAC, pow2-rat(M-2(FI_N))), _+_(2, - _^_(2, _-_(E(FI_N), 1))))
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-rat(FI_N, POS(FI_MAG)) = fmag-rat(FI_N, FI_MAG)
    if (fnmag-valid(FI_N, FI_MAG)) = true .
  ceq float-rat(FI_N, NEG(FI_MAG)) = - fmag-rat(FI_N, FI_MAG)
    if (fnmag-valid(FI_N, FI_MAG)) = true .
  ceq float-finite(FI_N, POS(NORM(FI_FRAC, FI_E))) = true
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq float-finite(FI_N, NEG(NORM(FI_FRAC, FI_E))) = true
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq float-finite(FI_N, POS(SUBNORM(FI_FRAC))) = true
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-finite(FI_N, NEG(SUBNORM(FI_FRAC))) = true
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-nan-bit(FC_N, POS(NAN(FC_M))) = 1
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-nan-bit(FC_N, NEG(NAN(FC_M))) = 1
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-nan-bit(FC_N, FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  eq float-nan-bit(FC_N, POS(INF)) = 0 .
  eq float-nan-bit(FC_N, NEG(INF)) = 0 .
  eq bit-not(0) = 1 .
  eq bit-not(1) = 0 .
  eq bit-and(0, FC_BIT) = 0 .
  eq bit-and(FC_BIT, 0) = 0 .
  eq bit-and(1, 1) = 1 .
  eq bit-or(1, FC_BIT) = 1 .
  eq bit-or(FC_BIT, 1) = 1 .
  eq bit-or(0, 0) = 0 .
  eq bit-xor(0, 0) = 0 .
  eq bit-xor(0, 1) = 1 .
  eq bit-xor(1, 0) = 1 .
  eq bit-xor(1, 1) = 0 .
  ceq float-sign-bit(FC_N, POS(FC_MAG)) = 0
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq float-sign-bit(FC_N, NEG(FC_MAG)) = 1
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F2) = 1 .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = spectec-bool(bool(_==_(FC_R1, FC_R2)))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .
  eq float-eq-bit(FC_N, POS(INF), POS(INF)) = 1 .
  eq float-eq-bit(FC_N, NEG(INF), NEG(INF)) = 1 .
  eq float-eq-bit(FC_N, POS(INF), NEG(INF)) = 0 .
  eq float-eq-bit(FC_N, NEG(INF), POS(INF)) = 0 .
  ceq float-eq-bit(FC_N, FC_F1, POS(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, FC_F1, NEG(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, POS(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, NEG(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F2) = 1 .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = spectec-bool(bool(_<_(FC_R1, FC_R2)))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .
  eq float-lt-bit(FC_N, NEG(INF), POS(INF)) = 1 .
  eq float-lt-bit(FC_N, POS(INF), NEG(INF)) = 0 .
  eq float-lt-bit(FC_N, POS(INF), POS(INF)) = 0 .
  eq float-lt-bit(FC_N, NEG(INF), NEG(INF)) = 0 .
  ceq float-lt-bit(FC_N, NEG(INF), FC_F1) = 1
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, POS(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, POS(INF)) = 1
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, NEG(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  eq float-default-nan(FC_N) = POS(NAN(_^_(2, _-_(M-2(FC_N), 1)))) .
  ceq float-canonical-nan(FC_N, POS(NAN(FC_M))) = POS(NAN(FC_M))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true
       /\ _>=_(FC_M, _^_(2, _-_(M-2(FC_N), 1))) .
  ceq float-canonical-nan(FC_N, POS(NAN(FC_M))) = POS(NAN(_+_(FC_M, _^_(2, _-_(M-2(FC_N), 1)))))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true
       /\ _<_(FC_M, _^_(2, _-_(M-2(FC_N), 1))) .
  ceq float-canonical-nan(FC_N, NEG(NAN(FC_M))) = NEG(NAN(FC_M))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true
       /\ _>=_(FC_M, _^_(2, _-_(M-2(FC_N), 1))) .
  ceq float-canonical-nan(FC_N, NEG(NAN(FC_M))) = NEG(NAN(_+_(FC_M, _^_(2, _-_(M-2(FC_N), 1)))))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true
       /\ _<_(FC_M, _^_(2, _-_(M-2(FC_N), 1))) .
  ceq float-binary-nan(FC_N, POS(NAN(FC_M)), FC_F2) =
      float-canonical-nan(FC_N, POS(NAN(FC_M)))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, NEG(NAN(FC_M)), FC_F2) =
      float-canonical-nan(FC_N, NEG(NAN(FC_M)))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, FC_F1, POS(NAN(FC_M))) =
      float-canonical-nan(FC_N, POS(NAN(FC_M)))
