  eq ior-bits(0 BT_BITS1, 1 BT_BITS2) = 1 ior-bits(BT_BITS1, BT_BITS2) .
  eq ior-bits(1 BT_BITS1, 0 BT_BITS2) = 1 ior-bits(BT_BITS1, BT_BITS2) .
  eq ior-bits(1 BT_BITS1, 1 BT_BITS2) = 1 ior-bits(BT_BITS1, BT_BITS2) .
  eq ixor-bits(eps, eps) = eps .
  eq ixor-bits(0 BT_BITS1, 0 BT_BITS2) = 0 ixor-bits(BT_BITS1, BT_BITS2) .
  eq ixor-bits(0 BT_BITS1, 1 BT_BITS2) = 1 ixor-bits(BT_BITS1, BT_BITS2) .
  eq ixor-bits(1 BT_BITS1, 0 BT_BITS2) = 1 ixor-bits(BT_BITS1, BT_BITS2) .
  eq ixor-bits(1 BT_BITS1, 1 BT_BITS2) = 0 ixor-bits(BT_BITS1, BT_BITS2) .

