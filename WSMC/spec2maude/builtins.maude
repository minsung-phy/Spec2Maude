  op iandnot-bits : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  op ior-bits : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  op ixor-bits : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  eq inot-bits(eps) = eps .
  eq inot-bits(0 BT_BITS) = 1 inot-bits(BT_BITS) .
  eq inot-bits(1 BT_BITS) = 0 inot-bits(BT_BITS) .
  eq irev-bits(eps, BT_BITS2) = BT_BITS2 .
  eq irev-bits(0 BT_BITS1, BT_BITS2) = irev-bits(BT_BITS1, 0 BT_BITS2) .
  eq irev-bits(1 BT_BITS1, BT_BITS2) = irev-bits(BT_BITS1, 1 BT_BITS2) .
  eq iand-bits(eps, eps) = eps .
  eq iand-bits(0 BT_BITS1, 0 BT_BITS2) = 0 iand-bits(BT_BITS1, BT_BITS2) .
  eq iand-bits(0 BT_BITS1, 1 BT_BITS2) = 0 iand-bits(BT_BITS1, BT_BITS2) .
  eq iand-bits(1 BT_BITS1, 0 BT_BITS2) = 0 iand-bits(BT_BITS1, BT_BITS2) .
  eq iand-bits(1 BT_BITS1, 1 BT_BITS2) = 1 iand-bits(BT_BITS1, BT_BITS2) .
  eq iandnot-bits(eps, eps) = eps .
  eq iandnot-bits(0 BT_BITS1, 0 BT_BITS2) = 0 iandnot-bits(BT_BITS1, BT_BITS2) .
  eq iandnot-bits(0 BT_BITS1, 1 BT_BITS2) = 0 iandnot-bits(BT_BITS1, BT_BITS2) .
  eq iandnot-bits(1 BT_BITS1, 0 BT_BITS2) = 1 iandnot-bits(BT_BITS1, BT_BITS2) .
  eq iandnot-bits(1 BT_BITS1, 1 BT_BITS2) = 0 iandnot-bits(BT_BITS1, BT_BITS2) .
