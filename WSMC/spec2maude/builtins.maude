  ceq demote-f64(NEG(FI_MAG)) =
      NEG(round-rat-to-fmag(32, fmag-rat(64, FI_MAG)))
    if (float-finite(64, NEG(FI_MAG))) = true .
  eq demote-f64(POS(INF)) = POS(INF) .
  eq demote-f64(NEG(INF)) = NEG(INF) .
  ceq demote-f64(POS(NAN(FP_M))) =
      POS(NAN(demote-f64-nan-payload(FP_M)))
    if (fnmag-valid(64, NAN(FP_M))) = true .
  ceq demote-f64(NEG(NAN(FP_M))) =
      NEG(NAN(demote-f64-nan-payload(FP_M)))
    if (fnmag-valid(64, NAN(FP_M))) = true .
  eq nat-fmag-exact(FR_N, 0) = true .
  ceq nat-fmag-exact(FR_N, FR_I) = true
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _<=_(FR_E, M-2(FR_N)) .
  ceq nat-fmag-exact(FR_N, FR_I) = true
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ _rem_(FR_I, _^_(2, _-_(FR_E, M-2(FR_N)))) = 0 .
  eq nat-to-fmag(FR_N, 0) = SUBNORM(0) .
  ceq nat-to-fmag(FR_N, FR_I) = NORM(FR_FRAC, FR_E)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _<=_(FR_E, M-2(FR_N))
       /\ FR_FRAC := _*_( _-_(FR_I, _^_(2, FR_E)), _^_(2, _-_(M-2(FR_N), FR_E)))
       /\ (fnmag-valid(FR_N, NORM(FR_FRAC, FR_E))) = true .
  ceq nat-to-fmag(FR_N, FR_I) = NORM(FR_FRAC, FR_E)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ _rem_(FR_I, _^_(2, _-_(FR_E, M-2(FR_N)))) = 0
       /\ FR_FRAC := _-_(_quo_(FR_I, _^_(2, _-_(FR_E, M-2(FR_N)))), _^_(2, M-2(FR_N)))
       /\ (fnmag-valid(FR_N, NORM(FR_FRAC, FR_E))) = true .
  ceq round-nat-significand(FR_N, FR_I) = FR_Q
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SHIFT := _-_(FR_E, M-2(FR_N))
       /\ FR_SCALE := _^_(2, FR_SHIFT)
       /\ FR_Q := _quo_(FR_I, FR_SCALE)
       /\ FR_REM := _rem_(FR_I, FR_SCALE)
       /\ FR_HALF := _^_(2, _-_(FR_SHIFT, 1))
       /\ _<_(FR_REM, FR_HALF) .
  ceq round-nat-significand(FR_N, FR_I) = _+_(FR_Q, 1)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SHIFT := _-_(FR_E, M-2(FR_N))
       /\ FR_SCALE := _^_(2, FR_SHIFT)
       /\ FR_Q := _quo_(FR_I, FR_SCALE)
       /\ FR_REM := _rem_(FR_I, FR_SCALE)
       /\ FR_HALF := _^_(2, _-_(FR_SHIFT, 1))
       /\ _>_(FR_REM, FR_HALF) .
  ceq round-nat-significand(FR_N, FR_I) = FR_Q
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SHIFT := _-_(FR_E, M-2(FR_N))
       /\ FR_SCALE := _^_(2, FR_SHIFT)
       /\ FR_Q := _quo_(FR_I, FR_SCALE)
       /\ FR_REM := _rem_(FR_I, FR_SCALE)
       /\ FR_HALF := _^_(2, _-_(FR_SHIFT, 1))
       /\ _==_(FR_REM, FR_HALF)
       /\ _rem_(FR_Q, 2) = 0 .
  ceq round-nat-significand(FR_N, FR_I) = _+_(FR_Q, 1)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SHIFT := _-_(FR_E, M-2(FR_N))
       /\ FR_SCALE := _^_(2, FR_SHIFT)
       /\ FR_Q := _quo_(FR_I, FR_SCALE)
       /\ FR_REM := _rem_(FR_I, FR_SCALE)
       /\ FR_HALF := _^_(2, _-_(FR_SHIFT, 1))
       /\ _==_(FR_REM, FR_HALF)
       /\ _>_(_rem_(FR_Q, 2), 0) .
  eq rounded-nat-to-fmag(FR_N, 0) = SUBNORM(0) .
  ceq rounded-nat-to-fmag(FR_N, FR_I) = nat-to-fmag(FR_N, FR_I)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _<=_(FR_E, M-2(FR_N)) .
  ceq rounded-nat-to-fmag(FR_N, FR_I) = NORM(_-_(FR_SIG, _^_(2, M-2(FR_N))), FR_E)
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SIG := round-nat-significand(FR_N, FR_I)
       /\ _<_(FR_SIG, _^_(2, _+_(M-2(FR_N), 1)))
       /\ (fnmag-valid(FR_N, NORM(_-_(FR_SIG, _^_(2, M-2(FR_N))), FR_E))) = true .
  ceq rounded-nat-to-fmag(FR_N, FR_I) = NORM(0, _+_(FR_E, 1))
    if _>_(FR_I, 0)
       /\ FR_E := floor-log2(FR_I)
       /\ _>_(FR_E, M-2(FR_N))
       /\ FR_SIG := round-nat-significand(FR_N, FR_I)
       /\ FR_SIG = _^_(2, _+_(M-2(FR_N), 1))
       /\ (fnmag-valid(FR_N, NORM(0, _+_(FR_E, 1)))) = true .
  ceq int-to-float-like(FR_N, FR_X, FR_SOURCE) = POS(nat-to-fmag(FR_N, abs(FR_X)))
    if _>_(FR_X, 0)
       /\ nat-fmag-exact(FR_N, abs(FR_X)) = true .
  ceq int-to-float-like(FR_N, FR_X, FR_SOURCE) = NEG(nat-to-fmag(FR_N, abs(FR_X)))
    if _<_(FR_X, 0)
       /\ nat-fmag-exact(FR_N, abs(FR_X)) = true .
  ceq int-to-float-like(FR_N, 0, POS(FR_MAG)) = POS(SUBNORM(0))
    if (fnmag-valid(FR_N, FR_MAG)) = true .
  ceq int-to-float-like(FR_N, 0, NEG(FR_MAG)) = NEG(SUBNORM(0))
    if (fnmag-valid(FR_N, FR_MAG)) = true .
  ceq int-to-iN(FI_N, FI_X) = FI_X
    if _>=_(FI_X, 0) .
  ceq int-to-iN(FI_N, FI_X) = sd(_^_(2, FI_N), abs(FI_X))
    if _<_(FI_X, 0) .
  ceq saturate-u-int(FI_N, FI_X) = 0
    if _<_(FI_X, 0) .
  ceq saturate-u-int(FI_N, FI_X) = int-to-iN(FI_N, FI_X)
    if _>=_(FI_X, 0)
       /\ _<_(FI_X, _^_(2, FI_N)) .
  ceq saturate-u-int(FI_N, FI_X) = _-_(_^_(2, FI_N), 1)
    if _>=_(FI_X, _^_(2, FI_N)) .
  ceq saturate-s-int(FI_N, FI_X) = int-to-iN(FI_N, - _^_(2, _-_(FI_N, 1)))
    if _>_(FI_N, 0)
       /\ _<_(FI_X, - _^_(2, _-_(FI_N, 1))) .
  ceq saturate-s-int(FI_N, FI_X) = int-to-iN(FI_N, FI_X)
    if _>_(FI_N, 0)
       /\ _>=_(FI_X, - _^_(2, _-_(FI_N, 1)))
       /\ _<=_(FI_X, _-_( _^_(2, _-_(FI_N, 1)), 1)) .
  ceq saturate-s-int(FI_N, FI_X) = _-_(_^_(2, _-_(FI_N, 1)), 1)
    if _>_(FI_N, 0)
       /\ _>_(FI_X, _-_( _^_(2, _-_(FI_N, 1)), 1)) .

  --- Implemented builtin family: IEEE-754 bit/byte representation for fN.
  vars FB_N FB_I FB_M FB_RAW FB_FRAC FB_EXP FB_SIGN FB_MAGBITS FB_RESULT : Nat .
  var FB_EINT : Int .
  vars FB_F FB_MAG : SpectecTerminal .
  vars FB_BITS FB_BYTES : SpectecTerminals .
  op float-bias : Nat -> Nat .
  op float-max-exp-field : Nat -> Nat .
  op float-exp-field : Nat Nat -> Nat .
  op float-frac-field : Nat Nat -> Nat .
  op float-sign-field : Nat Nat -> Nat .
  op float-mag-from-bits : Nat Nat -> SpectecTerminal .
  op float-from-bits : Nat Nat -> SpectecTerminal .
  op float-mag-to-bits : Nat SpectecTerminal -> Nat .
  op float-to-bits : Nat SpectecTerminal -> Nat .
  eq float-bias(FB_N) = _-_(_^_(2, _-_(E(FB_N), 1)), 1) .
  eq float-max-exp-field(FB_N) = _-_(_^_(2, E(FB_N)), 1) .
  ceq float-sign-field(FB_N, FB_I) = _quo_(_rem_(FB_I, _^_(2, FB_N)), _^_(2, _-_(FB_N, 1)))
    if _>_(FB_N, 0) .
  eq float-exp-field(FB_N, FB_I) =
      _rem_(_quo_(_rem_(FB_I, _^_(2, FB_N)), _^_(2, M-2(FB_N))), _^_(2, E(FB_N))) .
  eq float-frac-field(FB_N, FB_I) =
      _rem_(_rem_(FB_I, _^_(2, FB_N)), _^_(2, M-2(FB_N))) .
  ceq float-mag-from-bits(FB_N, FB_I) = SUBNORM(FB_FRAC)
    if _<_(FB_I, _^_(2, FB_N))
       /\ FB_EXP := float-exp-field(FB_N, FB_I)
       /\ FB_FRAC := float-frac-field(FB_N, FB_I)
       /\ FB_EXP = 0 .
  ceq float-mag-from-bits(FB_N, FB_I) = INF
    if _<_(FB_I, _^_(2, FB_N))
       /\ FB_EXP := float-exp-field(FB_N, FB_I)
       /\ FB_FRAC := float-frac-field(FB_N, FB_I)
       /\ FB_EXP = float-max-exp-field(FB_N)
       /\ FB_FRAC = 0 .
  ceq float-mag-from-bits(FB_N, FB_I) = NAN(FB_FRAC)
    if _<_(FB_I, _^_(2, FB_N))
       /\ FB_EXP := float-exp-field(FB_N, FB_I)
       /\ FB_FRAC := float-frac-field(FB_N, FB_I)
       /\ FB_EXP = float-max-exp-field(FB_N)
       /\ _>_(FB_FRAC, 0) .
  ceq float-mag-from-bits(FB_N, FB_I) = NORM(FB_FRAC, _-_(FB_EXP, float-bias(FB_N)))
    if _<_(FB_I, _^_(2, FB_N))
       /\ FB_EXP := float-exp-field(FB_N, FB_I)
       /\ FB_FRAC := float-frac-field(FB_N, FB_I)
       /\ _>_(FB_EXP, 0)
       /\ _<_(FB_EXP, float-max-exp-field(FB_N)) .
  ceq float-from-bits(FB_N, FB_I) = POS(float-mag-from-bits(FB_N, FB_I))
    if _<_(FB_I, _^_(2, FB_N))
       /\ float-sign-field(FB_N, FB_I) = 0 .
  ceq float-from-bits(FB_N, FB_I) = NEG(float-mag-from-bits(FB_N, FB_I))
    if _<_(FB_I, _^_(2, FB_N))
       /\ float-sign-field(FB_N, FB_I) = 1 .
  ceq float-mag-to-bits(FB_N, SUBNORM(FB_M)) = FB_M
    if _<_(FB_M, _^_(2, M-2(FB_N))) .
  eq float-mag-to-bits(FB_N, INF) =
      _*_(float-max-exp-field(FB_N), _^_(2, M-2(FB_N))) .
  ceq float-mag-to-bits(FB_N, NAN(FB_M)) =
      _+_(_*_(float-max-exp-field(FB_N), _^_(2, M-2(FB_N))), FB_M)
    if _and_(_<=_(1, FB_M), _<_(FB_M, _^_(2, M-2(FB_N)))) = true .
  ceq float-mag-to-bits(FB_N, NORM(FB_M, FB_EINT)) =
      _+_(_*_(_+_(FB_EINT, float-bias(FB_N)), _^_(2, M-2(FB_N))), FB_M)
    if (fnmag-valid(FB_N, NORM(FB_M, FB_EINT))) = true .
  ceq float-to-bits(FB_N, POS(FB_MAG)) = FB_MAGBITS
    if (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_MAGBITS := float-mag-to-bits(FB_N, FB_MAG) .
  ceq float-to-bits(FB_N, NEG(FB_MAG)) = _+_(_^_(2, _-_(FB_N, 1)), FB_MAGBITS)
    if (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_MAGBITS := float-mag-to-bits(FB_N, FB_MAG) .

  --- Implemented builtin family: composite numtype bytes.
  vars NB_N NB_I NB_RAW : Nat .
  var NB_PAYLOAD : SpectecTerminal .
  var NB_BYTES : SpectecTerminals .
  op nbytes-int : Nat SpectecTerminal -> SpectecTerminals .
  op nbytes-float : Nat SpectecTerminal -> SpectecTerminals .
  op inv-nbytes-int : Nat SpectecTerminals -> SpectecTerminal .
  op inv-nbytes-float : Nat SpectecTerminals -> SpectecTerminal .
  ceq nbytes-int(NB_N, (NB_I)) = ibytes-(NB_N, (NB_I))
    if _<_(NB_I, _^_(2, NB_N)) .
  eq nbytes-float(NB_N, POS(FB_MAG)) = fbytes-(NB_N, POS(FB_MAG)) .
  eq nbytes-float(NB_N, NEG(FB_MAG)) = fbytes-(NB_N, NEG(FB_MAG)) .
  ceq inv-nbytes-int(NB_N, NB_BYTES) = (NB_RAW)
    if _rem_(NB_N, 8) = 0
       /\ len(NB_BYTES) = _quo_(NB_N, 8)
       /\ typecheck(NB_BYTES, byte)
       /\ NB_RAW := inv-ibytes-aux(NB_BYTES, 1, 0) .
  ceq inv-nbytes-float(NB_N, NB_BYTES) = float-from-bits(NB_N, NB_RAW)
    if _rem_(NB_N, 8) = 0
       /\ len(NB_BYTES) = _quo_(NB_N, 8)
       /\ typecheck(NB_BYTES, byte)
       /\ NB_RAW := inv-ibytes-aux(NB_BYTES, 1, 0) .

  --- Implemented builtin family: composite storage/const bytes.
  vars ZB_N ZB_RAW : Nat .
  var ZB_PAYLOAD : SpectecTerminal .
  var ZB_BYTES : SpectecTerminals .
  op zbytes-pack : Nat SpectecTerminal -> SpectecTerminals .
  op inv-zbytes-pack : Nat SpectecTerminals -> SpectecTerminal .
  ceq zbytes-pack(ZB_N, (ZB_RAW)) = ibytes-(ZB_N, (ZB_RAW))
    if _<_(ZB_RAW, _^_(2, ZB_N)) .
  ceq inv-zbytes-pack(ZB_N, ZB_BYTES) = (ZB_RAW)
    if _rem_(ZB_N, 8) = 0
       /\ len(ZB_BYTES) = _quo_(ZB_N, 8)
       /\ typecheck(ZB_BYTES, byte)
       /\ ZB_RAW := inv-ibytes-aux(ZB_BYTES, 1, 0) .

  --- Implemented builtin family: vector lane splitting/reassembly.
  vars LN_W LN_COUNT LN_RAW LN_SCALE LN_ACC : Nat .
  var LN_LT : SpectecTerminal .
  var LN_PAYLOAD : SpectecTerminal .
  var LN_HEAD : SpectecTerminal .
  var LN_MAG : SpectecTerminal .
  vars LN_LANES LN_TAIL : SpectecTerminals .
  op lane-width : SpectecTerminal -> Nat .
  op vec-raw : SpectecTerminal -> Nat .
  op lane-from-bits : SpectecTerminal Nat -> SpectecTerminal .
  op lane-to-bits : SpectecTerminal SpectecTerminal -> Nat .
  op lanes-aux : SpectecTerminal Nat Nat Nat -> SpectecTerminals .
  op inv-lanes-aux : SpectecTerminal Nat SpectecTerminals Nat Nat -> Nat .
  eq lane-width(I32) = 32 .
  eq lane-width(I64) = 64 .
  eq lane-width(F32) = 32 .
  eq lane-width(F64) = 64 .
  eq lane-width(I8) = 8 .
  eq lane-width(I16) = 16 .
  eq vec-raw(LN_RAW) = LN_RAW .
  ceq lane-from-bits(I32, LN_RAW) = (LN_RAW)
    if _<_(LN_RAW, _^_(2, 32)) .
  ceq lane-from-bits(I64, LN_RAW) = (LN_RAW)
    if _<_(LN_RAW, _^_(2, 64)) .
  ceq lane-from-bits(I8, LN_RAW) = (LN_RAW)
    if _<_(LN_RAW, _^_(2, 8)) .
  ceq lane-from-bits(I16, LN_RAW) = (LN_RAW)
    if _<_(LN_RAW, _^_(2, 16)) .
  ceq lane-from-bits(F32, LN_RAW) = float-from-bits(32, LN_RAW)
    if _<_(LN_RAW, _^_(2, 32)) .
  ceq lane-from-bits(F64, LN_RAW) = float-from-bits(64, LN_RAW)
    if _<_(LN_RAW, _^_(2, 64)) .
  ceq lane-to-bits(I32, (LN_RAW)) = LN_RAW
    if _<_(LN_RAW, _^_(2, 32)) .
  ceq lane-to-bits(I64, (LN_RAW)) = LN_RAW
    if _<_(LN_RAW, _^_(2, 64)) .
  ceq lane-to-bits(I8, (LN_RAW)) = LN_RAW
    if _<_(LN_RAW, _^_(2, 8)) .
  ceq lane-to-bits(I16, (LN_RAW)) = LN_RAW
    if _<_(LN_RAW, _^_(2, 16)) .
  ceq lane-to-bits(F32, POS(LN_MAG)) = float-to-bits(32, POS(LN_MAG))
    if (fnmag-valid(32, LN_MAG)) = true .
  ceq lane-to-bits(F32, NEG(LN_MAG)) = float-to-bits(32, NEG(LN_MAG))
    if (fnmag-valid(32, LN_MAG)) = true .
  ceq lane-to-bits(F64, POS(LN_MAG)) = float-to-bits(64, POS(LN_MAG))
    if (fnmag-valid(64, LN_MAG)) = true .
  ceq lane-to-bits(F64, NEG(LN_MAG)) = float-to-bits(64, NEG(LN_MAG))
    if (fnmag-valid(64, LN_MAG)) = true .
  eq lanes-aux(LN_LT, LN_W, 0, LN_RAW) = eps .
  ceq lanes-aux(LN_LT, LN_W, LN_COUNT, LN_RAW) =
      lane-from-bits(LN_LT, _rem_(LN_RAW, _^_(2, LN_W)))
      lanes-aux(LN_LT, LN_W, _-_(LN_COUNT, 1), _quo_(LN_RAW, _^_(2, LN_W)))
    if _>_(LN_COUNT, 0) .
  eq inv-lanes-aux(LN_LT, LN_W, eps, LN_SCALE, LN_ACC) = LN_ACC .
  ceq inv-lanes-aux(LN_LT, LN_W, LN_HEAD LN_TAIL, LN_SCALE, LN_ACC) =
      inv-lanes-aux(LN_LT, LN_W, LN_TAIL, _*_(LN_SCALE, _^_(2, LN_W)), _+_(LN_ACC, _*_(LN_RAW, LN_SCALE)))
    if LN_RAW := lane-to-bits(LN_LT, LN_HEAD)
       /\ _<_(LN_RAW, _^_(2, LN_W)) .

  ceq ibits-(BI_N, (BI_I)) =
      ibits-aux(BI_N, BI_I)
    if _<_(BI_I, _^_(2, BI_N)) .

  ceq inv-ibits-(BI_N, BI_BITS) = (BI_RESULT)
    if len(BI_BITS) = BI_N
       /\ typecheck(BI_BITS, bit)
       /\ BI_RESULT := inv-ibits-aux(BI_BITS, 0) .

  ceq fbits-(FB_N, POS(FB_MAG)) =
      ibits-aux(FB_N, FB_RAW)
    if (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_RAW := float-to-bits(FB_N, POS(FB_MAG)) .
  ceq fbits-(FB_N, NEG(FB_MAG)) =
      ibits-aux(FB_N, FB_RAW)
    if (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_RAW := float-to-bits(FB_N, NEG(FB_MAG)) .

  ceq inv-fbits-(FB_N, FB_BITS) = float-from-bits(FB_N, FB_RAW)
    if len(FB_BITS) = FB_N
       /\ typecheck(FB_BITS, bit)
       /\ FB_RAW := inv-ibits-aux(FB_BITS, 0) .

  ceq ibytes-(BY_N, (BY_I)) = ibytes-aux(_quo_(BY_N, 8), BY_I)
    if _rem_(BY_N, 8) = 0
       /\ _<_(BY_I, _^_(2, BY_N)) .

  ceq inv-ibytes-(BY_N, BY_BYTES) = (BY_RESULT)
    if _rem_(BY_N, 8) = 0
       /\ len(BY_BYTES) = _quo_(BY_N, 8)
       /\ typecheck(BY_BYTES, byte)
       /\ BY_RESULT := inv-ibytes-aux(BY_BYTES, 1, 0) .

  ceq fbytes-(FB_N, POS(FB_MAG)) = ibytes-aux(_quo_(FB_N, 8), FB_RAW)
    if _rem_(FB_N, 8) = 0
       /\ (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_RAW := float-to-bits(FB_N, POS(FB_MAG)) .
  ceq fbytes-(FB_N, NEG(FB_MAG)) = ibytes-aux(_quo_(FB_N, 8), FB_RAW)
    if _rem_(FB_N, 8) = 0
       /\ (fnmag-valid(FB_N, FB_MAG)) = true
       /\ FB_RAW := float-to-bits(FB_N, NEG(FB_MAG)) .

  ceq inv-fbytes-(FB_N, FB_BYTES) = float-from-bits(FB_N, FB_RAW)
    if _rem_(FB_N, 8) = 0
       /\ len(FB_BYTES) = _quo_(FB_N, 8)
       /\ typecheck(FB_BYTES, byte)
       /\ FB_RAW := inv-ibytes-aux(FB_BYTES, 1, 0) .

  eq nbytes-(I32, NB_PAYLOAD) = nbytes-int(32, NB_PAYLOAD) .
  eq nbytes-(I64, NB_PAYLOAD) = nbytes-int(64, NB_PAYLOAD) .
  eq nbytes-(F32, NB_PAYLOAD) = nbytes-float(32, NB_PAYLOAD) .
  eq nbytes-(F64, NB_PAYLOAD) = nbytes-float(64, NB_PAYLOAD) .

  eq inv-nbytes-(I32, NB_BYTES) = inv-nbytes-int(32, NB_BYTES) .
  eq inv-nbytes-(I64, NB_BYTES) = inv-nbytes-int(64, NB_BYTES) .
  eq inv-nbytes-(F32, NB_BYTES) = inv-nbytes-float(32, NB_BYTES) .
  eq inv-nbytes-(F64, NB_BYTES) = inv-nbytes-float(64, NB_BYTES) .

  eq reinterpret--(I32, F32, NB_PAYLOAD) =
      inv-nbytes-(F32, nbytes-(I32, NB_PAYLOAD)) .
  eq reinterpret--(F32, I32, NB_PAYLOAD) =
      inv-nbytes-(I32, nbytes-(F32, NB_PAYLOAD)) .
  eq reinterpret--(I64, F64, NB_PAYLOAD) =
      inv-nbytes-(F64, nbytes-(I64, NB_PAYLOAD)) .
  eq reinterpret--(F64, I64, NB_PAYLOAD) =
      inv-nbytes-(I64, nbytes-(F64, NB_PAYLOAD)) .

  ceq vbytes-(V128, (BY_I)) =
      ibytes-aux(_quo_(vsize(V128), 8), BY_I)
    if _<_(BY_I, _^_(2, vsize(V128))) .

  ceq inv-vbytes-(V128, BY_BYTES) = (BY_RESULT)
    if len(BY_BYTES) = _quo_(vsize(V128), 8)
       /\ typecheck(BY_BYTES, byte)
       /\ BY_RESULT := inv-ibytes-aux(BY_BYTES, 1, 0) .

  eq zbytes-(I32, ZB_PAYLOAD) = nbytes-(I32, ZB_PAYLOAD) .
  eq zbytes-(I64, ZB_PAYLOAD) = nbytes-(I64, ZB_PAYLOAD) .
  eq zbytes-(F32, ZB_PAYLOAD) = nbytes-(F32, ZB_PAYLOAD) .
  eq zbytes-(F64, ZB_PAYLOAD) = nbytes-(F64, ZB_PAYLOAD) .
  eq zbytes-(V128, ZB_PAYLOAD) = vbytes-(V128, ZB_PAYLOAD) .
  eq zbytes-(I8, ZB_PAYLOAD) = zbytes-pack(8, ZB_PAYLOAD) .
  eq zbytes-(I16, ZB_PAYLOAD) = zbytes-pack(16, ZB_PAYLOAD) .

  eq cbytes-(I32, ZB_PAYLOAD) = nbytes-(I32, ZB_PAYLOAD) .
  eq cbytes-(I64, ZB_PAYLOAD) = nbytes-(I64, ZB_PAYLOAD) .
  eq cbytes-(F32, ZB_PAYLOAD) = nbytes-(F32, ZB_PAYLOAD) .
  eq cbytes-(F64, ZB_PAYLOAD) = nbytes-(F64, ZB_PAYLOAD) .
  eq cbytes-(V128, ZB_PAYLOAD) = vbytes-(V128, ZB_PAYLOAD) .

  eq inv-zbytes-(I32, ZB_BYTES) = inv-nbytes-(I32, ZB_BYTES) .
  eq inv-zbytes-(I64, ZB_BYTES) = inv-nbytes-(I64, ZB_BYTES) .
  eq inv-zbytes-(F32, ZB_BYTES) = inv-nbytes-(F32, ZB_BYTES) .
  eq inv-zbytes-(F64, ZB_BYTES) = inv-nbytes-(F64, ZB_BYTES) .
  eq inv-zbytes-(V128, ZB_BYTES) = inv-vbytes-(V128, ZB_BYTES) .
  eq inv-zbytes-(I8, ZB_BYTES) = inv-zbytes-pack(8, ZB_BYTES) .
  eq inv-zbytes-(I16, ZB_BYTES) = inv-zbytes-pack(16, ZB_BYTES) .

  eq inv-cbytes-(I32, ZB_BYTES) = inv-nbytes-(I32, ZB_BYTES) .
  eq inv-cbytes-(I64, ZB_BYTES) = inv-nbytes-(I64, ZB_BYTES) .
  eq inv-cbytes-(F32, ZB_BYTES) = inv-nbytes-(F32, ZB_BYTES) .
  eq inv-cbytes-(F64, ZB_BYTES) = inv-nbytes-(F64, ZB_BYTES) .
  eq inv-cbytes-(V128, ZB_BYTES) = inv-vbytes-(V128, ZB_BYTES) .

  ceq lanes-(LN_LT X LN_COUNT, LN_PAYLOAD) =
      lanes-aux(LN_LT, LN_W, LN_COUNT, LN_RAW)
    if LN_W := lane-width(LN_LT)
       /\ _*_(LN_W, LN_COUNT) = 128
       /\ LN_RAW := vec-raw(LN_PAYLOAD)
       /\ _<_(LN_RAW, _^_(2, 128)) .

  ceq inv-lanes-(LN_LT X LN_COUNT, LN_LANES) =
      (inv-lanes-aux(LN_LT, LN_W, LN_LANES, 1, 0))
    if LN_W := lane-width(LN_LT)
       /\ _*_(LN_W, LN_COUNT) = 128
       /\ len(LN_LANES) = LN_COUNT .

  ceq wrap--(BW_M, BW_N, (BW_I)) = (_rem_(BW_I, _^_(2, BW_N)))
    if _>_(BW_N, 0)
       /\ _<_(BW_N, BW_M)
       /\ _<_(BW_I, _^_(2, BW_M)) .

  ceq extend--(BE_M, BE_N, U, (BE_I)) = (BE_I)
    if _<_(BE_M, BE_N)
       /\ _<_(BE_I, _^_(2, BE_M)) .
  ceq extend--(BE_M, BE_N, S, (BE_I)) = (sign-extend-nat(BE_M, BE_N, BE_I))
    if _>_(BE_M, 0)
       /\ _<_(BE_M, BE_N)
       /\ _<_(BE_I, _^_(2, BE_M)) .

  ceq iclz-(BC_N, (BC_I)) = (iclz-bits(ibits-aux(BC_N, BC_I), 0))
    if _>_(BC_N, 0)
       /\ _<_(BC_I, _^_(2, BC_N)) .

  ceq ictz-(BC_N, (BC_I)) = (ictz-bits(ibits-aux(BC_N, BC_I), 0))
    if _>_(BC_N, 0)
       /\ _<_(BC_I, _^_(2, BC_N)) .

  ceq ipopcnt-(BC_N, (BC_I)) = (ipopcnt-bits(ibits-aux(BC_N, BC_I), 0))
    if _>_(BC_N, 0)
       /\ _<_(BC_I, _^_(2, BC_N)) .

  ceq inot-(BT_N, (BT_I)) = (inv-ibits-aux(inot-bits(ibits-aux(BT_N, BT_I)), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N)) .

  ceq irev-(BT_N, (BT_I)) = (inv-ibits-aux(irev-bits(ibits-aux(BT_N, BT_I), eps), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N)) .

  ceq iand-(BT_N, (BT_I), (BT_J)) = (inv-ibits-aux(iand-bits(ibits-aux(BT_N, BT_I), ibits-aux(BT_N, BT_J)), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N))
       /\ _<_(BT_J, _^_(2, BT_N)) .

  ceq iandnot-(BT_N, (BT_I), (BT_J)) = (inv-ibits-aux(iandnot-bits(ibits-aux(BT_N, BT_I), ibits-aux(BT_N, BT_J)), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N))
       /\ _<_(BT_J, _^_(2, BT_N)) .

  ceq ior-(BT_N, (BT_I), (BT_J)) = (inv-ibits-aux(ior-bits(ibits-aux(BT_N, BT_I), ibits-aux(BT_N, BT_J)), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N))
       /\ _<_(BT_J, _^_(2, BT_N)) .

  ceq ixor-(BT_N, (BT_I), (BT_J)) = (inv-ibits-aux(ixor-bits(ibits-aux(BT_N, BT_I), ibits-aux(BT_N, BT_J)), 0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N))
       /\ _<_(BT_J, _^_(2, BT_N)) .

  ceq ibitselect-(BT_N, (BT_I), (BT_J), (BT_K)) =
      (inv-ibits-aux(
        ior-bits(
          iand-bits(ibits-aux(BT_N, BT_I), ibits-aux(BT_N, BT_K)),
          iand-bits(ibits-aux(BT_N, BT_J), inot-bits(ibits-aux(BT_N, BT_K)))),
        0))
    if _>_(BT_N, 0)
       /\ _<_(BT_I, _^_(2, BT_N))
       /\ _<_(BT_J, _^_(2, BT_N))
       /\ _<_(BT_K, _^_(2, BT_N)) .

  ceq ishl-(SH_N, (SH_I), (SH_J)) =
      (_rem_(_*_(SH_I, _^_(2, SH_K)), _^_(2, SH_N)))
    if _<_(SH_I, _^_(2, SH_N))
       /\ SH_K := shift-count(SH_N, SH_J) .

  ceq ishr-(SH_N, U, (SH_I), (SH_J)) =
      (_quo_(SH_I, _^_(2, SH_K)))
    if _<_(SH_I, _^_(2, SH_N))
       /\ SH_K := shift-count(SH_N, SH_J) .
  ceq ishr-(SH_N, S, (SH_I), (SH_J)) = (SH_I)
    if _<_(SH_I, _^_(2, SH_N))
       /\ shift-count(SH_N, SH_J) = 0 .
  ceq ishr-(SH_N, S, (SH_I), (SH_J)) =
      (sign-extend-nat(sd(SH_N, SH_K), SH_N, _quo_(SH_I, _^_(2, SH_K))))
    if _<_(SH_I, _^_(2, SH_N))
       /\ SH_K := shift-count(SH_N, SH_J)
       /\ _>_(SH_K, 0) .

  ceq irotl-(SH_N, (SH_I), (SH_J)) =
      (_rem_(_+_(_rem_(_*_(SH_I, _^_(2, SH_K)), _^_(2, SH_N)), _quo_(SH_I, _^_(2, sd(SH_N, SH_K)))), _^_(2, SH_N)))
    if _<_(SH_I, _^_(2, SH_N))
       /\ _<_(SH_J, _^_(2, SH_N))
       /\ SH_K := shift-count(SH_N, SH_J) .

  ceq irotr-(SH_N, (SH_I), (SH_J)) =
      (_rem_(_+_(_quo_(SH_I, _^_(2, SH_K)), _*_( _rem_(SH_I, _^_(2, SH_K)), _^_(2, sd(SH_N, SH_K)))), _^_(2, SH_N)))
    if _<_(SH_I, _^_(2, SH_N))
       /\ _<_(SH_J, _^_(2, SH_N))
       /\ SH_K := shift-count(SH_N, SH_J) .

  ceq narrow--(NW_M, NW_N, U, (NW_I)) = (NW_I)
    if _>_(NW_M, NW_N)
       /\ _<_(NW_I, _^_(2, NW_N)) .
  ceq narrow--(NW_M, NW_N, U, (NW_I)) = (sd(1, _^_(2, NW_N)))
    if _>_(NW_M, NW_N)
       /\ _>=_(NW_I, _^_(2, NW_N))
       /\ _<_(NW_I, _^_(2, sd(1, NW_M))) .
  ceq narrow--(NW_M, NW_N, U, (NW_I)) = (0)
    if _>_(NW_M, NW_N)
       /\ _>=_(NW_I, _^_(2, sd(1, NW_M)))
       /\ _<_(NW_I, _^_(2, NW_M)) .
  ceq narrow--(NW_M, NW_N, S, (NW_I)) = (NW_I)
    if _>_(NW_M, NW_N)
       /\ _<_(NW_I, _^_(2, sd(1, NW_N))) .
  ceq narrow--(NW_M, NW_N, S, (NW_I)) = (sd(1, _^_(2, sd(1, NW_N))))
    if _>_(NW_M, NW_N)
       /\ _>=_(NW_I, _^_(2, sd(1, NW_N)))
       /\ _<_(NW_I, _^_(2, sd(1, NW_M))) .
  ceq narrow--(NW_M, NW_N, S, (NW_I)) = (_^_(2, sd(1, NW_N)))
    if _>_(NW_M, NW_N)
       /\ _>=_(NW_I, _^_(2, sd(1, NW_M)))
       /\ _<_(NW_I, sd(_^_(2, sd(1, NW_N)), _^_(2, NW_M))) .
  ceq narrow--(NW_M, NW_N, S, (NW_I)) = (_+_(_-_(NW_I, _^_(2, NW_M)), _^_(2, NW_N)))
    if _>_(NW_M, NW_N)
       /\ _>=_(NW_I, sd(_^_(2, sd(1, NW_N)), _^_(2, NW_M)))
       /\ _<_(NW_I, _^_(2, NW_M)) .

  ceq iavgr-(AV_N, U, (AV_I), (AV_J)) =
      (_quo_(_+_(_+_(AV_I, AV_J), 1), 2))
    if _>_(AV_N, 0)
       /\ _<_(AV_I, _^_(2, AV_N))
       /\ _<_(AV_J, _^_(2, AV_N)) .

  ceq iq15mulr-sat-(Q15_N, S, (Q15_I), (Q15_J)) =
      (wrap-s-int(Q15_N,
        sat-s-int(Q15_N,
          floor-div-pow2-int(
            _+_(_*_(signed-nat(Q15_N, Q15_I), signed-nat(Q15_N, Q15_J)), 16384),
            32768))))
    if Q15_N = 16
       /\ _<_(Q15_I, _^_(2, Q15_N))
       /\ _<_(Q15_J, _^_(2, Q15_N)) .

  ceq truncz(rat(TZ_R)) = floor(TZ_R)
    if _>=_(TZ_R, 0) .
  ceq truncz(rat(TZ_R)) = ceiling(TZ_R)
    if _<_(TZ_R, 0) .

  eq ceilz(rat(TZ_R)) = ceiling(TZ_R) .

  ceq fsqrt-(FI_N, POS(FI_MAG)) = POS(sqrt-fmag(FI_N, FI_MAG))
    if (float-finite(FI_N, POS(FI_MAG))) = true .
  eq fsqrt-(FI_N, POS(INF)) = POS(INF) .
  eq fsqrt-(FI_N, NEG(SUBNORM(0))) = NEG(SUBNORM(0)) .
  ceq fsqrt-(FI_N, NEG(SUBNORM(FI_FRAC))) = float-default-nan(FI_N)
    if _>_(FI_FRAC, 0)
       /\ (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq fsqrt-(FI_N, NEG(NORM(FI_FRAC, FI_E))) = float-default-nan(FI_N)
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  eq fsqrt-(FI_N, NEG(INF)) = float-default-nan(FI_N) .
  ceq fsqrt-(FI_N, POS(NAN(FI_FRAC))) = float-canonical-nan(FI_N, POS(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq fsqrt-(FI_N, NEG(NAN(FI_FRAC))) = float-canonical-nan(FI_N, NEG(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .

  ceq fceil-(FI_N, FI_F) = int-to-float-like(FI_N, FI_X, FI_F)
    if (float-finite(FI_N, FI_F)) = true
       /\ FI_R := float-rat(FI_N, FI_F)
       /\ FI_X := ceiling(FI_R) .
  ceq ffloor-(FI_N, FI_F) = int-to-float-like(FI_N, FI_X, FI_F)
    if (float-finite(FI_N, FI_F)) = true
       /\ FI_R := float-rat(FI_N, FI_F)
       /\ FI_X := floor(FI_R) .
  ceq ftrunc-(FI_N, FI_F) = int-to-float-like(FI_N, FI_X, FI_F)
    if (float-finite(FI_N, FI_F)) = true
       /\ FI_R := float-rat(FI_N, FI_F)
       /\ FI_X := trunc-rat-int(FI_R) .
  ceq fnearest-(FI_N, FI_F) = int-to-float-like(FI_N, FI_X, FI_F)
    if (float-finite(FI_N, FI_F)) = true
       /\ FI_R := float-rat(FI_N, FI_F)
       /\ FI_X := nearest-rat-int(FI_R) .
  eq fceil-(FI_N, POS(INF)) = POS(INF) .
  eq fceil-(FI_N, NEG(INF)) = NEG(INF) .
  eq ffloor-(FI_N, POS(INF)) = POS(INF) .
  eq ffloor-(FI_N, NEG(INF)) = NEG(INF) .
  eq ftrunc-(FI_N, POS(INF)) = POS(INF) .
  eq ftrunc-(FI_N, NEG(INF)) = NEG(INF) .
  eq fnearest-(FI_N, POS(INF)) = POS(INF) .
  eq fnearest-(FI_N, NEG(INF)) = NEG(INF) .
  ceq fceil-(FI_N, POS(NAN(FI_FRAC))) = float-canonical-nan(FI_N, POS(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq fceil-(FI_N, NEG(NAN(FI_FRAC))) = float-canonical-nan(FI_N, NEG(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq ffloor-(FI_N, POS(NAN(FI_FRAC))) = float-canonical-nan(FI_N, POS(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq ffloor-(FI_N, NEG(NAN(FI_FRAC))) = float-canonical-nan(FI_N, NEG(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq ftrunc-(FI_N, POS(NAN(FI_FRAC))) = float-canonical-nan(FI_N, POS(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq ftrunc-(FI_N, NEG(NAN(FI_FRAC))) = float-canonical-nan(FI_N, NEG(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq fnearest-(FI_N, POS(NAN(FI_FRAC))) = float-canonical-nan(FI_N, POS(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .
  ceq fnearest-(FI_N, NEG(NAN(FI_FRAC))) = float-canonical-nan(FI_N, NEG(NAN(FI_FRAC)))
    if (fnmag-valid(FI_N, NAN(FI_FRAC))) = true .

  ceq fadd-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq fadd-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ float-nan-bit(FC_N, FC_F2) = 1 .
  eq fadd-(FC_N, POS(INF), POS(INF)) = POS(INF) .
  eq fadd-(FC_N, NEG(INF), NEG(INF)) = NEG(INF) .
  eq fadd-(FC_N, POS(INF), NEG(INF)) = float-default-nan(FC_N) .
  eq fadd-(FC_N, NEG(INF), POS(INF)) = float-default-nan(FC_N) .
  ceq fadd-(FC_N, POS(INF), FC_F1) = POS(INF)
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fadd-(FC_N, FC_F1, POS(INF)) = POS(INF)
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fadd-(FC_N, NEG(INF), FC_F1) = NEG(INF)
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fadd-(FC_N, FC_F1, NEG(INF)) = NEG(INF)
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fadd-(FC_N, FC_F1, FC_F2) = float-add-result(FC_N, FC_F1, FC_F2, _+_(FC_R1, FC_R2))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .

  ceq fsub-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq fsub-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ float-nan-bit(FC_N, FC_F2) = 1 .
  ceq fsub-(FC_N, FC_F1, FC_F2) = fadd-(FC_N, FC_F1, float-neg(FC_N, FC_F2))
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ float-nan-bit(FC_N, FC_F2) = 0 .

  ceq fmul-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq fmul-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ float-nan-bit(FC_N, FC_F2) = 1 .
  eq fmul-(FC_N, POS(INF), POS(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fmul-(FC_N, POS(INF), NEG(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fmul-(FC_N, NEG(INF), POS(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fmul-(FC_N, NEG(INF), NEG(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fmul-(FC_N, POS(SUBNORM(0)), POS(INF)) = float-default-nan(FC_N) .
  eq fmul-(FC_N, NEG(SUBNORM(0)), POS(INF)) = float-default-nan(FC_N) .
  eq fmul-(FC_N, POS(SUBNORM(0)), NEG(INF)) = float-default-nan(FC_N) .
  eq fmul-(FC_N, NEG(SUBNORM(0)), NEG(INF)) = float-default-nan(FC_N) .
  eq fmul-(FC_N, POS(INF), POS(INF)) = POS(INF) .
  eq fmul-(FC_N, POS(INF), NEG(INF)) = NEG(INF) .
  eq fmul-(FC_N, NEG(INF), POS(INF)) = NEG(INF) .
  eq fmul-(FC_N, NEG(INF), NEG(INF)) = POS(INF) .
  ceq fmul-(FC_N, POS(INF), FC_F1) =
      float-signed-inf(float-sign-bit(FC_N, FC_F1))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fmul-(FC_N, FC_F1, POS(INF)) =
      float-signed-inf(float-sign-bit(FC_N, FC_F1))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fmul-(FC_N, NEG(INF), FC_F1) =
      float-signed-inf(bit-xor(1, float-sign-bit(FC_N, FC_F1)))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fmul-(FC_N, FC_F1, NEG(INF)) =
      float-signed-inf(bit-xor(1, float-sign-bit(FC_N, FC_F1)))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fmul-(FC_N, FC_F1, FC_F2) =
      rat-to-float-nearest-signed-zero(
        FC_N,
        bit-xor(float-sign-bit(FC_N, FC_F1), float-sign-bit(FC_N, FC_F2)),
        _*_(FC_R1, FC_R2))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .

  ceq fdiv-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq fdiv-(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ float-nan-bit(FC_N, FC_F2) = 1 .
  eq fdiv-(FC_N, POS(SUBNORM(0)), POS(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, POS(SUBNORM(0)), NEG(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, NEG(SUBNORM(0)), POS(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, NEG(SUBNORM(0)), NEG(SUBNORM(0))) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, POS(INF), POS(INF)) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, POS(INF), NEG(INF)) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, NEG(INF), POS(INF)) = float-default-nan(FC_N) .
  eq fdiv-(FC_N, NEG(INF), NEG(INF)) = float-default-nan(FC_N) .
  ceq fdiv-(FC_N, FC_F1, POS(SUBNORM(0))) =
      float-signed-inf(float-sign-bit(FC_N, FC_F1))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fdiv-(FC_N, FC_F1, NEG(SUBNORM(0))) =
      float-signed-inf(bit-xor(float-sign-bit(FC_N, FC_F1), 1))
    if (float-finite(FC_N, FC_F1)) = true
       /\ _=/=_(float-rat(FC_N, FC_F1), 0) .
  ceq fdiv-(FC_N, POS(INF), FC_F1) =
      float-signed-inf(float-sign-bit(FC_N, FC_F1))
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fdiv-(FC_N, NEG(INF), FC_F1) =
      float-signed-inf(bit-xor(1, float-sign-bit(FC_N, FC_F1)))
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fdiv-(FC_N, FC_F1, POS(INF)) =
      float-signed-zero(float-sign-bit(FC_N, FC_F1))
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fdiv-(FC_N, FC_F1, NEG(INF)) =
      float-signed-zero(bit-xor(float-sign-bit(FC_N, FC_F1), 1))
    if (float-finite(FC_N, FC_F1)) = true .
  ceq fdiv-(FC_N, FC_F1, FC_F2) =
      rat-to-float-nearest-signed-zero(
        FC_N,
        bit-xor(float-sign-bit(FC_N, FC_F1), float-sign-bit(FC_N, FC_F2)),
        _/_(FC_R1, FC_R2))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2)
       /\ _=/=_(FC_R2, 0) .

  eq fmin-(FC_N, FC_F1, FC_F2) =
      float-min(FC_N, FC_F1, FC_F2) .
  eq fmax-(FC_N, FC_F1, FC_F2) =
      float-max(FC_N, FC_F1, FC_F2) .
  eq fpmin-(FC_N, FC_F1, FC_F2) =
      float-pmin(FC_N, FC_F1, FC_F2) .
  eq fpmax-(FC_N, FC_F1, FC_F2) =
      float-pmax(FC_N, FC_F1, FC_F2) .

  eq feq-(FC_N, FC_F1, FC_F2) =
      (float-eq-bit(FC_N, FC_F1, FC_F2)) .
  eq fne-(FC_N, FC_F1, FC_F2) =
      (
        bit-or(float-nan-bit(FC_N, FC_F1),
          bit-or(float-nan-bit(FC_N, FC_F2),
            bit-not(float-eq-bit(FC_N, FC_F1, FC_F2))))) .
  eq flt-(FC_N, FC_F1, FC_F2) =
      (float-lt-bit(FC_N, FC_F1, FC_F2)) .
  eq fgt-(FC_N, FC_F1, FC_F2) =
      (float-lt-bit(FC_N, FC_F2, FC_F1)) .
  eq fle-(FC_N, FC_F1, FC_F2) =
      (
        bit-and(bit-not(float-nan-bit(FC_N, FC_F1)),
          bit-and(bit-not(float-nan-bit(FC_N, FC_F2)),
            bit-not(float-lt-bit(FC_N, FC_F2, FC_F1))))) .
  eq fge-(FC_N, FC_F1, FC_F2) =
      (
        bit-and(bit-not(float-nan-bit(FC_N, FC_F1)),
          bit-and(bit-not(float-nan-bit(FC_N, FC_F2)),
            bit-not(float-lt-bit(FC_N, FC_F1, FC_F2))))) .

  ceq trunc--(FI_M, FI_N, U, FI_F) = (int-to-iN(FI_N, FI_X))
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _>=_(FI_X, 0)
       /\ _<_(FI_X, _^_(2, FI_N)) .
  ceq trunc--(FI_M, FI_N, S, FI_F) = (int-to-iN(FI_N, FI_X))
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _>=_(FI_X, - _^_(2, _-_(FI_N, 1)))
       /\ _<=_(FI_X, _-_( _^_(2, _-_(FI_N, 1)), 1)) .
  eq trunc--(FI_M, FI_N, U, POS(INF)) = eps .
  eq trunc--(FI_M, FI_N, U, NEG(INF)) = eps .
  ceq trunc--(FI_M, FI_N, U, POS(NAN(FI_FRAC))) = eps
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc--(FI_M, FI_N, U, NEG(NAN(FI_FRAC))) = eps
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  eq trunc--(FI_M, FI_N, S, POS(INF)) = eps .
  eq trunc--(FI_M, FI_N, S, NEG(INF)) = eps .
  ceq trunc--(FI_M, FI_N, S, POS(NAN(FI_FRAC))) = eps
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc--(FI_M, FI_N, S, NEG(NAN(FI_FRAC))) = eps
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc--(FI_M, FI_N, U, FI_F) = eps
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _<_(FI_X, 0) .
  ceq trunc--(FI_M, FI_N, U, FI_F) = eps
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _>=_(FI_X, _^_(2, FI_N)) .
  ceq trunc--(FI_M, FI_N, S, FI_F) = eps
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _<_(FI_X, - _^_(2, _-_(FI_N, 1))) .
  ceq trunc--(FI_M, FI_N, S, FI_F) = eps
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R)
       /\ _>_(FI_X, _-_( _^_(2, _-_(FI_N, 1)), 1)) .

  ceq trunc-sat--(FI_M, FI_N, U, FI_F) = (saturate-u-int(FI_N, FI_X))
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R) .
  ceq trunc-sat--(FI_M, FI_N, S, FI_F) = (saturate-s-int(FI_N, FI_X))
    if _>_(FI_N, 0)
       /\ (float-finite(FI_M, FI_F)) = true
       /\ FI_R := float-rat(FI_M, FI_F)
       /\ FI_X := trunc-rat-int(FI_R) .
  eq trunc-sat--(FI_M, FI_N, U, POS(INF)) = (_-_(_^_(2, FI_N), 1)) .
  eq trunc-sat--(FI_M, FI_N, U, NEG(INF)) = (0) .
  ceq trunc-sat--(FI_M, FI_N, U, POS(NAN(FI_FRAC))) = (0)
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc-sat--(FI_M, FI_N, U, NEG(NAN(FI_FRAC))) = (0)
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc-sat--(FI_M, FI_N, S, POS(INF)) = (_-_(_^_(2, _-_(FI_N, 1)), 1))
    if _>_(FI_N, 0) .
  ceq trunc-sat--(FI_M, FI_N, S, NEG(INF)) = (int-to-iN(FI_N, - _^_(2, _-_(FI_N, 1))))
    if _>_(FI_N, 0) .
  ceq trunc-sat--(FI_M, FI_N, S, POS(NAN(FI_FRAC))) = (0)
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .
  ceq trunc-sat--(FI_M, FI_N, S, NEG(NAN(FI_FRAC))) = (0)
    if (fnmag-valid(FI_M, NAN(FI_FRAC))) = true .

  ceq convert--(FI_M, FI_N, U, (FI_RESULT)) =
      POS(rounded-nat-to-fmag(FI_N, FI_RESULT))
    if _>_(FI_M, 0)
       /\ _>_(FI_N, 0)
       /\ _<_(FI_RESULT, _^_(2, FI_M))
       /\ (fnmag-valid(FI_N, rounded-nat-to-fmag(FI_N, FI_RESULT))) = true .
  ceq convert--(FI_M, FI_N, S, (FI_RESULT)) =
      POS(rounded-nat-to-fmag(FI_N, FI_RESULT))
    if _>_(FI_M, 0)
       /\ _>_(FI_N, 0)
       /\ _<_(FI_RESULT, _^_(2, _-_(FI_M, 1)))
       /\ (fnmag-valid(FI_N, rounded-nat-to-fmag(FI_N, FI_RESULT))) = true .
  ceq convert--(FI_M, FI_N, S, (FI_RESULT)) =
      NEG(rounded-nat-to-fmag(FI_N, _-_(_^_(2, FI_M), FI_RESULT)))
    if _>_(FI_M, 0)
       /\ _>_(FI_N, 0)
       /\ _>=_(FI_RESULT, _^_(2, _-_(FI_M, 1)))
       /\ _<_(FI_RESULT, _^_(2, FI_M))
       /\ (fnmag-valid(FI_N, rounded-nat-to-fmag(FI_N, _-_(_^_(2, FI_M), FI_RESULT)))) = true .

  ceq demote--(64, 32, POS(FI_MAG)) = demote-f64(POS(FI_MAG))
    if (fnmag-valid(64, FI_MAG)) = true .
  ceq demote--(64, 32, NEG(FI_MAG)) = demote-f64(NEG(FI_MAG))
    if (fnmag-valid(64, FI_MAG)) = true .

  ceq promote--(32, 64, POS(FI_MAG)) = promote-f32(POS(FI_MAG))
    if (fnmag-valid(32, FI_MAG)) = true .
  ceq promote--(32, 64, NEG(FI_MAG)) = promote-f32(NEG(FI_MAG))
    if (fnmag-valid(32, FI_MAG)) = true .

  ceq fabs-(FS_N, POS(FS_MAG)) = POS(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true .
  ceq fabs-(FS_N, NEG(FS_MAG)) = POS(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true .

  ceq fneg-(FS_N, POS(FS_MAG)) = NEG(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true .
  ceq fneg-(FS_N, NEG(FS_MAG)) = POS(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true .

  ceq fcopysign-(FS_N, POS(FS_MAG), POS(FS_MAG2)) = POS(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true
       /\ (fnmag-valid(FS_N, FS_MAG2)) = true .
  ceq fcopysign-(FS_N, NEG(FS_MAG), POS(FS_MAG2)) = POS(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true
       /\ (fnmag-valid(FS_N, FS_MAG2)) = true .
  ceq fcopysign-(FS_N, POS(FS_MAG), NEG(FS_MAG2)) = NEG(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true
       /\ (fnmag-valid(FS_N, FS_MAG2)) = true .
  ceq fcopysign-(FS_N, NEG(FS_MAG), NEG(FS_MAG2)) = NEG(FS_MAG)
    if (fnmag-valid(FS_N, FS_MAG)) = true
       /\ (fnmag-valid(FS_N, FS_MAG2)) = true .

  --- Implemented declaration-only builtin: canonical UTF-8 encoding of char*.
  var UTF_C : Nat .
  var UTF_REST : SpectecTerminals .
  eq utf8(eps) = eps .
  ceq utf8(UTF_C UTF_REST) =
      UTF_C utf8(UTF_REST)
    if _<_(UTF_C, 128)
       /\ (typecheck(UTF_REST, char)) = true .
  ceq utf8(UTF_C UTF_REST) =
      (_+_(192, _quo_(UTF_C, 64)))
      (_+_(128, _rem_(UTF_C, 64)))
      utf8(UTF_REST)
    if _>=_(UTF_C, 128) /\ _<_(UTF_C, 2048)
       /\ (typecheck(UTF_REST, char)) = true .
  ceq utf8(UTF_C UTF_REST) =
      (_+_(224, _quo_(UTF_C, 4096)))
      (_+_(128, _rem_(_quo_(UTF_C, 64), 64)))
      (_+_(128, _rem_(UTF_C, 64)))
      utf8(UTF_REST)
    if _or_(_and_(_>=_(UTF_C, 2048), _<_(UTF_C, 55296)),
             _and_(_>=_(UTF_C, 57344), _<_(UTF_C, 65536)))
       /\ (typecheck(UTF_REST, char)) = true .
  ceq utf8(UTF_C UTF_REST) =
      (_+_(240, _quo_(UTF_C, 262144)))
      (_+_(128, _rem_(_quo_(UTF_C, 4096), 64)))
      (_+_(128, _rem_(_quo_(UTF_C, 64), 64)))
      (_+_(128, _rem_(UTF_C, 64)))
      utf8(UTF_REST)
    if _>=_(UTF_C, 65536) /\ _<_(UTF_C, 1114112)
       /\ (typecheck(UTF_REST, char)) = true .

  --- Backend semantics: official-spectec-deterministic.
  --- Source: spectec/src/backend-interpreter/numerics.ml.
  --- Reference revision: d34a973e70ab127476b5d8591c6f558be289b929.
  --- Relaxed madd is separately rounded fmul- then fadd-, not fused.
  --- This intentionally differs from the direct Wasm interpreter's fused choice.
  vars BDR_M BDR_N BDR_I BDR_J BDR_K : Nat .
  var BDR_SX : SpectecTerminal .
  vars BDR_F1 BDR_F2 BDR_F3 : SpectecTerminal .

  --- official-spectec-deterministic: partial inverse sequence choices.
  var BDI_T : SpectecType .
  var BDI_X : SpectecTerminal .
  vars BDI_XS BDI_REST : SpectecTerminals .
  var BDI_Y : SpectecTerminal .
  op pair-chunks : SpectecTerminals ~> SpectecTerminals .
  eq pair-chunks(eps) = eps .
  eq pair-chunks(BDI_X BDI_Y BDI_REST) =
      seq(BDI_X BDI_Y) pair-chunks(BDI_REST) .
  ceq inv-concat-(BDI_T, BDI_XS) = pair-chunks(BDI_XS)
    if _==_(_rem_(len(BDI_XS), 2), 0) .
  var BDI_N : NzNat .
  var BDI_K : Nat .
  op take-exact : Nat SpectecTerminals ~> SpectecTerminals .
  op fixed-chunks : NzNat SpectecTerminals ~> SpectecTerminals .
  eq take-exact(0, BDI_XS) = eps .
  eq take-exact(s BDI_K, BDI_X BDI_REST) =
      BDI_X take-exact(BDI_K, BDI_REST) .
  eq fixed-chunks(BDI_N, eps) = eps .
  ceq fixed-chunks(BDI_N, BDI_XS) =
      seq(take-exact(BDI_N, BDI_XS))
      fixed-chunks(BDI_N, drop(BDI_N, BDI_XS))
    if _>=_(len(BDI_XS), BDI_N) .
  ceq inv-concatn-(BDI_T, BDI_N, BDI_XS) = fixed-chunks(BDI_N, BDI_XS)
    if _==_(_rem_(len(BDI_XS), BDI_N), 0) .
  eq nd = bool(false) .
  eq r-fmadd = (0) .
  eq r-fmin = (0) .
  eq r-fmax = (0) .
  eq r-idot = (0) .
  eq r-iq15mulr = (0) .
  eq r-trunc-u = (0) .
  eq r-trunc-s = (0) .
  eq r-swizzle = (0) .
  eq r-laneselect = (0) .
  eq irelaxed-q15mulr-(BDR_N, BDR_SX, (BDR_I), (BDR_J)) = iq15mulr-sat-(BDR_N, BDR_SX, (BDR_I), (BDR_J)) .
  eq irelaxed-laneselect-(BDR_N, (BDR_I), (BDR_J), (BDR_K)) = ibitselect-(BDR_N, (BDR_I), (BDR_J), (BDR_K)) .
  eq frelaxed-min-(BDR_N, BDR_F1, BDR_F2) = fmin-(BDR_N, BDR_F1, BDR_F2) .
  eq frelaxed-max-(BDR_N, BDR_F1, BDR_F2) = fmax-(BDR_N, BDR_F1, BDR_F2) .
  eq frelaxed-madd-(BDR_N, BDR_F1, BDR_F2, BDR_F3) = fadd-(BDR_N, fmul-(BDR_N, BDR_F1, BDR_F2), BDR_F3) .
  eq frelaxed-nmadd-(BDR_N, BDR_F1, BDR_F2, BDR_F3) = fadd-(BDR_N, fmul-(BDR_N, fneg-(BDR_N, BDR_F1), BDR_F2), BDR_F3) .
  eq relaxed-trunc--(BDR_M, BDR_N, BDR_SX, BDR_F1) = trunc-sat--(BDR_M, BDR_N, BDR_SX, BDR_F1) .

endm
