;; val and instr have the same cases, so the elaborator notes the use of val*
;; in the conclusion as instr* while its binder and the premise have val*.
;; Both uses must be one Maude variable.

syntax instr hint(maude_sort) = ONE | TWO | FLIP
syntax val hint(maude_sort) hint(maude_subsort "instr") = ONE | TWO | FLIP
syntax config = nat; instr*

relation Step: config ~> config
relation Step_pure: instr* ~> instr*

rule Step_pure/flip-one:
  ONE FLIP ~> TWO

rule Step/pure:
  z; instr* ~> z; instr'*
  -- Step_pure: instr* ~> instr'*
  hint(k_heatcool)

rule Step/ctxt:
  z; val* instr* instr_1* ~> z'; val* instr'* instr_1*
  -- Step: z; instr* ~> z'; instr'*
  -- if val* =/= eps \/ instr_1* =/= eps
  hint(k_heatcool "val* instr* instr_1*")
