(module
  (func $target)
  (global (export "seven") i32 (i32.const 7))
  (func (export "one") (result i32) i32.const 1)
  (func (export "canonical-f32") (result f32) f32.const nan)
  (func (export "arithmetic-f64") (result f64)
    f64.const nan:0x8000000000001)
  (func (export "exact-nan-f32") (result f32)
    f32.const nan:0x400001)
  (func (export "function") (result funcref) ref.func $target)
  (func (export "null-func") (result funcref) ref.null func)
  (func (export "null-extern") (result externref) ref.null extern)
  (func (export "extern-id") (param externref) (result externref)
    local.get 0)
  (elem declare func $target))

(assert_return (invoke "one")
  (either (i32.const 0) (i32.const 1) (i32.const 2)))
(assert_return (invoke "canonical-f32") (f32.const nan:canonical))
(assert_return (invoke "arithmetic-f64") (f64.const nan:arithmetic))
(assert_return (invoke "exact-nan-f32") (f32.const nan:0x400001))
(assert_return (invoke "function") (ref.func))
(assert_return (invoke "null-func") (ref.null func))
(assert_return (invoke "null-extern") (ref.null extern))
(assert_return (invoke "null-extern") (ref))
(assert_return (invoke "extern-id" (ref.extern 1)) (ref))
(assert_return (invoke "function") (ref.extern))
(assert_return (invoke "null-extern") (ref.extern))
