(module
  (func (export "f32-mixed") (result v128)
    v128.const f32x4 nan -nan:0x400001 -0 1)
  (func (export "f32-nans") (result v128)
    v128.const f32x4 nan -nan nan:0x400001 -nan:0x400001)
  (func (export "f64-mixed-positive") (result v128)
    v128.const f64x2 nan -0)
  (func (export "f64-mixed-negative") (result v128)
    v128.const f64x2 -nan 1)
  (func (export "f64-arithmetic") (result v128)
    v128.const f64x2 nan:0x8000000000001 -nan:0x8000000000001)
  (func (export "f64-canonical") (result v128)
    v128.const f64x2 nan -nan)
  (func (export "exact") (result v128)
    v128.const f32x4 1 -0 2 3))

(assert_return (invoke "f32-mixed")
  (v128.const f32x4 nan:canonical nan:arithmetic -0 1))
(assert_return (invoke "f32-nans")
  (v128.const f32x4
    nan:canonical nan:canonical nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64-mixed-positive")
  (v128.const f64x2 nan:canonical -0))
(assert_return (invoke "f64-mixed-negative")
  (v128.const f64x2 nan:arithmetic 1))
(assert_return (invoke "f64-arithmetic")
  (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f64-canonical")
  (v128.const f64x2 nan:canonical nan:canonical))
(assert_return (invoke "f64-canonical")
  (v128.const f64x2 nan:arithmetic nan:arithmetic))
(assert_return (invoke "f32-mixed")
  (either
    (v128.const f32x4 0 0 0 0)
    (v128.const f32x4 nan:canonical nan:arithmetic -0 1)))
(assert_return (invoke "exact")
  (v128.const f32x4 1 -0 2 3))
