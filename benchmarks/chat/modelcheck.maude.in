load @SEMANTICS@
load model-checker.maude

mod SPEC2MAUDE-CHAT is
  protecting WASM-BUILTINS .
  including MODEL-CHECKER .

  sorts Policy Member Event Events Verdict ChatState .
  subsort Event < Events .
  subsort ChatState < State .

  ops policy.buggy policy.fixed : -> Policy [ctor] .
  ops member.on member.off : -> Member [ctor] .
  ops event.leave event.send : -> Event [ctor] .
  op no-event : -> Events [ctor] .
  op _;_ : Events Events -> Events [ctor assoc comm id: no-event] .
  ops verdict.safe verdict.violation : -> Verdict [ctor] .

  op boot : Policy -> ChatState [ctor] .
  op init : Policy SpectecTerminal -> ChatState [ctor frozen (2)] .
  op ready : Policy Member Events SpectecTerminal SpectecTerminal Verdict
    -> ChatState [ctor] .
  op executing : Policy Member Events SpectecTerminal SpectecTerminal
    Verdict SpectecTerminal -> ChatState [ctor frozen (7)] .
  op observed : Policy Member Events SpectecTerminal SpectecTerminal
    Verdict SpectecTerminal -> ChatState [ctor] .
  op finished : Policy Verdict -> ChatState [ctor] .

  op inputModule : -> SpectecTerminal .
  op emptyStore : -> SpectecTerminal .
  op policyName : Policy -> SpectecTerminal .
  op memberValue : Member -> SpectecTerminal .
  op chatArgs : Member -> SpectecTerminals .
  op findFunc : SpectecTerminals SpectecTerminal ~> SpectecTerminal .

  op chat-buggy : -> ChatState .
  op chat-fixed : -> ChatState .
  ops revoked-message-accepted quiescent : -> Prop [ctor] .

  vars C S S2 MI NAME OTHER ADDR XA VALUE : SpectecTerminal .
  vars LOCALS EXPORTS : SpectecTerminals .
  var P : Policy .
  var M : Member .
  var NET : Events .
  var V : Verdict .
  var ST : ChatState .
  var PROP : Prop .

  eq inputModule =
@INPUT_MODULE@
  .
  eq emptyStore = rec.store(eps, eps, eps, eps, eps,
    eps, eps, eps, eps, eps) .
  eq policyName(policy.buggy) =
    name.wrap(char.wrap(98) char.wrap(117) char.wrap(103)
      char.wrap(103) char.wrap(121)) .
  eq policyName(policy.fixed) =
    name.wrap(char.wrap(102) char.wrap(105) char.wrap(120)
      char.wrap(101) char.wrap(100)) .
  eq memberValue(member.on) = uN.wrap(1) .
  eq memberValue(member.off) = uN.wrap(0) .
  eq chatArgs(M) =
    const(i32, memberValue(M))
    const(i32, uN.wrap(1))
    const(i32, uN.wrap(1))
    const(i32, uN.wrap(0))
    const(i32, uN.wrap(1)) .

  eq findFunc(
    rec.exportinst(NAME, externaddr.func(ADDR)) EXPORTS, NAME) = ADDR .
  ceq findFunc(rec.exportinst(OTHER, XA) EXPORTS, NAME) =
      findFunc(EXPORTS, NAME)
    if OTHER =/= NAME .

  eq chat-buggy = boot(policy.buggy) .
  eq chat-fixed = boot(policy.fixed) .

  crl [instantiate] : boot(P) => init(P, C)
    if def.instantiate(emptyStore, inputModule, eps) => C .
  crl [initialize] : init(P, C) =>
      ready(P, member.on, event.leave ; event.send, S, MI, verdict.safe)
    if rel.steps(C) =>
      config.sym(state.sym(S, rec.frame(LOCALS, MI)), eps) .

  rl [deliver-leave] :
    ready(P, member.on, event.leave ; NET, S, MI, V)
    => ready(P, member.off, NET, S, MI, V) .
  rl [deliver-old-leave] :
    ready(P, member.off, event.leave ; NET, S, MI, V)
    => ready(P, member.off, NET, S, MI, V) .

  rl [deliver-send] :
    ready(P, M, event.send ; NET, S, MI, V)
    => executing(P, M, NET, S, MI, V,
      def.invoke(S, findFunc(value('EXPORTS, MI), policyName(P)),
        chatArgs(M))) .
  crl [execute-handler] :
    executing(P, M, NET, S, MI, V, C)
    => observed(P, M, NET, S2, MI, V, VALUE)
    if rel.steps(C) =>
      config.sym(S2, const(i32, VALUE)) .

  rl [reject] :
    observed(P, M, NET, S, MI, V, uN.wrap(0))
    => ready(P, M, NET, S, MI, V) .
  rl [accept-active] :
    observed(P, member.on, NET, S, MI, V, uN.wrap(1))
    => ready(P, member.on, NET, S, MI, V) .
  rl [accept-revoked] :
    observed(P, member.off, NET, S, MI, V, uN.wrap(1))
    => ready(P, member.off, NET, S, MI, verdict.violation) .

  rl [finish] :
    ready(P, M, no-event, S, MI, V) => finished(P, V) .

  eq finished(P, verdict.violation) |=
    revoked-message-accepted = true .
  eq finished(P, V) |= quiescent = true .
  eq ST |= PROP = false [owise] .
endm

search [1, 100] in SPEC2MAUDE-CHAT :
  chat-buggy =>* finished(policy.buggy, verdict.violation) .

search [1, 100] in SPEC2MAUDE-CHAT :
  chat-fixed =>* finished(policy.fixed, verdict.violation) .

red in SPEC2MAUDE-CHAT :
  modelCheck(chat-buggy, [] ~ revoked-message-accepted) .
red in SPEC2MAUDE-CHAT :
  modelCheck(chat-fixed, [] ~ revoked-message-accepted) .
red in SPEC2MAUDE-CHAT : modelCheck(chat-buggy, <> quiescent) .
red in SPEC2MAUDE-CHAT : modelCheck(chat-fixed, <> quiescent) .
