load model-checker.maude

mod EMSCRIPTEN-DLOPEN-MC is
  protecting WASM-BUILTINS .
  including MODEL-CHECKER .

  sorts LoaderState LoaderMode CacheState Phase Outcome .
  subsort LoaderState < State .

  ops current fixed : -> LoaderMode [ctor] .
  ops absent loading loaded : -> CacheState [ctor] .
  ops idle constructing : -> Phase [ctor] .
  ops none failed succeeded : -> Outcome [ctor] .

  op loader : LoaderMode CacheState Nat Phase Outcome -> LoaderState [ctor] .
  op current-init : -> LoaderState .
  op fixed-init : -> LoaderState .

  eq current-init = loader(current, absent, 0, idle, none) .
  eq fixed-init = loader(fixed, absent, 0, idle, none) .

  vars M : LoaderMode .
  vars N : Nat .
  vars O : Outcome .

  --- Both loaders reserve/cache a DSO as `loading` before instantiation.
  crl [begin-load] :
    loader(M, absent, N, idle, O)
    => loader(M, loading, N + 1, constructing, none)
    if N < 2 .

  --- Current libdylink.js rejection path returns to dlopen without evicting
  --- LDSO.loadedLibsByName[libName].  The cache therefore remains `loading`.
  rl [constructor-trap-current] :
    loader(current, loading, N, constructing, none)
    => loader(current, loading, N, idle, failed) .

  --- On the second dlopen, the existing-DSO fast path treats the stale entry
  --- as already loaded when ASSERTIONS=0 and returns a non-null handle.
  rl [reuse-stale-loading-dso] :
    loader(current, loading, 1, idle, failed)
    => loader(current, loading, 2, idle, succeeded) .

  --- Minimal remediation: a rejected load evicts the cached loading DSO.
  rl [constructor-trap-fixed] :
    loader(fixed, loading, N, constructing, none)
    => loader(fixed, absent, N, idle, failed) .

  op poisoned-handle : -> Prop [ctor] .
  op failed-dso-cached : -> Prop [ctor] .
  var LS : LoaderState .

  eq loader(current, loading, 2, idle, succeeded) |= poisoned-handle = true .
  eq LS |= poisoned-handle = false [owise] .

  eq loader(current, loading, 1, idle, failed) |= failed-dso-cached = true .
  eq LS |= failed-dso-cached = false [owise] .
endm

select EMSCRIPTEN-DLOPEN-MC .

--- Current production loader: both the stale cache and poisoned success are
--- reachable, and the safety invariant has a counterexample.
search [1] in EMSCRIPTEN-DLOPEN-MC :
  current-init =>* LS:LoaderState
  such that LS:LoaderState |= failed-dso-cached .

search [1] in EMSCRIPTEN-DLOPEN-MC :
  current-init =>* LS:LoaderState
  such that LS:LoaderState |= poisoned-handle .

red in EMSCRIPTEN-DLOPEN-MC :
  modelCheck(current-init, [] ~ poisoned-handle) .

--- Cache-eviction remediation: poisoned success is unreachable and the same
--- invariant holds for the bounded two-attempt scenario.
search [1] in EMSCRIPTEN-DLOPEN-MC :
  fixed-init =>* LS:LoaderState
  such that LS:LoaderState |= poisoned-handle .

red in EMSCRIPTEN-DLOPEN-MC :
  modelCheck(fixed-init, [] ~ poisoned-handle) .

quit
