load /Users/minsung/Dev/projects/Spec2Maude/translator/backend/semantics.maude
load model-checker.maude

mod WASM2MAUDE-MODELCHECK is
  protecting WASM-BUILTINS .
  including MODEL-CHECKER .

  sort ModelState .
  subsort ModelState < State .
  op boot : -> ModelState [ctor] .
  op init : SpectecTerminal -> ModelState [ctor frozen (1)] .
  op ready : SpectecTerminal -> ModelState [ctor] .
  op exec : SpectecTerminal -> ModelState [ctor frozen (1)] .
  op finished : SpectecTerminal -> ModelState [ctor] .

  op inputModule : -> SpectecTerminal .
  op inputName : -> SpectecTerminals .
  op inputArgs : -> SpectecTerminals .
  op emptyStore : -> SpectecTerminal .
  op expected : -> SpectecTerminal .
  op rejected : -> SpectecTerminal .
  op findFunc : SpectecTerminals SpectecTerminals ~> Nat .
  op returned : SpectecTerminal -> Prop [ctor] .

  vars C C2 Z XA RESULT : SpectecTerminal .
  vars NAME OTHER EXPORTS RESULTS : SpectecTerminals .
  var ADDR : Nat .
  var ST : ModelState .
  var P : Prop .

  eq inputModule = MODULE(TYPE(REC(SUB(_?(FINAL), eps, FUNC_->_(I64, I64)))), eps, eps, eps,
eps, eps,
spectec-FUNC-2(0, eps,
(LOCAL.GET(0) CONST(I64, 1) RELOP(I64, LE(U))
 IF__ELSE_(-RESULT(_?(I64)), CONST(I64, 1),
 (LOCAL.GET(0) CONST(I64, 2) BINOP(I64, spectec-SUB) CALL(0) LOCAL.GET(0)
  CONST(I64, 1) BINOP(I64, spectec-SUB) CALL(0) BINOP(I64, ADD))))),
eps, eps, eps, EXPORT((102 105 98), FUNC(0))) .
  eq inputName = 102 105 98 .
  eq inputArgs = CONST(I64, 5) .
  eq expected = CONST(I64, 8) .
  eq rejected = CONST(I64, 6) .
  eq emptyStore = {(item('TAGS, eps) ;
  (item('GLOBALS, eps) ;
   (item('MEMS, eps) ;
    (item('TABLES, eps) ;
     (item('FUNCS, eps) ;
      (item('DATAS, eps) ;
       (item('ELEMS, eps) ;
        (item('STRUCTS, eps) ; (item('ARRAYS, eps) ; item('EXNS, eps))))))))))} .

  eq findFunc({(item('NAME, NAME) ; item('ADDR, FUNC(ADDR)))} EXPORTS, NAME) = ADDR .
  ceq findFunc({(item('NAME, OTHER) ; item('ADDR, XA))} EXPORTS, NAME) = findFunc(EXPORTS, NAME)
    if OTHER =/= NAME .

  crl [instantiate] : boot => init(C)
    if instantiate(emptyStore, inputModule, eps) => C .
  crl [init-step] : init(C) => init(C2)
    if Step(C) => C2 .
  crl [initialize] : init(C) => ready(Z)
    if (Z ; eps) := C .
  rl [invoke] : ready(Z) => exec(invoke(spectec-store(Z),
findFunc(value('EXPORTS, spectec-moduleinst(Z)), inputName), inputArgs)) .
  crl [execute-step] : exec(C) => exec(C2)
    if Step(C) => C2 .
  crl [finished] : exec(C) => finished(RESULT)
    if (Z ; RESULTS) := C
    /\ RESULT := RESULTS
    /\ typecheck(RESULT, val) = true .

  eq finished(RESULT) |= returned(RESULT) = true .
  eq ST |= P = false [owise] .
endm

rew [200] in WASM2MAUDE-MODELCHECK : boot .

search [1, 200] in WASM2MAUDE-MODELCHECK :
  boot =>* finished(RESULT)
  such that RESULT == expected .

search [1, 200] in WASM2MAUDE-MODELCHECK :
  boot =>* finished(RESULT)
  such that RESULT == rejected .

red in WASM2MAUDE-MODELCHECK :
  modelCheck(boot, <> returned(expected)) .
red in WASM2MAUDE-MODELCHECK :
  modelCheck(boot, [] ~ returned(rejected)) .
red in WASM2MAUDE-MODELCHECK :
  modelCheck(boot, <> returned(rejected)) .
