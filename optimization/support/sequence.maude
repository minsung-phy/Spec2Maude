fmod DSL-SEQUENCE is
  protecting DSL-OPTION .

  op [_] : SpectecTerminals -> SpectecTerminals [prec 50] .
  eq [TS] = TS .

  op |_| : SpectecTerminals -> Nat .

  --- Large runs of one natural-number terminal stay compact.  This prevents
  --- byte-sized repetitions from consuming the Maude call stack while all
  --- other repetitions retain the ordinary sequence representation.

  op repeatSeqRunThreshold : -> Nat .
  eq repeatSeqRunThreshold = 1024 .

  op runSeq : NzNat Nat -> SpectecTerminals [ctor] .
  op repeatSeq : Nat SpectecTerminals -> SpectecTerminals .

  vars N I : Nat .
  var RUN-COUNT : NzNat .
  vars NAT-VALUE RUN-VALUE : Nat .
  var K : [SpectecTerminal] .
  var T : SpectecTerminal .
  vars TS WTS : SpectecTerminals .
  var TYPE : SpectecType .

  eq len(runSeq(RUN-COUNT, RUN-VALUE)) = RUN-COUNT .
  ceq len(runSeq(RUN-COUNT, RUN-VALUE) TS)
    = RUN-COUNT + len(TS)
    if TS =/= eps .
  eq | TS | = len(TS) .

  eq typecheck(runSeq(RUN-COUNT, RUN-VALUE), TYPE) =
    typecheck(RUN-VALUE, TYPE) .
  ceq typecheck(runSeq(RUN-COUNT, RUN-VALUE) TS, TYPE) =
    typecheck(TS, TYPE)
    if TS =/= eps /\ typecheck(RUN-VALUE, TYPE) .

  eq typecheck(seq(TS), iterOpt(TYPE)) =
    typecheck(TS, TYPE) and len(TS) <= 1 .
  eq typecheck(seq(TS), iterList(TYPE)) = typecheck(TS, TYPE) .
  eq typecheck(seq(TS), iterList1(TYPE)) =
    typecheck(TS, TYPE) and 0 < len(TS) .
  eq typecheck(seq(TS), iterListN(TYPE, N)) =
    typecheck(TS, TYPE) and len(TS) == N .

  eq NAT-VALUE <- (runSeq(RUN-COUNT, NAT-VALUE) TS) = true .
  ceq K <- (runSeq(RUN-COUNT, RUN-VALUE) TS) = K <- TS
    if K =/= RUN-VALUE .

  op indexDefined : SpectecTerminals Nat -> Bool .
  op index : SpectecTerminals Nat ~> SpectecTerminal .

  eq indexDefined(TS, N) = N < len(TS) .
  eq index(T TS, 0) = T .
  ceq index(T TS, s(N)) = index(TS, N)
    if TS =/= eps .
  ceq index((runSeq(RUN-COUNT, RUN-VALUE) TS), I) = RUN-VALUE
    if _<_(I, RUN-COUNT) .
  ceq index((runSeq(RUN-COUNT, RUN-VALUE) TS), I) =
    index(TS, _-_(I, RUN-COUNT))
    if _<=_(RUN-COUNT, I) /\ TS =/= eps .

  op _[_] : SpectecTerminals Nat ~> SpectecTerminal
    [prec 10 gather (E e)] .
  ceq TS[N] = index(TS, N)
    if indexDefined(TS, N) .

  op take : SpectecTerminals Nat -> SpectecTerminals .
  op drop : SpectecTerminals Nat -> SpectecTerminals .
  op slice : SpectecTerminals Nat Nat -> SpectecTerminals .

  eq take(TS, 0) = eps .
  eq take(eps, N) = eps .
  eq take(T TS, s(N)) = T take(TS, N) .
  ceq take((runSeq(RUN-COUNT, RUN-VALUE) TS), s(N)) =
    repeatSeq(s(N), RUN-VALUE)
    if _<_(s(N), RUN-COUNT) .
  ceq take((runSeq(RUN-COUNT, RUN-VALUE) TS), s(N)) =
    (runSeq(RUN-COUNT, RUN-VALUE)
     take(TS, _-_(s(N), RUN-COUNT)))
    if _<=_(RUN-COUNT, s(N)) .

  eq drop(TS, 0) = TS .
  eq drop(eps, N) = eps .
  eq drop(T TS, s(N)) = drop(TS, N) .
  ceq drop((runSeq(RUN-COUNT, RUN-VALUE) TS), s(N)) =
    (repeatSeq(_-_(RUN-COUNT, s(N)), RUN-VALUE) TS)
    if _<_(s(N), RUN-COUNT) .
  ceq drop((runSeq(RUN-COUNT, RUN-VALUE) TS), s(N)) =
    drop(TS, _-_(s(N), RUN-COUNT))
    if _<=_(RUN-COUNT, s(N)) .

  eq slice(TS, N, I) = take(drop(TS, N), I) .

  op _[_:_] : SpectecTerminals Nat Nat -> SpectecTerminals
    [prec 10 gather (E e e)] .
  eq TS[N : I] = slice(TS, N, I) .

  op setAt : SpectecTerminals Nat [SpectecTerminal] -> SpectecTerminals .
  op _[_=_] : SpectecTerminals Nat [SpectecTerminal] -> SpectecTerminals
    [prec 10 gather (E e e)] .

  var NEW-K : [SpectecTerminal] .
  var NEW-TS : SpectecTerminals .

  eq setAt(eps, N, NEW-K) = eps .
  eq setAt(T TS, 0, NEW-K) = NEW-K TS .
  eq setAt(T TS, s(N), NEW-K) = T setAt(TS, N, NEW-K) .
  ceq setAt((runSeq(RUN-COUNT, RUN-VALUE) TS), I, NEW-K) =
    (repeatSeq(I, RUN-VALUE)
     NEW-K
     repeatSeq(_-_(RUN-COUNT, _+_(I, 1)), RUN-VALUE)
     TS)
    if _<_(I, RUN-COUNT) .
  ceq setAt((runSeq(RUN-COUNT, RUN-VALUE) TS), I, NEW-K) =
    (runSeq(RUN-COUNT, RUN-VALUE)
     setAt(TS, _-_(I, RUN-COUNT), NEW-K))
    if _<=_(RUN-COUNT, I) .
  eq TS[N = NEW-K] = setAt(TS, N, NEW-K) .

  op splice : SpectecTerminals Nat Nat SpectecTerminals -> SpectecTerminals .
  op _[_:_=_] : SpectecTerminals Nat Nat SpectecTerminals -> SpectecTerminals
    [prec 10 gather (E e e e)] .

  eq splice(TS, N, I, NEW-TS)
    = take(TS, N) NEW-TS drop(TS, N + I) .
  eq TS[N : I = NEW-TS] = splice(TS, N, I, NEW-TS) .

  op _[_=++_] : SpectecTerminals Nat SpectecTerminals -> SpectecTerminals
    [prec 10 gather (E e e)] .
  op _[_:_=++_] : SpectecTerminals Nat Nat SpectecTerminals -> SpectecTerminals
    [prec 10 gather (E e e e)] .

  ceq TS[N =++ NEW-TS]
    = setAt(TS, N, index(TS, N) ++ NEW-TS)
    if indexDefined(TS, N) .
  eq TS[N : I =++ NEW-TS]
    = splice(TS, N, I, slice(TS, N, I) ++ NEW-TS) .

  op lift : SpectecTerminals -> SpectecTerminals .
  eq lift(eps) = eps .
  eq lift(K ?) = K .

  eq repeatSeq(0, WTS) = eps .
  eq repeatSeq(s(N), eps) = eps .
  ceq repeatSeq(s(N), NAT-VALUE) = runSeq(s(N), NAT-VALUE)
    if repeatSeqRunThreshold <= s(N) .
  eq repeatSeq(s(N), WTS) = WTS repeatSeq(N, WTS) [owise] .

  --- The concrete numeric equations for these source coercions belong to
  --- builtins.maude.

  op _:_<:>_ : SpectecTerminals SpectecType SpectecType
    ~> SpectecTerminals .
endfm
