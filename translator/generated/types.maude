fmod SPEC2MAUDE-SORTS is
  protecting SPECTEC-TERM .

  sort val .

  sort instr .

  sort InstrProper .

  subsort val < instr .

  subsort instr < SpectecTerminal .

  subsort InstrProper < instr .
endfm

view INSTR-VIEW from TRIV to SPEC2MAUDE-SORTS is
  sort Elt to instr .
endv

fmod SPEC2MAUDE-TYPES is
  protecting SPEC2MAUDE-SORTS .
  protecting LIST{INSTR-VIEW} * (
    sort List{INSTR-VIEW} to InstrList,
    sort NeList{INSTR-VIEW} to NeInstrList,
    op _xor_ : Nat Nat -> Nat to integerXor,
    op nil to eps,
    op append to instrAppend,
    op head to instrHead,
    op tail to instrTail,
    op last to instrLast,
    op front to instrFront,
    op occurs to instrOccurs,
    op reverse to instrReverse,
    op $reverse to instrReverseAux,
    op size to instrSize,
    op $size to instrSizeAux
  ) .

  subsort NeValList < NeInstrList .

  subsort ValList < InstrList .

  sort NeValList .

  sort ValList .

  subsort val < NeValList .

  subsort NeValList < ValList .

  op eps : -> ValList [ctor] .

  op __ : ValList ValList -> ValList [ctor ditto] .

  op __ : NeValList ValList -> NeValList [ctor ditto] .

  op __ : ValList NeValList -> NeValList [ctor ditto] .

  op instrAppend : ValList ValList -> ValList .

  op instrAppend : NeValList ValList -> NeValList .

  op instrAppend : ValList NeValList -> NeValList .

  op instrHead : NeValList -> val .

  op instrTail : NeValList -> ValList .

  op instrLast : NeValList -> val .

  op instrFront : NeValList -> ValList .

  op instrReverse : ValList -> ValList .

  op instrReverse : NeValList -> NeValList .

  op instrReverseAux : ValList ValList -> ValList .

  op valRepeat : Nat val -> ValList .

  op instrRepeat : Nat instr -> InstrList .

  var REPEAT-ELEMENT : val .

  var REPEAT-COUNT : Nat .

  var REPEAT-ELEMENT2 : instr .

  eq valRepeat(0, REPEAT-ELEMENT) = eps .

  eq valRepeat(s(REPEAT-COUNT), REPEAT-ELEMENT) = REPEAT-ELEMENT valRepeat(REPEAT-COUNT, REPEAT-ELEMENT) .

  eq instrRepeat(0, REPEAT-ELEMENT2) = eps .

  eq instrRepeat(s(REPEAT-COUNT), REPEAT-ELEMENT2) = REPEAT-ELEMENT2 instrRepeat(REPEAT-COUNT, REPEAT-ELEMENT2) .
endfm
