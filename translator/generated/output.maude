fmod SPEC2MAUDE-SORTS is
  protecting DSL-TERM .

  sort val .

  sort instr .

  sort InstrProper .

  subsort val < instr .

  subsort instr < SpectecTerminal .

  subsort InstrProper < instr .
endfm

view INSTR-VIEW from TRIV to SPEC2MAUDE-SORTS is
  sort Elt to instr .
endv

fmod DSL-PRETYPE is
  protecting DSL-PRETYPE-BASE .
  protecting SPEC2MAUDE-SORTS .
  protecting LIST{INSTR-VIEW} * (
    sort List{INSTR-VIEW} to InstrList,
    sort NeList{INSTR-VIEW} to NeInstrList,
    op nil to eps,
    op append to instrAppend,
    op head to instrHead,
    op tail to instrTail,
    op last to instrLast,
    op front to instrFront,
    op occurs to instrOccurs,
    op reverse to instrReverse,
    op $reverse to instrReverseAux,
    op size to instrSize,
    op $size to instrSizeAux
  ) .

  sort SpectecTerminals .

  subsort SpectecTerminal < SpectecTerminals .

  subsort NeValList < NeInstrList .

  subsort ValList < InstrList .

  subsort InstrList < SpectecTerminals .

  sort NeValList .

  sort ValList .

  subsort val < NeValList .

  subsort NeValList < ValList .

  op eps : -> SpectecTerminals [ctor] .

  op __ : SpectecTerminals SpectecTerminals -> SpectecTerminals [ctor assoc id: eps prec 25] .

  op seq : SpectecTerminals -> SpectecTerminal [ctor] .

  op unseq : SpectecTerminal ~> SpectecTerminals .

  op eps : -> ValList [ctor] .

  op __ : ValList ValList -> ValList [ctor ditto] .

  op __ : NeValList ValList -> NeValList [ctor ditto] .

  op __ : ValList NeValList -> NeValList [ctor ditto] .

  op instrAppend : ValList ValList -> ValList .

  op instrAppend : NeValList ValList -> NeValList .

  op instrAppend : ValList NeValList -> NeValList .

  op instrHead : NeValList -> val .

  op instrTail : NeValList -> ValList .

  op instrLast : NeValList -> val .

  op instrFront : NeValList -> ValList .

  op instrOccurs : val ValList -> Bool .

  op instrReverse : ValList -> ValList .

  op instrReverse : NeValList -> NeValList .

  op instrReverseAux : ValList ValList -> ValList .

  op instrSize : ValList -> Nat .

  op instrSize : NeValList -> NzNat .

  op instrSizeAux : ValList Nat -> Nat .

  op valRepeat : Nat val -> ValList .

  op instrRepeat : Nat instr -> InstrList .

  var SEQUENCE-REST : SpectecTerminals .

  var TYPECHECK-TYPE : SpectecType .

  var SEQUENCE-ELEMENT : SpectecTerminal .

  var TYPECHECK-VALUE : [SpectecTerminal] .

  vars LIST-LEFT LIST-REST : ValList .

  vars LIST-ELEMENT LIST-OTHER REPEAT-ELEMENT : val .

  vars LIST-COUNT REPEAT-COUNT : Nat .

  var REPEAT-ELEMENT2 : instr .

  eq unseq(seq(SEQUENCE-REST)) = SEQUENCE-REST .

  eq typecheck(eps, TYPECHECK-TYPE) = true .

  ceq typecheck(SEQUENCE-ELEMENT SEQUENCE-REST, TYPECHECK-TYPE) = typecheck(SEQUENCE-REST, TYPECHECK-TYPE)
    if SEQUENCE-REST =/= eps
      /\ typecheck(SEQUENCE-ELEMENT, TYPECHECK-TYPE) .

  eq typecheck(TYPECHECK-VALUE, TYPECHECK-TYPE) = false [owise] .

  eq instrAppend(LIST-LEFT, LIST-REST) = LIST-LEFT LIST-REST .

  eq instrHead(LIST-ELEMENT LIST-REST) = LIST-ELEMENT .

  eq instrTail(LIST-ELEMENT LIST-REST) = LIST-REST .

  eq instrLast(LIST-LEFT LIST-ELEMENT) = LIST-ELEMENT .

  eq instrFront(LIST-LEFT LIST-ELEMENT) = LIST-LEFT .

  eq instrOccurs(LIST-ELEMENT, eps) = false .

  eq instrOccurs(LIST-ELEMENT, LIST-OTHER LIST-REST) = if (LIST-ELEMENT == LIST-OTHER) then true else instrOccurs(LIST-ELEMENT, LIST-REST) fi .

  eq instrReverse(LIST-REST) = instrReverseAux(LIST-REST, eps) .

  eq instrReverseAux(eps, LIST-LEFT) = LIST-LEFT .

  eq instrReverseAux(LIST-ELEMENT LIST-REST, LIST-LEFT) = instrReverseAux(LIST-REST, LIST-ELEMENT LIST-LEFT) .

  eq instrSize(LIST-REST) = instrSizeAux(LIST-REST, 0) .

  eq instrSizeAux(eps, LIST-COUNT) = LIST-COUNT .

  eq instrSizeAux(LIST-ELEMENT LIST-REST, LIST-COUNT) = instrSizeAux(LIST-REST, LIST-COUNT + 1) .

  eq valRepeat(0, REPEAT-ELEMENT) = eps .

  eq valRepeat(s(REPEAT-COUNT), REPEAT-ELEMENT) = REPEAT-ELEMENT valRepeat(REPEAT-COUNT, REPEAT-ELEMENT) .

  eq instrRepeat(0, REPEAT-ELEMENT2) = eps .

  eq instrRepeat(s(REPEAT-COUNT), REPEAT-ELEMENT2) = REPEAT-ELEMENT2 instrRepeat(REPEAT-COUNT, REPEAT-ELEMENT2) .
endfm

