      /\ typecheck(VALUE-6, globaltype)
      /\ typecheck(VALUE-7, memtype)
      /\ typecheck(VALUE-8, tabletype)
      /\ typecheck(VALUE-9, deftype)
      /\ typecheck(VALUE-10, datatype)
      /\ typecheck(VALUE-11, reftype)
      /\ typecheck(VALUE-12, localtype)
      /\ typecheck(VALUE-13, list(valtype))
      /\ typecheck(VALUE-16, list(valtype))
      /\ len(VALUE-16) <= 1
      /\ typecheck(VALUE-17, uN(32))
      /\ typecheck(VALUE-18, subtype) .

  eq recordConcat(LEFT, RIGHT, context) = { ((((((((((((field('TYPES, (LEFT . 'TYPES) (RIGHT . 'TYPES)) ; field('TAGS, (LEFT . 'TAGS) (RIGHT . 'TAGS))) ; field('GLOBALS, (LEFT . 'GLOBALS) (RIGHT . 'GLOBALS))) ; field('MEMS, (LEFT . 'MEMS) (RIGHT . 'MEMS))) ; field('TABLES, (LEFT . 'TABLES) (RIGHT . 'TABLES))) ; field('FUNCS, (LEFT . 'FUNCS) (RIGHT . 'FUNCS))) ; field('DATAS, (LEFT . 'DATAS) (RIGHT . 'DATAS))) ; field('ELEMS, (LEFT . 'ELEMS) (RIGHT . 'ELEMS))) ; field('LOCALS, (LEFT . 'LOCALS) (RIGHT . 'LOCALS))) ; field('LABELS, (LEFT . 'LABELS) (RIGHT . 'LABELS))) ; field('RETURN, optionConcat(LEFT . 'RETURN, RIGHT . 'RETURN))) ; field('REFS, (LEFT . 'REFS) (RIGHT . 'REFS))) ; field('RECS, (LEFT . 'RECS) (RIGHT . 'RECS))) } .

  eq with-locals(C, eps, eps) = C .

  eq with-locals(C, (# X_1-2) X*-2, LCT_1 LCT*) = with-locals(C [. 'LOCALS = ((C . 'LOCALS) [ X_1-2 = LCT_1 ]) ], X*-2, LCT*) .

  eq clos-deftypes(eps) = eps .

  ceq clos-deftypes(DT* DT_N) = DT'* subst-all-deftype(DT_N, DT'*)
    if DT'* := clos-deftypes(DT*) .

  ceq clos-valtype(C, T) = subst-all-valtype(T, DT*)
    if DT* := clos-deftypes(C . 'TYPES) .

  ceq clos-deftype(C, DT) = subst-all-deftype(DT, DT'*)
    if DT'* := clos-deftypes(C . 'TYPES) .

  ceq clos-tagtype(C, JT) = subst-all-tagtype(JT, DT*)
    if DT* := clos-deftypes(C . 'TYPES) .

  ceq clos-externtype(C, XT-2) = subst-all-externtype(XT-2, DT*)
    if DT* := clos-deftypes(C . 'TYPES) .

  ceq clos-moduletype(C, MMT) = subst-all-moduletype(MMT, DT*)
    if DT* := clos-deftypes(C . 'TYPES) .

  eq typecheck(spectec-OK(VALUE1-3), oktypenat) = true .

  ceq Expand(DEFTYPE) = COMPTYPE
    if SUB(FINAL?, TYPEUSE*, COMPTYPE) := unrolldt(DEFTYPE)
      /\ len(FINAL?) <= 1 .

  eq before(REC(J), I) = # (J < I) .

  eq before(TYPEUSE, I) = # true [owise] .

  ceq unrollht-(C, DEFTYPE) = unrolldt(DEFTYPE)
    if typecheck(DEFTYPE, deftype) .

  eq unrollht-(C, -IDX(TYPEIDX)) = unrolldt((C . 'TYPES) [ TYPEIDX ]) .

  eq unrollht-(C, REC(I)) = (C . 'RECS) [ I ] .

  ceq Deftype-sub(C, DEFTYPE_1, DEFTYPE_2) = true
    if clos-deftype(C, DEFTYPE_1) == clos-deftype(C, DEFTYPE_2) .

  ceq Deftype-sub(C, DEFTYPE_1, DEFTYPE_2) = true
    if SUB(FINAL?, TYPEUSE*, CT) := unrolldt(DEFTYPE_1)
      /\ len(FINAL?) <= 1
      /\ INDEX-PREFIX (INDEX-ELEMENT INDEX-SUFFIX) := TYPEUSE*
      /\ I := len(INDEX-PREFIX)
      /\ Heaptype-sub(C, TYPEUSE* [ I ], DEFTYPE_2) .

  ceq Heaptype-sub(REL-ARG1, REL-ARG2, REL-ARG3) = true
    if Heaptype-sub-step(REL-ARG1, REL-ARG2, REL-ARG3) .

  eq Heaptype-sub-step(C, HEAPTYPE, HEAPTYPE) = true .

  ceq Heaptype-sub(C, HEAPTYPE_1, HEAPTYPE_2) = true
    if WITNESSES (HEAPTYPE' WITNESSES-2) := ANY (EQ (I31 (STRUCT (ARRAY (spectec-FUNC (EXN EXTERN))))))
      /\ typecheck(HEAPTYPE', heaptype)
      /\ HEAPTYPE' =/= HEAPTYPE_1
      /\ HEAPTYPE' =/= HEAPTYPE_2
      /\ Heaptype-sub-step(C, HEAPTYPE_1, HEAPTYPE')
      /\ Heaptype-sub(C, HEAPTYPE', HEAPTYPE_2) .

  eq Heaptype-sub-step(C, EQ, ANY) = true .

  eq Heaptype-sub-step(C, I31, EQ) = true .

  eq Heaptype-sub-step(C, STRUCT, EQ) = true .

  eq Heaptype-sub-step(C, ARRAY, EQ) = true .

  ceq Heaptype-sub-step(C, DEFTYPE, STRUCT) = true
    if typecheck(DEFTYPE, deftype)
      /\ spectec-STRUCT(FIELDTYPE*) := Expand(DEFTYPE) .

  ceq Heaptype-sub-step(C, DEFTYPE, ARRAY) = true
    if typecheck(DEFTYPE, deftype)
      /\ spectec-ARRAY(FIELDTYPE) := Expand(DEFTYPE) .

  ceq Heaptype-sub-step(C, DEFTYPE, spectec-FUNC) = true
    if typecheck(DEFTYPE, deftype)
      /\ FUNC T_1* -> T_2* := Expand(DEFTYPE) .

  ceq Heaptype-sub-step(C, DEFTYPE_1, DEFTYPE_2) = true
    if typecheck(DEFTYPE_1, deftype)
      /\ typecheck(DEFTYPE_2, deftype)
      /\ Deftype-sub(C, DEFTYPE_1, DEFTYPE_2) .

  ceq Heaptype-sub-step(C, -IDX(TYPEIDX), HEAPTYPE) = true
    if Heaptype-sub(C, (C . 'TYPES) [ TYPEIDX ], HEAPTYPE) .

  ceq Heaptype-sub-step(C, HEAPTYPE, -IDX(TYPEIDX)) = true
    if Heaptype-sub(C, HEAPTYPE, (C . 'TYPES) [ TYPEIDX ]) .

  ceq Heaptype-sub-step(C, REC(I), STRUCT) = true
    if SUB(FINAL?, eps, spectec-STRUCT(FIELDTYPE*)) := (C . 'RECS) [ I ]
      /\ len(FINAL?) <= 1 .

  ceq Heaptype-sub-step(C, REC(I), ARRAY) = true
    if SUB(FINAL?, eps, spectec-ARRAY(FIELDTYPE)) := (C . 'RECS) [ I ]
      /\ len(FINAL?) <= 1 .

  ceq Heaptype-sub-step(C, REC(I), spectec-FUNC) = true
    if SUB(FINAL?, eps, FUNC T_1* -> T_2*) := (C . 'RECS) [ I ]
      /\ len(FINAL?) <= 1 .

  ceq Heaptype-sub-step(C, REC(I), REL-INPUT3) = true
    if SUB(FINAL?, TYPEUSE*, CT) := (C . 'RECS) [ I ]
      /\ len(FINAL?) <= 1
      /\ INDEX-PREFIX (INDEX-ELEMENT INDEX-SUFFIX) := TYPEUSE*
      /\ J := len(INDEX-PREFIX)
      /\ TYPEUSE* [ J ] = REL-INPUT3 .

  ceq Heaptype-sub-step(C, NONE, HEAPTYPE) = true
    if Heaptype-sub(C, HEAPTYPE, ANY)
      /\ HEAPTYPE =/= BOT .

  ceq Heaptype-sub-step(C, NOFUNC, HEAPTYPE) = true
    if Heaptype-sub(C, HEAPTYPE, spectec-FUNC)
      /\ HEAPTYPE =/= BOT .

  ceq Heaptype-sub-step(C, NOEXN, HEAPTYPE) = true
    if Heaptype-sub(C, HEAPTYPE, EXN)
      /\ HEAPTYPE =/= BOT .

  ceq Heaptype-sub-step(C, NOEXTERN, HEAPTYPE) = true
    if Heaptype-sub(C, HEAPTYPE, EXTERN)
      /\ HEAPTYPE =/= BOT .

  eq Heaptype-sub-step(C, BOT, HEAPTYPE) = true .

  ceq Reftype-sub(C, REF(eps, HT_1), REF(eps, HT_2)) = true
    if Heaptype-sub(C, HT_1, HT_2) .

  ceq Reftype-sub(C, REL-INPUT2, REF(NULL ?, HT_2)) = true
    if REF(CASE-PART1, CASE-PART2) := REL-INPUT2
      /\ HT_1 := CASE-PART2
      /\ _or_(CASE-PART1 == eps, CASE-PART1 == (NULL ?))
      /\ Heaptype-sub(C, HT_1, HT_2) .

  ceq typecheck(spectec-OK(TYPEIDX), oktypeidx) = true
    if typecheck(# TYPEIDX, typeidx) .

  ceq default-(INN) = CONST(INN, # 0) ?
    if typecheck(INN, addrtype) .

  ceq default-(FNN) = CONST(FNN, fzero(size(FNN))) ?
    if typecheck(FNN, Fnn) .

  ceq default-(VNN) = VCONST(VNN, 0) ?
    if typecheck(VNN, vectype) .

  eq default-(REF(NULL ?, HT)) = (REF.NULL-ADDR) ? .

  eq default-(REF(eps, HT)) = eps .

  eq is-packtype(ZT) = # (ZT =/= unpack(ZT)) .

  ceq typecheck(tuple(seq(GLOBAL*) (seq(MEM*) (seq(TABLE*) (seq(ELEM*) (seq(START?) seq(EXPORT*)))))), nonfuncs) = true
    if typecheck(GLOBAL*, global)
      /\ typecheck(MEM*, mem)
      /\ typecheck(TABLE*, table)
      /\ typecheck(ELEM*, elem)
      /\ typecheck(START?, start)
      /\ len(START?) <= 1
      /\ typecheck(EXPORT*, export) .

  ceq funcidx-nonfuncs(tuple(seq(GLOBAL*) (seq(MEM*) (seq(TABLE*) (seq(ELEM*) (seq(START?) seq(EXPORT*))))))) = funcidx-module(MODULE(eps, eps, eps, GLOBAL*, MEM*, TABLE*, eps, eps, ELEM*, START?, EXPORT*))
    if len(START?) <= 1 .

  ceq typecheck(# I, relaxed2) = true
