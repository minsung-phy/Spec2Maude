  ceq iterpr-36(M2, Z, X4, I, AO, s(ITER-COUNT), K3, J JS) = iterpr-36(M2, Z, X4, I, AO, ITER-COUNT, s(K3), JS)
    if ibytes-(M2, J) == ((spectec-mem(Z, X4) . 'BYTES) [ ((I + (AO . 'OFFSET)) + (rat(ratValue((K3 * M2) : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat)) : (rat(ratValue(M2 : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat) ]) .
  
  eq iterpr-36-output-1(M2, Z, X4, I, AO, 0, K3) = eps .
  
  ceq iterpr-36-output-1(M2, Z, X4, I, AO, s(ITER-COUNT), K3) = J iterpr-36-output-1(M2, Z, X4, I, AO, ITER-COUNT, s(K3))
    if J := inv-ibytes-(M2, (spectec-mem(Z, X4) . 'BYTES) [ ((I + (AO . 'OFFSET)) + (rat(ratValue((K3 * M2) : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat)) : (rat(ratValue(M2 : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat) ])
      /\ ibytes-(M2, J) == ((spectec-mem(Z, X4) . 'BYTES) [ ((I + (AO . 'OFFSET)) + (rat(ratValue((K3 * M2) : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat)) : (rat(ratValue(M2 : nat <:> rat) / ratValue(8 : nat <:> rat)) : rat <:> nat) ]) .
  
  eq iterpr-37(eps, eps) = true .
  
  ceq iterpr-37(VAL VALS, ZT ZTS) = iterpr-37(VALS, ZTS)
    if default-(unpack(ZT)) == (VAL ?) .
  
  eq iterpr-37-output-1(eps) = eps .
  
  ceq iterpr-37-output-1(ZT ZTS) = VAL iterpr-37-output-1(ZTS)
    if VAL ? := default-(unpack(ZT)) .
  
  eq iterpr-38(S2, eps, eps) = true .
  
  ceq iterpr-38(S2, EXTERNADDR EXTERNADDRS, XT-I2 XT_IS) = iterpr-38(S2, EXTERNADDRS, XT_IS)
    if Externaddr-ok(S2, EXTERNADDR, XT-I2) .
  
  eq iterpr-39(S2, eps, eps) = true .
  
  ceq iterpr-39(S2, T-12 T_1S, VAL VALS) = iterpr-39(S2, T_1S, VALS)
    if Val-ok(S2, VAL, T-12) .
endm
