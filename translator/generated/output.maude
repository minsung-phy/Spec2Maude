  eq spectec-binop-(FNN, spectec-DIV, F_1, F_2) = fdiv-(sizenn(FNN), F_1, F_2) .

  eq spectec-binop-(FNN, MIN, F_1, F_2) = fmin-(sizenn(FNN), F_1, F_2) .

  eq spectec-binop-(FNN, MAX, F_1, F_2) = fmax-(sizenn(FNN), F_1, F_2) .

  eq spectec-binop-(FNN, COPYSIGN, F_1, F_2) = fcopysign-(sizenn(FNN), F_1, F_2) .

