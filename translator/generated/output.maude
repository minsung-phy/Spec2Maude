  eq iabs-(N-2, I_1) = ineg-(N-2, I_1) [owise] .

  eq iextend-(N-2, M-2, U, I) = _rem_(I, 2 ^ M-2) .

  eq iextend-(N-2, M-2, S, I) = inv-signed-(N-2, signed-(M-2, _rem_(I, 2 ^ M-2))) .

  eq iadd-(N-2, I_1, I_2) = _rem_(I_1 + I_2, 2 ^ N-2) .

  eq isub-(N-2, I_1, I_2) = _rem_(_-_(((2 ^ N-2) + I_1) : nat <:> int, I_2 : nat <:> int), (2 ^ N-2) : nat <:> int) : int <:> nat .

  eq imul-(N-2, I_1, I_2) = _rem_(I_1 * I_2, 2 ^ N-2) .

  eq idiv-(N-2, U, I_1, 0) = eps .

  eq idiv-(N-2, U, I_1, I_2) = (# (truncz(# ((I_1 : nat <:> rat) / (I_2 : nat <:> rat))) : int <:> nat)) ? .

  eq idiv-(N-2, S, I_1, 0) = eps .

  ceq idiv-(N-2, S, I_1, I_2) = eps
    if (# ((signed-(N-2, I_1) : int <:> rat) / (signed-(N-2, I_2) : int <:> rat))) == (# ((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> rat)) .

  eq idiv-(N-2, S, I_1, I_2) = (# inv-signed-(N-2, truncz(# ((signed-(N-2, I_1) : int <:> rat) / (signed-(N-2, I_2) : int <:> rat))))) ? .

  eq irem-(N-2, U, I_1, 0) = eps .

  eq irem-(N-2, U, I_1, I_2) = (# (_-_(I_1 : nat <:> int, (I_2 * (truncz(# ((I_1 : nat <:> rat) / (I_2 : nat <:> rat))) : int <:> nat)) : nat <:> int) : int <:> nat)) ? .

  eq irem-(N-2, S, I_1, 0) = eps .

  ceq irem-(N-2, S, I_1, I_2) = (# inv-signed-(N-2, _-_(J_1, J_2 * truncz(# ((J_1 : int <:> rat) / (J_2 : int <:> rat)))))) ?
    if J_1 := signed-(N-2, I_1)
      /\ J_2 := signed-(N-2, I_2) .

  ceq imin-(N-2, U, I_1, I_2) = I_1
    if I_1 <= I_2 .

  ceq imin-(N-2, U, I_1, I_2) = I_2
    if I_1 > I_2 .

  ceq imin-(N-2, S, I_1, I_2) = I_1
    if signed-(N-2, I_1) <= signed-(N-2, I_2) .

  eq imin-(N-2, S, I_1, I_2) = I_2 [owise] .

  ceq imax-(N-2, U, I_1, I_2) = I_1
    if I_1 >= I_2 .

  ceq imax-(N-2, U, I_1, I_2) = I_2
    if I_1 < I_2 .

  ceq imax-(N-2, S, I_1, I_2) = I_1
    if signed-(N-2, I_1) >= signed-(N-2, I_2) .

  eq imax-(N-2, S, I_1, I_2) = I_2 [owise] .

  eq iadd-sat-(N-2, U, I_1, I_2) = sat-u-(N-2, (I_1 + I_2) : nat <:> int) .

  eq iadd-sat-(N-2, S, I_1, I_2) = inv-signed-(N-2, sat-s-(N-2, signed-(N-2, I_1) + signed-(N-2, I_2))) .

  eq isub-sat-(N-2, U, I_1, I_2) = sat-u-(N-2, _-_(I_1 : nat <:> int, I_2 : nat <:> int)) .

  eq isub-sat-(N-2, S, I_1, I_2) = inv-signed-(N-2, sat-s-(N-2, _-_(signed-(N-2, I_1), signed-(N-2, I_2)))) .

  eq ieqz-(N-2, I_1) = spectec-bool(# (I_1 == 0)) .

  eq inez-(N-2, I_1) = spectec-bool(# (I_1 =/= 0)) .

  eq ieq-(N-2, I_1, I_2) = spectec-bool(# (I_1 == I_2)) .

  eq ine-(N-2, I_1, I_2) = spectec-bool(# (I_1 =/= I_2)) .

  eq ilt-(N-2, U, I_1, I_2) = spectec-bool(# (I_1 < I_2)) .

  eq ilt-(N-2, S, I_1, I_2) = spectec-bool(# (signed-(N-2, I_1) < signed-(N-2, I_2))) .

  eq igt-(N-2, U, I_1, I_2) = spectec-bool(# (I_1 > I_2)) .

  eq igt-(N-2, S, I_1, I_2) = spectec-bool(# (signed-(N-2, I_1) > signed-(N-2, I_2))) .

  eq ile-(N-2, U, I_1, I_2) = spectec-bool(# (I_1 <= I_2)) .

  eq ile-(N-2, S, I_1, I_2) = spectec-bool(# (signed-(N-2, I_1) <= signed-(N-2, I_2))) .

  eq ige-(N-2, U, I_1, I_2) = spectec-bool(# (I_1 >= I_2)) .

  eq ige-(N-2, S, I_1, I_2) = spectec-bool(# (signed-(N-2, I_1) >= signed-(N-2, I_2))) .

  ceq lpacknum-(NUMTYPE, C-2) = C-2
    if typecheck(NUMTYPE, numtype) .

  ceq lpacknum-(PACKTYPE, # C-3) = # wrap--(size(lunpack(PACKTYPE)), psize(PACKTYPE), C-3)
    if typecheck(PACKTYPE, packtype) .

  ceq cpacknum-(CONSTTYPE, C-2) = C-2
    if typecheck(CONSTTYPE, consttype) .

  ceq cpacknum-(PACKTYPE, # C-3) = # wrap--(size(lunpack(PACKTYPE)), psize(PACKTYPE), C-3)
    if typecheck(PACKTYPE, packtype) .

  ceq lunpacknum-(NUMTYPE, C-2) = C-2
    if typecheck(NUMTYPE, numtype) .

  ceq lunpacknum-(PACKTYPE, # C-3) = # extend--(psize(PACKTYPE), size(lunpack(PACKTYPE)), U, C-3)
    if typecheck(PACKTYPE, packtype) .

  ceq cunpacknum-(CONSTTYPE, C-2) = C-2
    if typecheck(CONSTTYPE, consttype) .

  ceq cunpacknum-(PACKTYPE, # C-3) = # extend--(psize(PACKTYPE), size(lunpack(PACKTYPE)), U, C-3)
    if typecheck(PACKTYPE, packtype) .

  eq spectec-unop-(INN, CLZ, # I) = # iclz-(sizenn(INN), I) .

  eq spectec-unop-(INN, CTZ, # I) = # ictz-(sizenn(INN), I) .

  eq spectec-unop-(INN, POPCNT, # I) = # ipopcnt-(sizenn(INN), I) .

  eq spectec-unop-(INN, EXTEND(M-2), # I) = # iextend-(sizenn(INN), M-2, S, I) .

  eq spectec-unop-(FNN, ABS, F) = fabs-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, spectec-NEG, F) = fneg-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, SQRT, F) = fsqrt-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, CEIL, F) = fceil-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, FLOOR, F) = ffloor-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, TRUNC, F) = ftrunc-(sizenn(FNN), F) .

  eq spectec-unop-(FNN, NEAREST, F) = fnearest-(sizenn(FNN), F) .

  eq spectec-binop-(INN, ADD, # I_1, # I_2) = # iadd-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, spectec-SUB, # I_1, # I_2) = # isub-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, MUL, # I_1, # I_2) = # imul-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, DIV(SX), # I_1, # I_2) = lift(idiv-(sizenn(INN), SX, I_1, I_2)) .

  eq spectec-binop-(INN, REM(SX), # I_1, # I_2) = lift(irem-(sizenn(INN), SX, I_1, I_2)) .

  eq spectec-binop-(INN, AND, # I_1, # I_2) = # iand-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, OR, # I_1, # I_2) = # ior-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, XOR, # I_1, # I_2) = # ixor-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, SHL, # I_1, # I_2) = # ishl-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, SHR(SX), # I_1, # I_2) = # ishr-(sizenn(INN), SX, I_1, I_2) .

  eq spectec-binop-(INN, ROTL, # I_1, # I_2) = # irotl-(sizenn(INN), I_1, I_2) .

  eq spectec-binop-(INN, ROTR, # I_1, # I_2) = # irotr-(sizenn(INN), I_1, I_2) .

  ceq spectec-binop-(FNN, ADD, F_1, F_2) = fadd-(sizenn(FNN), F_1, F_2)
    if typecheck(FNN, Fnn) .

  ceq spectec-binop-(FNN, spectec-SUB, F_1, F_2) = fsub-(sizenn(FNN), F_1, F_2)
