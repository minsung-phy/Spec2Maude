  ceq typecheck({ ((((((((((((field('TYPES, VALUE-4) ; field('TAGS, VALUE-5)) ; field('GLOBALS, VALUE-6)) ; field('MEMS, VALUE-7)) ; field('TABLES, VALUE-8)) ; field('FUNCS, VALUE-9)) ; field('DATAS, VALUE-10)) ; field('ELEMS, VALUE-11)) ; field('LOCALS, VALUE-12)) ; field('LABELS, VALUE-13)) ; field('RETURN, VALUE-16)) ; field('REFS, VALUE-17)) ; field('RECS, VALUE-18)) }, context) = true
    if typecheck(VALUE-4, deftype)
