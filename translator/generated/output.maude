      /\ typecheck(VALUE32, list(tag))
      /\ typecheck(VALUE4, list(global))
      /\ typecheck(VALUE5, list(mem))
      /\ typecheck(VALUE6, list(table))
      /\ typecheck(VALUE7, list(func))
      /\ typecheck(VALUE8, list(data))
