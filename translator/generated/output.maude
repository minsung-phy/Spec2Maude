  ceq spectec-relaxed2(I, X, X_1, X_2) = (X_1 X_2) [ I ]
    if #bool(nd) .

  eq spectec-relaxed2(I, X, X_1, X_2) = (X_1 X_2) [ 0 ] [owise] .

  ceq spectec-relaxed4(I, X, X_1, X_2, X_3, X_4) = (X_1 (X_2 (X_3 X_4))) [ I ]
    if #bool(nd) .

  eq spectec-relaxed4(I, X, X_1, X_2, X_3, X_4) = (X_1 (X_2 (X_3 X_4))) [ 0 ] [owise] .

  ceq signed-(N-2, I) = I : nat <:> int
    if I < (2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) .

  ceq signed-(N-2, I) = _-_(I : nat <:> int, (2 ^ N-2) : nat <:> int)
    if _and_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) <= I, I < (2 ^ N-2)) .

  ceq inv-signed-(N-2, I-2) = I-2 : int <:> nat
    if _and_((0 : nat <:> int) <= I-2, I-2 < ((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int)) .

  ceq inv-signed-(N-2, I-2) = (I-2 + ((2 ^ N-2) : nat <:> int)) : int <:> nat
    if _and_(-_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int) <= I-2, I-2 < (0 : nat <:> int)) .

  ceq spectec-sx(CONSTTYPE) = eps
    if typecheck(CONSTTYPE, consttype) .

  ceq spectec-sx(PACKTYPE) = S ?
    if typecheck(PACKTYPE, packtype) .

  ceq spectec-zero(JNN) = # 0
    if typecheck(JNN, Jnn) .

  ceq spectec-zero(FNN) = fzero(size(FNN))
    if typecheck(FNN, Fnn) .

  eq spectec-bool(# false) = 0 .

  eq spectec-bool(# true) = 1 .

  ceq sat-u-(N-2, I-2) = 0
    if I-2 < (0 : nat <:> int) .

  ceq sat-u-(N-2, I-2) = _-_((2 ^ N-2) : nat <:> int, 1 : nat <:> int) : int <:> nat
    if I-2 > _-_((2 ^ N-2) : nat <:> int, 1 : nat <:> int) .

  eq sat-u-(N-2, I-2) = I-2 : int <:> nat [owise] .

  ceq sat-s-(N-2, I-2) = -_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int)
    if I-2 < -_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int) .

  ceq sat-s-(N-2, I-2) = _-_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int, 1 : nat <:> int)
    if I-2 > _-_((2 ^ (_-_(N-2 : nat <:> int, 1 : nat <:> int) : int <:> nat)) : nat <:> int, 1 : nat <:> int) .

  eq sat-s-(N-2, I-2) = I-2 [owise] .

  eq ineg-(N-2, I_1) = _rem_(_-_((2 ^ N-2) : nat <:> int, I_1 : nat <:> int), (2 ^ N-2) : nat <:> int) : int <:> nat .

  ceq iabs-(N-2, I_1) = I_1
