  ceq all-Step-pure-vbitmask(JNN, (# CI_1-2) CI_1*-REST) = all-Step-pure-vbitmask(JNN, CI_1*-REST)
    if _and_(true, 0 <= (_-_((2 ^ lsize(JNN)) : nat <:> int, 1) : int <:> nat)) .

  eq all-Step-pure-vbitmask-2(JNN, nil) = true .

  ceq all-Step-pure-vbitmask-2(JNN, (# CI_1-2) CI_1*-REST) = all-Step-pure-vbitmask-2(JNN, CI_1*-REST)
    if _or_(ilt-(lsize(JNN), S, CI_1-2, 0) == 0, ilt-(lsize(JNN), S, CI_1-2, 0) == 1) .

  eq all-Step-pure-vswizzle(PNN, 0) = true .

  ceq all-Step-pure-vswizzle(PNN, s(ITER-COUNT)) = all-Step-pure-vswizzle(PNN, ITER-COUNT)
    if _and_(true, 0 <= (_-_((2 ^ psize(PNN)) : nat <:> int, 1) : int <:> nat)) .

  eq bind-Step-read-vload-shape-val(M-2, Z, I, AO, 0, K) = nil .

  ceq bind-Step-read-vload-shape-val(M-2, Z, I, AO, s(ITER-COUNT), K) = (# J) bind-Step-read-vload-shape-val(M-2, Z, I, AO, ITER-COUNT, s(K))
    if J := inv-ibytes-(M-2, array-read(spectec-mem(Z, 0) . 'BYTES, (I + #rat(AO . 'OFFSET)) + ((((K * M-2) : nat <:> rat) / 8) : rat <:> nat), ((M-2 : nat <:> rat) / 8) : rat <:> nat))
      /\ ibytes-(M-2, J) == array-read(spectec-mem(Z, 0) . 'BYTES, (I + #rat(AO . 'OFFSET)) + ((((K * M-2) : nat <:> rat) / 8) : rat <:> nat), ((M-2 : nat <:> rat) / 8) : rat <:> nat) .

  eq all-Step-read-vload-splat-val(N-2, J, JNN, 0) = true .

  ceq all-Step-read-vload-splat-val(N-2, J, JNN, s(ITER-COUNT)) = all-Step-read-vload-splat-val(N-2, J, JNN, ITER-COUNT)
    if _and_(J >= 0, J <= (_-_((2 ^ lsize(JNN)) : nat <:> int, 1) : int <:> nat)) .

  eq bind-Step-read-memory-fill-succ(nil) = nil .

  ceq bind-Step-read-memory-fill-succ((# SZ-33-2) ?) = INN-1-2 ?
    if INN-1-2 := I32
      /\ typecheck(INN-1-2, Inn)
      /\ SZ-33-2 < sizenn(INN-1-2) .

  rl bind-instantiate(Z, nil) => nil .

  crl bind-instantiate(Z, seq(EXPR_G-2) EXPR_G*-REST) => VAL REST
    if Eval-expr(Z, EXPR_G-2) => tuple(Z seq(VAL))
      /\ bind-instantiate(Z, EXPR_G*-REST) => REST .

  rl bind-instantiate-2(Z, nil) => nil .

  crl bind-instantiate-2(Z, seq(EXPR_E*) EXPR_E**-REST) => seq(REF*) REST-2
    if bind-instantiate-3(Z, EXPR_E*) => REF*
      /\ bind-instantiate-2(Z, EXPR_E**-REST) => REST-2 .

  rl bind-instantiate-3(Z, nil) => nil .

  crl bind-instantiate-3(Z, seq(EXPR_E-2) EXPR_E*-REST) => REF REST-2
    if Eval-expr(Z, EXPR_E-2) => tuple(Z seq(REF))
      /\ typecheck(REF, ref)
      /\ bind-instantiate-3(Z, EXPR_E*-REST) => REST-2 .

  eq all-instantiate(0, I) = true .

  ceq all-instantiate(s(ITER-COUNT), I) = all-instantiate(ITER-COUNT, s(I))
    if _and_(I >= 0, I <= 4294967295) .
endm
