    if identifyFocus(Z ; ADMININSTR*) => { VAL* | (Z ; ADMININSTR*-1) | ADMININSTR_1* } .

  eq [step-ctxt-label-cool] : (Z' ; ADMININSTR'*) ~> hole-Step-ctxt-label(INSTR_0*, N-3) = Z' ; (LABEL- N-3 { INSTR_0* } ADMININSTR'*) .

  crl [step-ctxt-frame-heat] : Step((S-2 ; F) ; (FRAME- N-3 { F' } ADMININSTR*)) => Step((S-2 ; F') ; ADMININSTR*) ~> hole-Step-ctxt-frame(N-3, F)
    if identifyFocus((S-2 ; F') ; ADMININSTR*) => { VAL* | ((S-2 ; F') ; ADMININSTR*-1) | ADMININSTR_1* } .

