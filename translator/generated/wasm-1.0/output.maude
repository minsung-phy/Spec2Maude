  ceq irem-(N-2, U, I_1, I_2) = (# (_-_(I_1 : nat <:> int, (I_2 * (truncz(# ((I_1 : nat <:> rat) / (I_2 : nat <:> rat))) : int <:> nat)) : nat <:> int) : int <:> nat)) ?
