  eq with-table(S-2 ; F, X-4, I, A) = (S-2 [. 'TABLES = ((S-2 . 'TABLES) [ #rat(((F . 'MODULE) . 'TABLES) [ X-4 ]) = (((S-2 . 'TABLES) [ #rat(((F . 'MODULE) . 'TABLES) [ X-4 ]) ]) [. 'REFS = map-write(((S-2 . 'TABLES) [ #rat(((F . 'MODULE) . 'TABLES) [ X-4 ]) ]) . 'REFS, I, seq((# A) ?)) ]) ]) ]) ; F .

