    if PROJECT-COLUMN-1 := unzip-TYPE(PROJECT-REST) .

  eq unzip-allocmodule(0, nil) = tuple(seq(nil) seq(nil)) .

  ceq unzip-allocmodule(s(ITER-COUNT), spectec-GLOBAL(GLOBALTYPE, EXPR_1-2) PROJECT-REST) = tuple(seq(seq(EXPR_1-2) PROJECT-COLUMN-1) seq(GLOBALTYPE PROJECT-COLUMN-2))
    if tuple(seq(PROJECT-COLUMN-1) seq(PROJECT-COLUMN-2)) := unzip-allocmodule(ITER-COUNT, PROJECT-REST) .

  eq unzip-TABLE(0, nil) = nil .

  ceq unzip-TABLE(s(ITER-COUNT), TABLE(TABLETYPE) PROJECT-REST) = TABLETYPE PROJECT-COLUMN-1
    if PROJECT-COLUMN-1 := unzip-TABLE(ITER-COUNT, PROJECT-REST) .

  eq unzip-MEMORY(0, nil) = nil .

  ceq unzip-MEMORY(s(ITER-COUNT), MEMORY(MEMTYPE) PROJECT-REST) = MEMTYPE PROJECT-COLUMN-1
    if PROJECT-COLUMN-1 := unzip-MEMORY(ITER-COUNT, PROJECT-REST) .

  eq map-allocmodule(S-2, 0, I_FUNC) = nil .

  eq map-allocmodule(S-2, s(ITER-COUNT), I_FUNC) = (# (map-size(S-2 . 'FUNCS) + I_FUNC)) map-allocmodule(S-2, ITER-COUNT, s(I_FUNC)) .

  eq map-allocmodule-2(S-2, 0, I_GLOBAL) = nil .

  eq map-allocmodule-2(S-2, s(ITER-COUNT), I_GLOBAL) = (# (size(S-2 . 'GLOBALS) + I_GLOBAL)) map-allocmodule-2(S-2, ITER-COUNT, s(I_GLOBAL)) .

  eq map-allocmodule-3(S-2, 0, I_TABLE) = nil .

  eq map-allocmodule-3(S-2, s(ITER-COUNT), I_TABLE) = (# (size(S-2 . 'TABLES) + I_TABLE)) map-allocmodule-3(S-2, ITER-COUNT, s(I_TABLE)) .

  eq map-allocmodule-4(S-2, 0, I_MEM) = nil .

  eq map-allocmodule-4(S-2, s(ITER-COUNT), I_MEM) = (# (map-size(S-2 . 'MEMS) + I_MEM)) map-allocmodule-4(S-2, ITER-COUNT, s(I_MEM)) .

  eq map-instexport(FA_EX*, FA*, GA_EX*, GA*, TA_EX*, TA*, MA_EX*, MA*, nil) = nil .

  eq map-instexport(FA_EX*, FA*, GA_EX*, GA*, TA_EX*, TA*, MA_EX*, MA*, EXPORT-3 EXPORT*-REST) = instexport(FA_EX* FA*, GA_EX* GA*, TA_EX* TA*, MA_EX* MA*, EXPORT-3) map-instexport(FA_EX*, FA*, GA_EX*, GA*, TA_EX*, TA*, MA_EX*, MA*, EXPORT*-REST) .

  eq map-CALL(nil) = nil .

  eq map-CALL((# X'-2) ?) = CALL(X'-2) ? .

  eq unzip-instantiate(nil) = tuple(seq(nil) seq(nil)) .

  ceq unzip-instantiate(spectec-GLOBAL(GLOBALTYPE, EXPR_G-2) PROJECT-REST) = tuple(seq(seq(EXPR_G-2) PROJECT-COLUMN-1) seq(GLOBALTYPE PROJECT-COLUMN-2))
    if tuple(seq(PROJECT-COLUMN-1) seq(PROJECT-COLUMN-2)) := unzip-instantiate(PROJECT-REST) .

  eq unzip-ELEM(nil) = tuple(seq(nil) seq(nil)) .

  ceq unzip-ELEM(ELEM(EXPR_E-2, X*-2) PROJECT-REST) = tuple(seq(seq(EXPR_E-2) PROJECT-COLUMN-1) seq(seq(X*-2) PROJECT-COLUMN-2))
    if tuple(seq(PROJECT-COLUMN-1) seq(PROJECT-COLUMN-2)) := unzip-ELEM(PROJECT-REST) .

  eq unzip-DATA(nil) = tuple(seq(nil) seq(nil)) .

  ceq unzip-DATA(DATA(EXPR_D-2, B*) PROJECT-REST) = tuple(seq(seq(B*) PROJECT-COLUMN-1) seq(seq(EXPR_D-2) PROJECT-COLUMN-2))
    if tuple(seq(PROJECT-COLUMN-1) seq(PROJECT-COLUMN-2)) := unzip-DATA(PROJECT-REST) .

  eq unzip-START(nil) = nil .

  eq unzip-START(START(X'-2) ?) = (# X'-2) ? .

  eq map-instantiate(MODULEINST, nil) = nil .

  eq map-instantiate(MODULEINST, seq(X*-2) X**-REST) = seq(map-instantiate-2(MODULEINST, X*-2)) map-instantiate(MODULEINST, X**-REST) .

  eq map-instantiate-2(MODULEINST, nil) = nil .

  eq map-instantiate-2(MODULEINST, (# X-4) X*-REST) = (# #rat((MODULEINST . 'FUNCS) [ X-4 ])) map-instantiate-2(MODULEINST, X*-REST) .

  eq bind-exp(VALTYPE, nil) = nil .

  ceq bind-exp(VALTYPE, (# SZ) ?) = INN ?
    if INN := VALTYPE
      /\ typecheck(INN, Inn)
      /\ SZ < spectec-size(INN) .

  eq all-growtable(I', nil) = true .

  ceq all-growtable(I', (# J) ?) = true
    if I' <= J .

  eq all-growmemory(I'-2, nil) = true .

  ceq all-growmemory(I'-2, (# J-2-3) ?) = true
    if #rat(I'-2) <= (J-2-3 : nat <:> rat) .

  rl bind-instantiate(Z, nil) => nil .

  crl bind-instantiate(Z, seq(EXPR_G-2) EXPR_G*-REST) => VAL REST
    if Eval-expr(Z, EXPR_G-2) => tuple(Z seq(VAL))
      /\ bind-instantiate(Z, EXPR_G*-REST) => REST .

  rl bind-instantiate-2(Z, nil) => nil .

  crl bind-instantiate-2(Z, seq(EXPR_E-2) EXPR_E*-REST) => (# I_E-2) REST-2
    if Eval-expr(Z, EXPR_E-2) => tuple(Z seq(CONST(I32, # I_E-2)))
      /\ bind-instantiate-2(Z, EXPR_E*-REST) => REST-2 .
endm
