--- Spec2Maude builtin backend: implementations of the hint(builtin)
--- definitions. This module intentionally contains no fake default equations.
--- Implement a builtin here only after its WebAssembly semantics is fixed.
--- Contract: the source builtin signatures of spectec/REVISION plus
--- document/core/exec/numerics.rst. See docs/TRANSLATION.md.
--- Shared by Wasm 1.0, 2.0, and 3.0: every statement here uses only names
--- that the three generated semantics declare alike.

mod WASM-BUILTINS-CORE is
  inc SPEC2MAUDE-GENERATED .
  --- Implemented builtin family: integer bits, MSB first.
  vars BI_N BI_I : Nat .
  op ibits-aux : Nat Nat -> SpectecTerminals .
  eq ibits-aux(0, BI_I) = nil .
  ceq ibits-aux(BI_N, BI_I) =
      (# _rem_(_quo_(BI_I, _^_(2, _-_(BI_N, 1))), 2)) ibits-aux(_-_(BI_N, 1), BI_I)
    if _>_(BI_N, 0) .

  --- Implemented builtin family: integer bytes, little endian.
  vars BY_N BY_I BY_COUNT BY_ACC BY_SCALE BY_BYTE BY_RESULT : Nat .
  var BY_BYTES : SpectecTerminals .
  op ibytes-aux : Nat Nat -> SpectecTerminals .
  op inv-ibytes-aux : SpectecTerminals Nat Nat -> Nat .
  eq ibytes-aux(0, BY_I) = nil .
  ceq ibytes-aux(BY_COUNT, BY_I) =
      (# _rem_(BY_I, 256))
      ibytes-aux(_-_(BY_COUNT, 1), _quo_(BY_I, 256))
    if _>_(BY_COUNT, 0) .
  eq inv-ibytes-aux(nil, BY_SCALE, BY_ACC) = BY_ACC .
  ceq inv-ibytes-aux((# BY_BYTE) BY_BYTES, BY_SCALE, BY_ACC) =
      inv-ibytes-aux(BY_BYTES, _*_(BY_SCALE, 256), _+_(BY_ACC, _*_(BY_BYTE, BY_SCALE)))
    if typecheck(# BY_BYTE, byte) .

  --- Implemented builtin family: integer wrap--/extend-- conversions.
  vars BW_M BW_N BW_I : Nat .
  vars BE_M BE_N BE_I : Nat .
  op sign-extend-nat : Nat Nat Nat -> Nat .
  ceq sign-extend-nat(BE_M, BE_N, BE_I) = BE_I
    if _>_(BE_M, 0)
       /\ _<_(BE_M, BE_N)
       /\ _<_(BE_I, _^_(2, BE_M))
       /\ _<_(BE_I, _^_(2, _-_(BE_M, 1))) .
  ceq sign-extend-nat(BE_M, BE_N, BE_I) =
      _-_(_+_(BE_I, _^_(2, BE_N)), _^_(2, BE_M))
    if _>_(BE_M, 0)
       /\ _<_(BE_M, BE_N)
       /\ _<_(BE_I, _^_(2, BE_M))
       /\ _>=_(BE_I, _^_(2, _-_(BE_M, 1))) .

  --- Counting/reversing produces a result for every bit; it is not a lookup.
  vars BC_N BC_I BC_ACC : Nat .
  vars BC_BITS BC_PREFIX BC_SUFFIX : SpectecTerminals .
  op ipopcnt-bits : SpectecTerminals -> Nat .
  --- Like prelude LIST's size, keep the aggregate in an argument rather than
  --- leave one pending addition per bit on the evaluator stack.
  op ipopcnt-bits-aux : SpectecTerminals Nat -> Nat .
  eq ipopcnt-bits(BC_BITS) = ipopcnt-bits-aux(BC_BITS, 0) .
  eq ipopcnt-bits-aux(nil, BC_ACC) = BC_ACC .
  eq ipopcnt-bits-aux((# 0) BC_BITS, BC_ACC) = ipopcnt-bits-aux(BC_BITS, BC_ACC) .
  eq ipopcnt-bits-aux((# 1) BC_BITS, BC_ACC) = ipopcnt-bits-aux(BC_BITS, BC_ACC + 1) .

  vars BT_N BT_I BT_J : Nat .
  vars BT_BITS BT_ACC : SpectecTerminals .
  op irev-bits : SpectecTerminals -> SpectecTerminals .
  --- The prelude LIST reverse uses the same tail-recursive construction.
  op irev-bits-aux : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  eq irev-bits(BT_BITS) = irev-bits-aux(BT_BITS, nil) .
  eq irev-bits-aux(nil, BT_ACC) = BT_ACC .
  eq irev-bits-aux((# 0) BT_BITS, BT_ACC) = irev-bits-aux(BT_BITS, (# 0) BT_ACC) .
  eq irev-bits-aux((# 1) BT_BITS, BT_ACC) = irev-bits-aux(BT_BITS, (# 1) BT_ACC) .

  --- Implemented builtin family: integer shift/rotate operations.
  var SH_N : NzNat .
  vars SH_I SH_J SH_K : Nat .
  op shift-count : NzNat Nat -> Nat .
  eq shift-count(SH_N, SH_J) = _rem_(SH_J, SH_N) .

  --- Implemented builtin family: integer narrowing conversion.

  --- Implemented builtin family: unsigned rounded integer average.

  --- Implemented builtin family: signed i16 Q15 rounded multiply with saturation.
  vars Q15_N Q15_I : Nat .
  var Q15_X : Int .
  var Q15_P : Nat .
  op signed-nat : Nat Nat -> Int .
  op floor-div-pow2-int : Int Nat -> Int .
  op sat-s-int : Nat Int -> Int .
  op wrap-s-int : Nat Int -> Nat .
  ceq signed-nat(Q15_N, Q15_I) = Q15_I
    if _>_(Q15_N, 0)
       /\ _<_(Q15_I, _^_(2, _-_(Q15_N, 1))) .
  ceq signed-nat(Q15_N, Q15_I) = _-_(Q15_I, _^_(2, Q15_N))
    if _>_(Q15_N, 0)
       /\ _>=_(Q15_I, _^_(2, _-_(Q15_N, 1)))
       /\ _<_(Q15_I, _^_(2, Q15_N)) .
  ceq floor-div-pow2-int(Q15_X, Q15_P) = _quo_(Q15_X, Q15_P)
    if _>=_(Q15_X, 0)
       /\ _>_(Q15_P, 0) .
  ceq floor-div-pow2-int(Q15_X, Q15_P) = - _quo_(abs(Q15_X), Q15_P)
    if _<_(Q15_X, 0)
       /\ _>_(Q15_P, 0)
       /\ _rem_(abs(Q15_X), Q15_P) = 0 .
  ceq floor-div-pow2-int(Q15_X, Q15_P) = - _+_(_quo_(abs(Q15_X), Q15_P), 1)
    if _<_(Q15_X, 0)
       /\ _>_(Q15_P, 0)
       /\ _>_(_rem_(abs(Q15_X), Q15_P), 0) .
  ceq sat-s-int(Q15_N, Q15_X) = - _^_(2, _-_(Q15_N, 1))
    if _>_(Q15_N, 0)
       /\ _<_(Q15_X, - _^_(2, _-_(Q15_N, 1))) .
  ceq sat-s-int(Q15_N, Q15_X) = _-_(_^_(2, _-_(Q15_N, 1)), 1)
    if _>_(Q15_N, 0)
       /\ _>_(Q15_X, _-_( _^_(2, _-_(Q15_N, 1)), 1)) .
  ceq sat-s-int(Q15_N, Q15_X) = Q15_X
    if _>_(Q15_N, 0)
       /\ _>=_(Q15_X, - _^_(2, _-_(Q15_N, 1)))
       /\ _<=_(Q15_X, _-_( _^_(2, _-_(Q15_N, 1)), 1)) .
  ceq wrap-s-int(Q15_N, Q15_X) = Q15_X
    if _>=_(Q15_X, 0) .
  ceq wrap-s-int(Q15_N, Q15_X) = sd(_^_(2, Q15_N), abs(Q15_X))
    if _<_(Q15_X, 0) .

  --- Implemented builtin family: rational-to-integer helpers.
  var TZ_R : Rat .

  --- Implemented builtin family: structural floating-point representation/sign operations.
  vars FS_N FS_M : Nat .
  var FS_E : Int .
  vars FS_MAG FS_MAG2 : SpectecTerminal .
  op fnmag-valid : Nat SpectecTerminal -> Bool .
  ceq fnmag-valid(FS_N, NORM(FS_M, FS_E)) = true
    if _and_(_<_(FS_M, _^_(2, signif(FS_N))),
            _and_(_<=_(_+_(2, - _^_(2, _-_(expon(FS_N), 1))), FS_E),
                  _<=_(FS_E, _-_(_^_(2, _-_(expon(FS_N), 1)), 1)))) = true .
  ceq fnmag-valid(FS_N, SUBNORM(FS_M)) = true
    if _<_(FS_M, _^_(2, signif(FS_N))) .
  eq fnmag-valid(FS_N, INF) = true .
  ceq fnmag-valid(FS_N, NAN(FS_M)) = true
    if _and_(_<=_(1, FS_M), _<_(FS_M, _^_(2, signif(FS_N)))) = true .

  --- Implemented builtin family: exact finite floating-point rational model.
  vars FI_M FI_N FI_FRAC FI_RESULT : Nat .
  vars FC_N FC_M FC_BIT : Nat .
  vars FR_N FR_I FR_E FR_FRAC : Nat .
  vars FR_SHIFT FR_SCALE FR_Q FR_REM FR_HALF FR_SIG : Nat .
  vars FD_N FD_Q : Nat .
  var FP_M : Nat .
  vars SQ_N SQ_LO SQ_HI SQ_MID SQ_Q : Nat .
  var FI_E : Int .
  var FP_E : Int .
  vars FD_E FD_EMIN FD_EMAX : Int .
  vars SQ_E SQ_EMIN SQ_EMAX : Int .
  vars FC_R1 FC_R2 : Rat .
  var FR_R : Rat .
  var FI_R : Rat .
  var FD_R : Rat .
  var SQ_R : Rat .
  var FI_X : Int .
  vars FR_X FR_FLOOR FR_CEIL : Int .
  vars FI_F FI_MAG : SpectecTerminal .
  vars FC_F1 FC_F2 FC_MAG FC_MAG2 : SpectecTerminal .
  vars FR_SOURCE FR_MAG : SpectecTerminal .
  op scale-rat : Rat Int -> Rat .
  op fmag-rat : Nat SpectecTerminal -> Rat .
  op float-rat : Nat SpectecTerminal -> Rat .
  op float-finite : Nat SpectecTerminal -> Bool .
  op trunc-rat-int : Rat -> Int .
  op nearest-rat-int : Rat -> Int .
  op floor-log2 : Nat -> Nat .
  op floor-log2-rat : Rat -> Int .
  op nat-fmag-exact : Nat Nat -> Bool .
  op nat-to-fmag : Nat Nat -> SpectecTerminal .
  op round-nat-significand : Nat Nat -> Nat .
  op rounded-nat-to-fmag : Nat Nat -> SpectecTerminal .
  op round-rat-subnormal : Nat Rat -> SpectecTerminal .
  op round-rat-normal : Nat Rat Int -> SpectecTerminal .
  op round-rat-to-fmag : Nat Rat -> SpectecTerminal .
  op floor-half-int : Int -> Int .
  op floor-sqrt-rat-range : Rat Nat Nat -> Nat .
  op nearest-sqrt-rat-int : Rat Nat -> Nat .
  op sqrt-rat-subnormal : Nat Rat -> SpectecTerminal .
  op sqrt-rat-normal : Nat Rat Int -> SpectecTerminal .
  op sqrt-rat-to-fmag : Nat Rat -> SpectecTerminal .
  op sqrt-fmag : Nat SpectecTerminal -> SpectecTerminal .
  op int-to-float-like : Nat Int SpectecTerminal -> SpectecTerminal .
  op int-to-iN : Nat Int -> Nat .
  op saturate-u-int : Nat Int -> Nat .
  op saturate-s-int : Nat Int -> Nat .
  op bit-not : Nat -> Nat .
  op bit-and : Nat Nat -> Nat .
  op bit-or : Nat Nat -> Nat .
  op bit-xor : Nat Nat -> Nat .
  op float-nan-bit : Nat SpectecTerminal -> Nat .
  op float-sign-bit : Nat SpectecTerminal -> Nat .
  op float-eq-bit : Nat SpectecTerminal SpectecTerminal -> Nat .
  op float-lt-bit : Nat SpectecTerminal SpectecTerminal -> Nat .
  --- The possible NaN results of an operation whose NaN inputs, if any, are
  --- canonical: defined per version (wasm-VERSION.maude), as the results are
  --- lists (fN(N)*) and the NaN sign is chosen by the version's semantics.
  op float-default-nan : Nat -> SpectecTerminals .
  op float-canonical-nan : Nat SpectecTerminal -> SpectecTerminals .
  op float-binary-nan : Nat SpectecTerminal SpectecTerminal -> SpectecTerminals .
  op float-neg : Nat SpectecTerminal -> SpectecTerminal .
  op rat-to-float-nearest : Nat Rat -> SpectecTerminal .
  op rat-to-float-nearest-signed-zero : Nat Nat Rat -> SpectecTerminal .
  op float-signed-zero : Nat -> SpectecTerminal .
  op float-signed-inf : Nat -> SpectecTerminal .
  op float-add-result : Nat SpectecTerminal SpectecTerminal Rat -> SpectecTerminal .
  op float-min-equal : Nat SpectecTerminal SpectecTerminal -> SpectecTerminal .
  op float-max-equal : Nat SpectecTerminal SpectecTerminal -> SpectecTerminal .
  op float-min : Nat SpectecTerminal SpectecTerminal -> SpectecTerminals .
  op float-max : Nat SpectecTerminal SpectecTerminal -> SpectecTerminals .
  op float-pmin : Nat SpectecTerminal SpectecTerminal -> SpectecTerminal .
  op float-pmax : Nat SpectecTerminal SpectecTerminal -> SpectecTerminal .
  op promote-f32-normal-frac : Nat -> Nat .
  op promote-f32-subnorm-frac : Nat -> Nat .
  op promote-f32-subnorm-exp : Nat -> Int .
  op promote-f32 : SpectecTerminal -> SpectecTerminals .
  op demote-f64 : SpectecTerminal -> SpectecTerminals .
  ceq scale-rat(FI_R, FI_E) = _*_(FI_R, _^_(2, abs(FI_E)))
    if _>=_(FI_E, 0) .
  ceq scale-rat(FI_R, FI_E) = FI_R / _^_(2, abs(FI_E))
    if _<_(FI_E, 0) .
  ceq fmag-rat(FI_N, NORM(FI_FRAC, FI_E)) =
      scale-rat(_/_( _+_(_^_(2, signif(FI_N)), FI_FRAC), _^_(2, signif(FI_N))), FI_E)
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq fmag-rat(FI_N, SUBNORM(FI_FRAC)) =
      scale-rat(_/_(FI_FRAC, _^_(2, signif(FI_N))), _+_(2, - _^_(2, _-_(expon(FI_N), 1))))
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-rat(FI_N, POS(FI_MAG)) = fmag-rat(FI_N, FI_MAG)
    if (fnmag-valid(FI_N, FI_MAG)) = true .
  ceq float-rat(FI_N, NEG(FI_MAG)) = - fmag-rat(FI_N, FI_MAG)
    if (fnmag-valid(FI_N, FI_MAG)) = true .
  ceq float-finite(FI_N, POS(NORM(FI_FRAC, FI_E))) = true
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq float-finite(FI_N, NEG(NORM(FI_FRAC, FI_E))) = true
    if (fnmag-valid(FI_N, NORM(FI_FRAC, FI_E))) = true .
  ceq float-finite(FI_N, POS(SUBNORM(FI_FRAC))) = true
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-finite(FI_N, NEG(SUBNORM(FI_FRAC))) = true
    if (fnmag-valid(FI_N, SUBNORM(FI_FRAC))) = true .
  ceq float-nan-bit(FC_N, POS(NAN(FC_M))) = 1
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-nan-bit(FC_N, NEG(NAN(FC_M))) = 1
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-nan-bit(FC_N, FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  eq float-nan-bit(FC_N, POS(INF)) = 0 .
  eq float-nan-bit(FC_N, NEG(INF)) = 0 .
  eq bit-not(0) = 1 .
  eq bit-not(1) = 0 .
  eq bit-and(0, FC_BIT) = 0 .
  eq bit-and(FC_BIT, 0) = 0 .
  eq bit-and(1, 1) = 1 .
  eq bit-or(1, FC_BIT) = 1 .
  eq bit-or(FC_BIT, 1) = 1 .
  eq bit-or(0, 0) = 0 .
  eq bit-xor(0, 0) = 0 .
  eq bit-xor(0, 1) = 1 .
  eq bit-xor(1, 0) = 1 .
  eq bit-xor(1, 1) = 0 .
  ceq float-sign-bit(FC_N, POS(FC_MAG)) = 0
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq float-sign-bit(FC_N, NEG(FC_MAG)) = 1
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F2) = 1 .
  ceq float-eq-bit(FC_N, FC_F1, FC_F2) = spectec-bool(# _==_(FC_R1, FC_R2))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .
  eq float-eq-bit(FC_N, POS(INF), POS(INF)) = 1 .
  eq float-eq-bit(FC_N, NEG(INF), NEG(INF)) = 1 .
  eq float-eq-bit(FC_N, POS(INF), NEG(INF)) = 0 .
  eq float-eq-bit(FC_N, NEG(INF), POS(INF)) = 0 .
  ceq float-eq-bit(FC_N, FC_F1, POS(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, FC_F1, NEG(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, POS(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-eq-bit(FC_N, NEG(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = 0
    if float-nan-bit(FC_N, FC_F2) = 1 .
  ceq float-lt-bit(FC_N, FC_F1, FC_F2) = spectec-bool(# _<_(FC_R1, FC_R2))
    if (float-finite(FC_N, FC_F1)) = true
       /\ (float-finite(FC_N, FC_F2)) = true
       /\ FC_R1 := float-rat(FC_N, FC_F1)
       /\ FC_R2 := float-rat(FC_N, FC_F2) .
  eq float-lt-bit(FC_N, NEG(INF), POS(INF)) = 1 .
  eq float-lt-bit(FC_N, POS(INF), NEG(INF)) = 0 .
  eq float-lt-bit(FC_N, POS(INF), POS(INF)) = 0 .
  eq float-lt-bit(FC_N, NEG(INF), NEG(INF)) = 0 .
  ceq float-lt-bit(FC_N, NEG(INF), FC_F1) = 1
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, POS(INF), FC_F1) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, POS(INF)) = 1
    if (float-finite(FC_N, FC_F1)) = true .
  ceq float-lt-bit(FC_N, FC_F1, NEG(INF)) = 0
    if (float-finite(FC_N, FC_F1)) = true .
  --- A NaN input that is canonical gives the same results as no NaN input. A
  --- non-canonical one allows any arithmetic NaN; the canonical ones are among
  --- them (docs/TRANSLATION.md). Bit and sign operations bypass this.
  ceq float-canonical-nan(FC_N, POS(NAN(FC_M))) = float-default-nan(FC_N)
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-canonical-nan(FC_N, NEG(NAN(FC_M))) = float-default-nan(FC_N)
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, POS(NAN(FC_M)), FC_F2) =
      float-canonical-nan(FC_N, POS(NAN(FC_M)))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, NEG(NAN(FC_M)), FC_F2) =
      float-canonical-nan(FC_N, NEG(NAN(FC_M)))
    if (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, FC_F1, POS(NAN(FC_M))) =
      float-canonical-nan(FC_N, POS(NAN(FC_M)))
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-binary-nan(FC_N, FC_F1, NEG(NAN(FC_M))) =
      float-canonical-nan(FC_N, NEG(NAN(FC_M)))
    if float-nan-bit(FC_N, FC_F1) = 0
       /\ (fnmag-valid(FC_N, NAN(FC_M))) = true .
  ceq float-neg(FC_N, POS(FC_MAG)) = NEG(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq float-neg(FC_N, NEG(FC_MAG)) = POS(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true .
  ceq rat-to-float-nearest(FC_N, FR_R) = POS(round-rat-to-fmag(FC_N, FR_R))
    if _>_(FR_R, 0) .
  ceq rat-to-float-nearest(FC_N, FR_R) = NEG(round-rat-to-fmag(FC_N, - FR_R))
    if _<_(FR_R, 0) .
  eq rat-to-float-nearest(FC_N, 0) = POS(SUBNORM(0)) .
  eq float-signed-zero(0) = POS(SUBNORM(0)) .
  eq float-signed-zero(1) = NEG(SUBNORM(0)) .
  eq float-signed-inf(0) = POS(INF) .
  eq float-signed-inf(1) = NEG(INF) .
  ceq rat-to-float-nearest-signed-zero(FC_N, FC_BIT, FR_R) = rat-to-float-nearest(FC_N, FR_R)
    if _=/=_(FR_R, 0) .
  eq rat-to-float-nearest-signed-zero(FC_N, FC_BIT, 0) = float-signed-zero(FC_BIT) .
  eq float-add-result(FC_N, NEG(SUBNORM(0)), NEG(SUBNORM(0)), 0) = NEG(SUBNORM(0)) .
  ceq float-add-result(FC_N, FC_F1, FC_F2, FR_R) = rat-to-float-nearest(FC_N, FR_R)
    if _=/=_(FR_R, 0) .
  ceq float-add-result(FC_N, FC_F1, FC_F2, 0) = POS(SUBNORM(0))
    if _=/=_(FC_F1, NEG(SUBNORM(0))) .
  ceq float-add-result(FC_N, FC_F1, FC_F2, 0) = POS(SUBNORM(0))
    if _=/=_(FC_F2, NEG(SUBNORM(0))) .
  ceq float-min-equal(FC_N, NEG(FC_MAG), FC_F2) = NEG(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ float-eq-bit(FC_N, NEG(FC_MAG), FC_F2) = 1 .
  ceq float-min-equal(FC_N, POS(FC_MAG), NEG(FC_MAG2)) = NEG(FC_MAG2)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ (fnmag-valid(FC_N, FC_MAG2)) = true
       /\ float-eq-bit(FC_N, POS(FC_MAG), NEG(FC_MAG2)) = 1 .
  ceq float-min-equal(FC_N, POS(FC_MAG), POS(FC_MAG2)) = POS(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ (fnmag-valid(FC_N, FC_MAG2)) = true
       /\ float-eq-bit(FC_N, POS(FC_MAG), POS(FC_MAG2)) = 1 .
  ceq float-max-equal(FC_N, POS(FC_MAG), FC_F2) = POS(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ float-eq-bit(FC_N, POS(FC_MAG), FC_F2) = 1 .
  ceq float-max-equal(FC_N, NEG(FC_MAG), POS(FC_MAG2)) = POS(FC_MAG2)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ (fnmag-valid(FC_N, FC_MAG2)) = true
       /\ float-eq-bit(FC_N, NEG(FC_MAG), POS(FC_MAG2)) = 1 .
  ceq float-max-equal(FC_N, NEG(FC_MAG), NEG(FC_MAG2)) = NEG(FC_MAG)
    if (fnmag-valid(FC_N, FC_MAG)) = true
       /\ (fnmag-valid(FC_N, FC_MAG2)) = true
       /\ float-eq-bit(FC_N, NEG(FC_MAG), NEG(FC_MAG2)) = 1 .
  ceq float-min(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
    if float-nan-bit(FC_N, FC_F1) = 1 .
  ceq float-min(FC_N, FC_F1, FC_F2) = float-binary-nan(FC_N, FC_F1, FC_F2)
