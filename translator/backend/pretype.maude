fmod SPECTEC-TERM is
  sort SpectecTerminal .
  sort SpectecTerminals .
  subsort SpectecTerminal < SpectecTerminals .
  sort SpectecType .
  sort SpectecDef .
endfm

--- Maude의 native typed list를 먼저 선언한 뒤, (hint(maude_sort) 때문) 
--- 공통 빈 리스트 eps와 리스트 연결 연산 __을 선언해야 함
load ../generated/types.maude

fmod SPECTEC-PRETYPE is
  protecting SPEC2MAUDE-TYPES . --- in ../generated/typed.maude
  protecting CONVERSION * ( --- RAT, FLOAT, STRING, BOOL, NAT, INT
    op -_ : Float -> Float to nativeFloatNeg,
    op _+_ : Float Float -> Float to nativeFloatAdd,
    op _-_ : Float Float -> Float to nativeFloatSub,
    op _*_ : Float Float -> Float to nativeFloatMul,
    op _/_ : Float Float -> Float to nativeFloatDiv,
    op _rem_ : Float Float -> Float to floatRem,
    op _^_ : Float Float -> Float to nativeFloatPow,
    op abs : Float -> Float to floatAbs,
    op floor : Float -> Float to floatFloor,
    op ceiling : Float -> Float to floatCeiling,
    op min : Float Float -> Float to floatMin,
    op max : Float Float -> Float to floatMax,
    op _<_ : Float Float -> Bool to floatLess,
    op _<=_ : Float Float -> Bool to floatLessEqual,
    op _>_ : Float Float -> Bool to floatGreater,
    op _>=_ : Float Float -> Bool to floatGreaterEqual,
    op _xor_ : Nat Nat -> Nat to integerXor,
    op _+_ : String String -> String to stringConcat,
    op _<_ : String String -> Bool to stringLess,
    op _<=_ : String String -> Bool to stringLessEqual,
    op _>_ : String String -> Bool to stringGreater,
    op _>=_ : String String -> Bool to stringGreaterEqual,
    op char : Nat -> Char to nativeChar,
    op float : Rat -> Float to nativeToFloat,
    op rat : FiniteFloat -> Rat to nativeToRat,
    op float : String -> Float to nativeParseFloat,
    op rat : String NzNat -> Rat to nativeParseRat,
    op string : Float -> String to nativeFloatString,
    op string : Rat NzNat -> String to nativeRatString
  ) . --- Maude prelude에서 Float/String 등의 동일 이름 연산(ex: _+_)이 충돌하는 것을 피하기 위해 renaming


  protecting QID * ( --- for RECORD
    op _xor_ : Nat Nat -> Nat to integerXor,
    op _+_ : String String -> String to stringConcat,
    op _<_ : String String -> Bool to stringLess,
    op _<=_ : String String -> Bool to stringLessEqual,
    op _>_ : String String -> Bool to stringGreater,
    op _>=_ : String String -> Bool to stringGreaterEqual,
    op char : Nat -> Char to nativeChar
  ) .

  --- 기본 타입 (ast.ml line 28 & num.ml line 14)
  subsorts Bool Rat Float String < SpectecTerminal .

  ops bool nat int rat real text : -> SpectecType [ctor] .
  ops iterOpt iterList : SpectecType -> SpectecType [ctor] .

  op typecheck : SpectecTerminals SpectecType -> Bool .

  var B : Bool .
  var N : Nat .
  var I : Int .
  var R : Rat .
  var F : Float .
  var S : String .
  eq typecheck(B, bool) = true .
  eq typecheck(N, nat) = true .
  eq typecheck(I, int) = true .
  eq typecheck(R, rat) = true .
  eq typecheck(F, real) = true .
  eq typecheck(S, text) = true .

  --- 수치 타입 변환 CvtE
  op _:_<:>_ : SpectecTerminal SpectecType SpectecType ~> SpectecTerminal .

  --- SpecTec의 수치 연산 모듈(lib/xl/num.ml)의 CvtE 규칙 그대로, 
  --- 현재 wasm 3.0 SpecTec에서 사용하는 모든 수치 변환을 Maude로 구현                                            
  var CV_N : Nat .
  var CV_I : Int .
  var CV_R : Rat .
  eq (CV_N : nat <:> nat) = CV_N . --- 같은 타입
  eq (CV_N : nat <:> int) = CV_N . --- 자연수는 이미 정수에 포함되므로 그대로 반환
  eq (CV_N : nat <:> rat) = CV_N . --- 자연수는 이미 유리수에 포함되므로 그대로 반환
  ceq (CV_I : int <:> nat) = CV_I  
    if CV_I >= 0 .
  eq (CV_I : int <:> int) = CV_I . --- 같은 타입
  eq (CV_I : int <:> rat) = CV_I . --- 정수는 이미 유리수에 포함되므로 그대로 반환
  ceq (CV_R : rat <:> nat) = floor(CV_R)
    if CV_R == floor(CV_R) /\ CV_R >= 0 .
  ceq (CV_R : rat <:> int) = floor(CV_R) 
    if CV_R == floor(CV_R) .
  eq (CV_R : rat <:> rat) = CV_R .

  --- List
  op eps : -> SpectecTerminals [ctor] .
  op __ : SpectecTerminals SpectecTerminals -> SpectecTerminals [ctor assoc id: eps prec 25] .
  op seq : SpectecTerminals -> SpectecTerminal [ctor] .
  op unseq : SpectecTerminal ~> SpectecTerminals .

  vars T U : SpectecTerminal .
  vars TS VALUE : SpectecTerminals .
  var TYPE : SpectecType .
  var COUNT : Nat .
  vars WTS PREFIX MIDDLE SUFFIX REST : SpectecTerminals .

  eq unseq(seq(TS)) = TS .

  --- 리스트 길이
  op len : SpectecTerminals -> Nat .

  --- 리스트 길이를 구하려면 각 원소를 한 번씩 확인해야 함
  --- 큰 리스트에서도 재귀 호출이 많이 쌓이지 않도록 현재 길이를 인자로 전달
  op lenAux : SpectecTerminals Nat -> Nat .
  eq len(TS) = lenAux(TS, 0) .
  eq lenAux(eps, N) = N .
  eq lenAux(T TS, N) = lenAux(TS, N + 1) .

  --- 리스트 타입 검사
  eq typecheck(eps, TYPE) = true .
  ceq typecheck(T U TS, TYPE) = typecheck(U TS, TYPE) --- 두 원소 패턴을 사용하여 단일 원소가 T eps로 매칭되는 것을 방지
    if typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterList(TYPE)) = typecheck(TS, TYPE) .
  eq typecheck(VALUE, TYPE) = false [owise] .

  --- 리스트 포함 검사 (리스트에서 같은 값을 패턴 매칭으로 찾음)
  op _<-_ : SpectecTerminal SpectecTerminals -> Bool .
  eq T <- (PREFIX T SUFFIX) = true .
  eq T <- TS = false [owise] .

  --- 리스트 연결
  op _++_ : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  eq TS ++ WTS = TS WTS .

  --- 리스트 반복
  op repeatSeq : Nat SpectecTerminals -> SpectecTerminals .

  eq repeatSeq(0, WTS) = eps .
  eq repeatSeq(1, WTS) = WTS .
  ceq repeatSeq(N, WTS) = repeatSeq(N quo 2, WTS WTS) repeatSeq(N rem 2, WTS) --- 리스트를 두 배씩 늘려 적은 재귀 호출로 반복
    if N > 1 .

  --- 리스트 인덱싱
  op indexDefined : SpectecTerminals Nat -> Bool .
  op _[_] : SpectecTerminals Nat ~> SpectecTerminal [prec 10 gather (E e)] .

  eq indexDefined(TS, N) = N < len(TS) . --- 주어진 인덱스가 리스트 범위 안에 존재하는가를 검사
  ceq (PREFIX T SUFFIX)[N] = T
    if len(PREFIX) == N .

  --- 리스트 구간 추출
  op _[_:_] : SpectecTerminals Nat Nat ~> SpectecTerminals [prec 10 gather (E e e)] .
  
  --- 리스트를 앞부분, 추출할 구간, 뒷부분으로 나누어 범위를 검사 (길이가 0인 빈 구간도 추출할 수 있음)
  ceq (PREFIX REST)[N : COUNT] = MIDDLE
    if len(PREFIX) == N /\ MIDDLE SUFFIX := REST /\ len(MIDDLE) == COUNT .

  --- 리스트 원소 갱신
  op _[_=_] : SpectecTerminals Nat SpectecTerminal ~> SpectecTerminals [prec 10 gather (E e e)] .
  var NEW-K : SpectecTerminal .

  ceq (PREFIX T SUFFIX)[N = NEW-K] = PREFIX NEW-K SUFFIX
    if len(PREFIX) == N .
  
  --- 리스트 구간 갱신
  op _[_:_=_] : SpectecTerminals Nat Nat SpectecTerminals ~> SpectecTerminals [prec 10 gather (E e e e)] .
  var NEW-TS : SpectecTerminals .
  
  ceq (PREFIX REST)[N : COUNT = NEW-TS] = PREFIX NEW-TS SUFFIX
    if len(PREFIX) == N /\ MIDDLE SUFFIX := REST /\ len(MIDDLE) == COUNT .

  --- Option
  op _? : SpectecTerminal -> SpectecTerminal [ctor] .
  var K : SpectecTerminal .
  
  --- Option 결합: 두 option을 이어 붙이되, 결과가 원소 0개 또는 1개인 경우만 정의
  --- 양쪽 모두 값이 있으면 결과가 2개가 되므로 정의하지 않음
  op optionConcat : SpectecTerminals SpectecTerminals ~> SpectecTerminals .

  eq optionConcat(eps, eps) = eps .
  eq optionConcat(K ?, eps) = K ? .
  eq optionConcat(eps, K ?) = K ? .

  --- Option 타입 검사
  eq typecheck(T ?, TYPE) = typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterOpt(TYPE)) = typecheck(TS, TYPE) and len(TS) <= 1 .
      --- SpecTec에 (val?)*처럼 option을 원소로 갖는 리스트가 있음
      --- translator는 각 내부 option을 seq(eps) 또는 seq(K ?)로 포장함
      --- 포장하지 않으면 eps가 리스트 결합 연산의 identity이므로 eps K ?가 K ?로 단순화되어 None 원소가 사라지기 때문
      --- 그 원소의 타입 TYPE?를 Maude에서 iterOpt(TYPE)으로 나타냄

  --- Option을 리스트로 변환 (Option 값을 일반 리스트와 이어 붙여야 하는 경우에 사용)
  op lift : SpectecTerminals ~> SpectecTerminals .
  eq lift(eps) = eps .
  eq lift(K ?) = K .

  --- Tuple
  sort Tuple .
  subsort Tuple < SpectecTerminal .

  op tuple : SpectecTerminals -> Tuple [ctor] .
  op _._ : Tuple Nat ~> SpectecTerminal .

  eq tuple(TS) . N = TS[N] .

  --- Record
  sorts Record RecordField RecordFields .
  subsort Record < SpectecTerminal .
  subsort RecordField < RecordFields .

  op EMPTY : -> RecordFields [ctor] .
  op _;_ : RecordFields RecordFields -> RecordFields [ctor assoc id: EMPTY] .
  op field : Qid SpectecTerminals -> RecordField [ctor] .
  op {_} : RecordFields -> Record [ctor] .
  op _._ : Record Qid -> SpectecTerminals . --- 필드 조회 (DotE)
  op recordConcat : Record Record SpectecType ~> Record . --- 레코드 결합 (CompE) / Record 타입마다 결합 방법이 달라서 eq는 자동 생성됨
  op _[._=_] : Record Qid SpectecTerminals -> Record . --- 필드 갱신 (UpdE + DotP)

  op hasField : RecordFields Qid -> Bool . --- 첫 일치 필드를 찾기 위한 보조 연산 (IL에는 없음)

  var FIELD : Qid .
  vars FIELDS RECORD-PREFIX RECORD-SUFFIX : RecordFields .
  var NEW-VALUE : SpectecTerminals .

  eq hasField(RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX, FIELD) = true .
  eq hasField(FIELDS, FIELD) = false [owise] .
  ceq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX} . FIELD = VALUE --- 첫 번째 필드만 선택
    if not hasField(RECORD-PREFIX, FIELD) .
  eq {FIELDS} . FIELD = eps [owise] .

  ceq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX}[. FIELD = NEW-VALUE]
    = {RECORD-PREFIX ; field(FIELD, NEW-VALUE) ; RECORD-SUFFIX}
    if not hasField(RECORD-PREFIX, FIELD) .
  eq {FIELDS}[. FIELD = NEW-VALUE] = {FIELDS ; field(FIELD, NEW-VALUE)} [owise] . --- 없으면 레코드 끝에 추가
endfm
