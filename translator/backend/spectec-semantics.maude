load spectec-sorts.maude

--- The common list (prelude LIST) comes from spectec-sorts.maude; the lists of
--- hint(maude_sort) are declared as its subsorts in types.maude
load ../generated/types.maude

load spectec-builtin-types.maude

fmod SPECTEC-CONVERT is
  protecting SPECTEC-BUILTIN-TYPES .

  --- Numeric conversion (CvtE)
  op _:_<:>_ : Rat SpectecType SpectecType ~> Rat . --- converts native values, used directly in arithmetic

  --- The conversions of lib/xl/num.ml (Num.cvt); real is not supported
  --- (rejected by the translator, term.ml)
  var CV_N : Nat .
  var CV_I : Int .
  var CV_R : Rat .
  eq (CV_N : nat <:> nat) = CV_N .
  eq (CV_N : nat <:> int) = CV_N . --- Nat is a subsort of Int
  eq (CV_N : nat <:> rat) = CV_N . --- Nat is a subsort of Rat
  ceq (CV_I : int <:> nat) = CV_I
    if CV_I >= 0 .
  eq (CV_I : int <:> int) = CV_I .
  eq (CV_I : int <:> rat) = CV_I . --- Int is a subsort of Rat
  ceq (CV_R : rat <:> nat) = floor(CV_R)
    if CV_R == floor(CV_R) /\ CV_R >= 0 .
  ceq (CV_R : rat <:> int) = floor(CV_R)
    if CV_R == floor(CV_R) .
  eq (CV_R : rat <:> rat) = CV_R .
endfm

fmod SPECTEC-LIST is
  protecting SPECTEC-BUILTIN-TYPES .

  --- Lists (nil, __, size, occurs, append: prelude LIST, spectec-sorts.maude)
  var N : Nat .
  op seq : SpectecTerminals -> SpectecTerminal [ctor] .
  op unseq : SpectecTerminal ~> SpectecTerminals .

  var T : SpectecTerminal .
  vars TS VALUE : SpectecTerminals .
  var NTS : SpectecNeTerminals .
  var TYPE : SpectecType .
  var COUNT : Nat .
  vars WTS PREFIX MIDDLE SUFFIX REST : SpectecTerminals .

  eq unseq(seq(TS)) = TS .

  --- List type check
  eq typecheck(nil, TYPE) = true .
  ceq typecheck(T NTS, TYPE) = typecheck(NTS, TYPE) --- NTS is nonempty, so one element does not match T nil
    if typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterList(TYPE)) = typecheck(TS, TYPE) .
  eq typecheck(VALUE, TYPE) = false [owise] .

  --- List repetition
  op repeatSeq : Nat SpectecTerminals -> SpectecTerminals .

  eq repeatSeq(0, WTS) = nil .
  eq repeatSeq(s N, WTS) = WTS repeatSeq(N, WTS) .

  --- List indexing
  op _[_] : SpectecTerminals Nat ~> SpectecTerminal [prec 10 gather (E e)] .

  --- skips the leading elements one by one to the N-th
  eq (T TS)[0] = T .
  eq (T TS)[(s N)] = TS[N] .

  --- List slice
  op _[_:_] : SpectecTerminals Nat Nat ~> SpectecTerminals [prec 10 gather (E e e)] .

  --- skips to the start, then takes COUNT elements one by one (an empty slice is allowed)
  eq (T TS)[(s N) : COUNT] = TS[N : COUNT] .
  eq TS[0 : 0] = nil .
  eq (T TS)[0 : (s COUNT)] = T TS[0 : COUNT] .

  --- List element update
  op _[_=_] : SpectecTerminals Nat SpectecTerminal ~> SpectecTerminals [prec 10 gather (E e e)] .
  var NEW-K : SpectecTerminal .

  --- keeps the leading elements and replaces the N-th
  eq (T TS)[0 = NEW-K] = NEW-K TS .
  eq (T TS)[(s N) = NEW-K] = T TS[N = NEW-K] .

  --- List slice update
  op _[_:_=_] : SpectecTerminals Nat Nat SpectecTerminals ~> SpectecTerminals [prec 10 gather (E e e e)] .
  var NEW-TS : SpectecTerminals .

  --- keeps the elements before the start, drops COUNT elements, and inserts the new ones
  eq (T TS)[(s N) : COUNT = NEW-TS] = T TS[N : COUNT = NEW-TS] .
  eq (T TS)[0 : (s COUNT) = NEW-TS] = TS[0 : COUNT = NEW-TS] .
  eq TS[0 : 0 = NEW-TS] = NEW-TS TS .
endfm

fmod SPECTEC-OPTION is
  protecting SPECTEC-LIST .

  --- Option
  var T : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .
  op _? : SpectecTerminal -> SpectecTerminal [ctor] .
  var K : SpectecTerminal .

  --- Option composition: defined only when the result has at most one element;
  --- two present values have no result
  op optionConcat : SpectecTerminals SpectecTerminals ~> SpectecTerminals .

  eq optionConcat(nil, nil) = nil .
  eq optionConcat(K ?, nil) = K ? .
  eq optionConcat(nil, K ?) = K ? .

  --- Option type T? (iterOpt(T)): a value is nil (absent; typecheck(nil, TYPE) above) or one V ?
  --- e.g. syntax reftype = REF null? heaptype -> typecheck(NULL?, iterOpt(null))
  eq typecheck(T ?, iterOpt(TYPE)) = typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterOpt(TYPE)) = typecheck(TS, iterOpt(TYPE)) .
      --- A list may have options as elements, as in (val?)*:
      --- the translator boxes each inner option as seq(nil) or seq(K ?),
      --- since nil is the identity of concatenation and an absent element would vanish;
      --- the element type TYPE? is iterOpt(TYPE)

  --- Option as a list (to concatenate an option with a list)
  op lift : SpectecTerminals ~> SpectecTerminals .
  eq lift(nil) = nil .
  eq lift(K ?) = K .
endfm

fmod SPECTEC-TUPLE is
  protecting SPECTEC-LIST .

  --- Tuple
  var TS : SpectecTerminals .
  var N : Nat .
  sort Tuple .
  subsort Tuple < SpectecTerminal .

  op tuple : SpectecTerminals -> Tuple [ctor] .
  op _._ : Tuple Nat ~> SpectecTerminal .

  eq tuple(TS) . N = TS[N] .
endfm

fmod SPECTEC-RECORD is
  protecting SPECTEC-LIST .

  --- Record
  var VALUE : SpectecTerminals .
  sorts Record RecordField RecordFields .
  subsort Record < SpectecTerminal .
  subsort RecordField < RecordFields .

  op EMPTY : -> RecordFields [ctor] .
  op _;_ : RecordFields RecordFields -> RecordFields [ctor assoc id: EMPTY] .
  op field : Qid SpectecTerminals -> RecordField [ctor] .
  op {_} : RecordFields -> Record [ctor] .
  op _._ : Record Qid ~> SpectecTerminals . --- field access (DotE)
  op recordConcat : Record Record SpectecType ~> Record . --- record composition (CompE); its equations are generated per record type
  op _[._=_] : Record Qid SpectecTerminals ~> Record . --- field update (UpdE with DotP)

  var FIELD : Qid .
  vars FIELDS RECORD-PREFIX RECORD-SUFFIX : RecordFields .
  var NEW-VALUE : SpectecTerminals .

  eq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX} . FIELD = VALUE .

  eq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX}[. FIELD = NEW-VALUE]
    = {RECORD-PREFIX ; field(FIELD, NEW-VALUE) ; RECORD-SUFFIX} .
endfm

--- hint(maude_array) (record field): the sequence field is stored as a size and a prelude ARRAY
--- (default # 0: cells equal to 0 are not stored, by prelude ARRAY insert and _[_])
view Zero from DEFAULT to SPECTEC-BUILTIN-TYPES is
  sort Elt to SpectecTerminal .
  op 0 to term # 0 .
endv

fmod SPECTEC-ARRAY is
  protecting SPECTEC-LIST .
  protecting ARRAY{Nat, Zero} * (sort Array{Nat, Zero} to ZeroArray, sort Entry{Nat, Zero} to ZeroEntry) .

  op sized-array : Nat ZeroArray -> SpectecTerminal [ctor] .                    --- size, array
  op array-of : SpectecTerminals -> SpectecTerminal .                            --- sequence to array
  op array-size : SpectecTerminal ~> Nat .                                       --- |e.f|
  op array-read : SpectecTerminal Nat Nat ~> SpectecTerminals .                  --- e.f[I : C]
  op array-write : SpectecTerminal Nat Nat SpectecTerminals ~> SpectecTerminal . --- e[.f[I : C] = TS], |TS| = C
  op array-grow : SpectecTerminal Nat ~> SpectecTerminal .                       --- f 0^K

  vars S I C K : Nat .
  var A : ZeroArray .
  var T : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .

  eq array-of(TS) = array-write(sized-array(size(TS), empty), 0, size(TS), TS) .

  eq array-size(sized-array(S, A)) = S .
  ceq array-read(sized-array(S, A), I, 0) = nil if I <= S .
  ceq array-read(sized-array(S, A), I, s C) = A[I] array-read(sized-array(S, A), s I, C) if I + s C <= S .
  ceq array-write(sized-array(S, A), I, 0, nil) = sized-array(S, A) if I <= S .
  ceq array-write(sized-array(S, A), I, s C, T TS) = array-write(sized-array(S, insert(I, T, A)), s I, C, TS) if I + s C <= S .
  eq array-grow(sized-array(S, A), K) = sized-array(S + K, A) .

  --- element type check: the stored cells and the default # 0
  eq typecheck(sized-array(S, empty), TYPE) = typecheck(# 0, TYPE) .
  eq typecheck(sized-array(S, (I |-> T ; A)), TYPE) = I < S and typecheck(T, TYPE) and typecheck(sized-array(S, A), TYPE) .
endfm

--- hint(maude_map) (record field): the sequence field is stored as a size and a prelude MAP
--- (every index 0 .. size-1 has exactly one entry, so reads and writes match that
--- entry directly instead of the prelude M[I] and insert, which look for duplicate keys;
--- a read or write at a missing index has no value)
view Terminal from TRIV to SPECTEC-BUILTIN-TYPES is
  sort Elt to SpectecTerminal .
endv

fmod SPECTEC-MAP is
  protecting SPECTEC-LIST .
  protecting MAP{Nat, Terminal} * (sort Map{Nat, Terminal} to TerminalMap,
    sort Entry{Nat, Terminal} to TerminalEntry, op _|->_ to _|=>_) .

  op sized-map : Nat TerminalMap -> SpectecTerminal [ctor] .                   --- size, map
  op map-of : SpectecTerminals -> SpectecTerminal .                            --- sequence → map
  op map-size : SpectecTerminal ~> Nat .                                       --- |e.f|
  op map-read : SpectecTerminal Nat ~> SpectecTerminal .                       --- e.f[I]
  op map-write : SpectecTerminal Nat SpectecTerminal ~> SpectecTerminal .      --- e[.f[I] = T]
  op map-append : SpectecTerminal SpectecTerminals ~> SpectecTerminal .        --- e.f TS
  op map-concat : SpectecTerminal SpectecTerminal ~> SpectecTerminal .         --- a field of record ++

  vars S S' I : Nat .
  vars M M' : TerminalMap .
  vars T T' : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .

  eq map-of(TS) = map-append(sized-map(0, empty), TS) .

  eq map-size(sized-map(S, M)) = S .
  eq map-read(sized-map(S, (I |=> T, M)), I) = T .
  eq map-write(sized-map(S, (I |=> T', M)), I, T) = sized-map(S, (I |=> T, M)) .
  eq map-append(sized-map(S, M), nil) = sized-map(S, M) .
  eq map-append(sized-map(S, M), T TS) = map-append(sized-map(s S, (M, S |=> T)), TS) .
  eq map-concat(sized-map(S, M), sized-map(S', empty)) = sized-map(S + S', M) .
  eq map-concat(sized-map(S, M), sized-map(S', (I |=> T, M')))
    = map-concat(sized-map(S, (M, S + I |=> T)), sized-map(S', M')) .

  --- element type check: every stored cell
  eq typecheck(sized-map(S, empty), TYPE) = true .
  eq typecheck(sized-map(S, (I |=> T, M)), TYPE) = I < S and typecheck(T, TYPE) and typecheck(sized-map(S, M), TYPE) .
endfm

fmod SPECTEC-SEMANTICS is
  protecting EXT-BOOL .
  protecting SPECTEC-CONVERT .
  protecting SPECTEC-LIST .
  protecting SPECTEC-OPTION .
  protecting SPECTEC-TUPLE .
  protecting SPECTEC-RECORD .
  protecting SPECTEC-ARRAY .
  protecting SPECTEC-MAP .
endfm
