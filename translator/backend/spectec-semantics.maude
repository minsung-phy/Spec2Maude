load spectec-sorts.maude

--- 공통 리스트(prelude LIST)는 spectec-sorts.maude에서 가져오고,
--- hint(maude_sort) 리스트는 types.maude에서 그 위에 subsort로 선언함
load ../generated/types.maude

load spectec-builtin-types.maude

fmod SPECTEC-CONVERT is
  protecting SPECTEC-BUILTIN-TYPES .

  --- 수치 타입 변환 CvtE
  op _:_<:>_ : Rat SpectecType SpectecType ~> Rat . --- native 값끼리 변환해 바로 산술에 사용

  --- SpecTec의 수치 연산 모듈(lib/xl/num.ml)의 CvtE 규칙 그대로, 
  --- 현재 wasm 3.0 SpecTec에서 사용하는 모든 수치 변환을 Maude로 구현                                            
  var CV_N : Nat .
  var CV_I : Int .
  var CV_R : Rat .
  eq (CV_N : nat <:> nat) = CV_N . --- 같은 타입
  eq (CV_N : nat <:> int) = CV_N . --- 자연수는 이미 정수에 포함되므로 그대로 반환
  eq (CV_N : nat <:> rat) = CV_N . --- 자연수는 이미 유리수에 포함되므로 그대로 반환
  ceq (CV_I : int <:> nat) = CV_I  
    if CV_I >= 0 .
  eq (CV_I : int <:> int) = CV_I . --- 같은 타입
  eq (CV_I : int <:> rat) = CV_I . --- 정수는 이미 유리수에 포함되므로 그대로 반환
  ceq (CV_R : rat <:> nat) = floor(CV_R)
    if CV_R == floor(CV_R) /\ CV_R >= 0 .
  ceq (CV_R : rat <:> int) = floor(CV_R) 
    if CV_R == floor(CV_R) .
  eq (CV_R : rat <:> rat) = CV_R .
endfm

fmod SPECTEC-LIST is
  protecting SPECTEC-BUILTIN-TYPES .

  --- List (nil, __, size, occurs, append는 prelude LIST, spectec-sorts.maude)
  var N : Nat .
  op seq : SpectecTerminals -> SpectecTerminal [ctor] .
  op unseq : SpectecTerminal ~> SpectecTerminals .

  var T : SpectecTerminal .
  vars TS VALUE : SpectecTerminals .
  var NTS : SpectecNeTerminals .
  var TYPE : SpectecType .
  var COUNT : Nat .
  vars WTS PREFIX MIDDLE SUFFIX REST : SpectecTerminals .

  eq unseq(seq(TS)) = TS .

  --- 리스트 타입 검사
  eq typecheck(nil, TYPE) = true .
  ceq typecheck(T NTS, TYPE) = typecheck(NTS, TYPE) --- NTS는 비어 있지 않으므로 단일 원소는 T nil로 매칭되지 않음
    if typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterList(TYPE)) = typecheck(TS, TYPE) .
  eq typecheck(VALUE, TYPE) = false [owise] .

  --- 리스트 반복
  op repeatSeq : Nat SpectecTerminals -> SpectecTerminals .

  eq repeatSeq(0, WTS) = nil .
  eq repeatSeq(s N, WTS) = WTS repeatSeq(N, WTS) .
    --- repeatSeq 이전 버전
    --- eq repeatSeq(0, WTS) = nil .
    --- eq repeatSeq(1, WTS) = WTS .
    --- ceq repeatSeq(N, WTS) = repeatSeq(N quo 2, WTS WTS) repeatSeq(N rem 2, WTS) if N > 1 .

  --- 리스트 인덱싱
  op _[_] : SpectecTerminals Nat ~> SpectecTerminal [prec 10 gather (E e)] .

  --- 앞 원소를 하나씩 넘기며 N번째 원소를 찾음
  eq (T TS)[0] = T .
  eq (T TS)[(s N)] = TS[N] .

  --- 리스트 구간 추출
  op _[_:_] : SpectecTerminals Nat Nat ~> SpectecTerminals [prec 10 gather (E e e)] .
  
  --- 시작 위치까지 앞 원소를 넘긴 뒤, COUNT개를 하나씩 가져옴 (길이가 0인 빈 구간도 추출할 수 있음)
  eq (T TS)[(s N) : COUNT] = TS[N : COUNT] .
  eq TS[0 : 0] = nil .
  eq (T TS)[0 : (s COUNT)] = T TS[0 : COUNT] .

  --- 리스트 원소 갱신
  op _[_=_] : SpectecTerminals Nat SpectecTerminal ~> SpectecTerminals [prec 10 gather (E e e)] .
  var NEW-K : SpectecTerminal .

  --- 앞 원소를 남겨 두고 N번째 원소를 새 값으로 바꿈
  eq (T TS)[0 = NEW-K] = NEW-K TS .
  eq (T TS)[(s N) = NEW-K] = T TS[N = NEW-K] .
  
  --- 리스트 구간 갱신
  op _[_:_=_] : SpectecTerminals Nat Nat SpectecTerminals ~> SpectecTerminals [prec 10 gather (E e e e)] .
  var NEW-TS : SpectecTerminals .
  
  --- 시작 위치까지 앞 원소를 남기고, COUNT개를 하나씩 버린 뒤 새 구간을 넣음
  eq (T TS)[(s N) : COUNT = NEW-TS] = T TS[N : COUNT = NEW-TS] .
  eq (T TS)[0 : (s COUNT) = NEW-TS] = TS[0 : COUNT = NEW-TS] .
  eq TS[0 : 0 = NEW-TS] = NEW-TS TS .
endfm

fmod SPECTEC-OPTION is
  protecting SPECTEC-LIST .

  --- Option
  var T : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .
  op _? : SpectecTerminal -> SpectecTerminal [ctor] .
  var K : SpectecTerminal .
  
  --- Option 결합: 두 option을 이어 붙이되, 결과가 원소 0개 또는 1개인 경우만 정의
  --- 양쪽 모두 값이 있으면 결과가 2개가 되므로 정의하지 않음
  op optionConcat : SpectecTerminals SpectecTerminals ~> SpectecTerminals .

  eq optionConcat(nil, nil) = nil .
  eq optionConcat(K ?, nil) = K ? .
  eq optionConcat(nil, K ?) = K ? .

  --- Option 타입 검사 (spectec/wasm-3.0/1.2-syntax.types.spectec:47 -> syntax reftype = REF null? heaptype를 maude로 변환시 typecheck(NULL-, null))
  eq typecheck(T ?, TYPE) = typecheck(T, TYPE) .
  eq typecheck(seq(TS), iterOpt(TYPE)) = typecheck(TS, TYPE) and size(TS) <= 1 .
      --- SpecTec에 (val?)*처럼 option을 원소로 갖는 리스트가 있음
      --- translator는 각 내부 option을 seq(nil) 또는 seq(K ?)로 포장함
      --- 포장하지 않으면 nil이 리스트 결합 연산의 identity이므로 nil K ?가 K ?로 단순화되어 None 원소가 사라지기 때문
      --- 그 원소의 타입 TYPE?를 Maude에서 iterOpt(TYPE)으로 나타냄

  --- Option을 리스트로 변환 (Option 값을 일반 리스트와 이어 붙여야 하는 경우에 사용)
  op lift : SpectecTerminals ~> SpectecTerminals .
  eq lift(nil) = nil .
  eq lift(K ?) = K .
endfm

fmod SPECTEC-TUPLE is
  protecting SPECTEC-LIST .

  --- Tuple
  var TS : SpectecTerminals .
  var N : Nat .
  sort Tuple .
  subsort Tuple < SpectecTerminal .

  op tuple : SpectecTerminals -> Tuple [ctor] .
  op _._ : Tuple Nat ~> SpectecTerminal .

  eq tuple(TS) . N = TS[N] .
endfm

fmod SPECTEC-RECORD is
  protecting SPECTEC-LIST .

  --- Record
  var VALUE : SpectecTerminals .
  sorts Record RecordField RecordFields .
  subsort Record < SpectecTerminal .
  subsort RecordField < RecordFields .

  op EMPTY : -> RecordFields [ctor] .
  op _;_ : RecordFields RecordFields -> RecordFields [ctor assoc id: EMPTY] .
  op field : Qid SpectecTerminals -> RecordField [ctor] .
  op {_} : RecordFields -> Record [ctor] .
  op _._ : Record Qid -> SpectecTerminals . --- 필드 조회 (DotE)
  op recordConcat : Record Record SpectecType ~> Record . --- 레코드 결합 (CompE) / Record 타입마다 결합 방법이 달라서 eq는 자동 생성됨
  op _[._=_] : Record Qid SpectecTerminals -> Record . --- 필드 갱신 (UpdE + DotP)

  var FIELD : Qid .
  vars FIELDS RECORD-PREFIX RECORD-SUFFIX : RecordFields .
  var NEW-VALUE : SpectecTerminals .

  eq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX} . FIELD = VALUE .
  eq {FIELDS} . FIELD = nil [owise] .

  eq {RECORD-PREFIX ; field(FIELD, VALUE) ; RECORD-SUFFIX}[. FIELD = NEW-VALUE]
    = {RECORD-PREFIX ; field(FIELD, NEW-VALUE) ; RECORD-SUFFIX} .
  eq {FIELDS}[. FIELD = NEW-VALUE] = {FIELDS ; field(FIELD, NEW-VALUE)} [owise] . --- 없으면 레코드 끝에 추가
endfm

--- hint(maude_array "FIELD"): 레코드의 sequence 필드를 크기 + prelude ARRAY로 저장
--- (기본값 # 0: 0인 칸은 저장하지 않음, prelude ARRAY의 insert와 _[_])
view Zero from DEFAULT to SPECTEC-BUILTIN-TYPES is
  sort Elt to SpectecTerminal .
  op 0 to term # 0 .
endv

fmod SPECTEC-ARRAY is
  protecting SPECTEC-LIST .
  protecting ARRAY{Nat, Zero} * (sort Array{Nat, Zero} to ZeroArray, sort Entry{Nat, Zero} to ZeroEntry) .

  op bytes : Nat ZeroArray -> SpectecTerminal [ctor] .                      --- 크기, 배열
  op bytes-of : SpectecTerminals -> SpectecTerminal .                       --- 필드에 저장할 값 (sequence → 배열)
  op bsize : SpectecTerminal ~> Nat .                                       --- |e.f|
  op bread : SpectecTerminal Nat Nat ~> SpectecTerminals .                  --- e.f[I : C]
  op bwrite : SpectecTerminal Nat Nat SpectecTerminals ~> SpectecTerminal . --- e[.f[I : C] = TS], |TS| = C
  op bgrow : SpectecTerminal Nat ~> SpectecTerminal .                       --- f 0^K

  vars S I C K : Nat .
  var A : ZeroArray .
  var T : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .

  eq bytes-of(bytes(S, A)) = bytes(S, A) .  --- 필드 패턴으로 받은 값은 이미 배열
  eq bytes-of(TS) = bwrite(bytes(size(TS), empty), 0, size(TS), TS) [owise] .

  eq bsize(bytes(S, A)) = S .
  ceq bread(bytes(S, A), I, 0) = nil if I <= S .
  ceq bread(bytes(S, A), I, s C) = A[I] bread(bytes(S, A), s I, C) if I + s C <= S .
  ceq bwrite(bytes(S, A), I, 0, nil) = bytes(S, A) if I <= S .
  ceq bwrite(bytes(S, A), I, s C, T TS) = bwrite(bytes(S, insert(I, T, A)), s I, C, TS) if I + s C <= S .
  eq bgrow(bytes(S, A), K) = bytes(S + K, A) .

  --- 원소 타입 검사: 저장된 칸과 기본값 # 0만 확인
  eq typecheck(bytes(S, empty), TYPE) = typecheck(# 0, TYPE) .
  eq typecheck(bytes(S, (I |-> T ; A)), TYPE) = I < S and typecheck(T, TYPE) and typecheck(bytes(S, A), TYPE) .
endfm

fmod SPECTEC-SEMANTICS is
  protecting SPECTEC-CONVERT .
  protecting SPECTEC-LIST .
  protecting SPECTEC-OPTION .
  protecting SPECTEC-TUPLE .
  protecting SPECTEC-RECORD .
  protecting SPECTEC-ARRAY .
endfm
