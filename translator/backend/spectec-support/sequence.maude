fmod DSL-SEQUENCE is
  protecting DSL-OPTION .

  op [_] : SpectecTerminals -> SpectecTerminals [prec 50] .
  eq [TS] = TS .

  --- Cache canonical lists, without changing their representation or length.
  op len : SpectecTerminals -> Nat [memo] .
  op |_| : SpectecTerminals -> Nat .
  --- A traversal marker avoids repeatedly copying canonical AU array tails.
  --- It is not an element and is removed before returning a source sequence.
  op seqCursor : -> SpectecTerminals [ctor] .
  op repeatSeq : Nat SpectecTerminals -> SpectecTerminals .

  vars N I : Nat .
  var K : [SpectecTerminal] .
  vars T U : SpectecTerminal .
  vars TS WTS : SpectecTerminals .
  var TYPE : SpectecType .

  op lenAux : SpectecTerminals Nat -> Nat .
  eq len(eps) = 0 .
  eq len(T) = 1 .
  ceq len(T TS) = lenAux(seqCursor TS, 1)
    if TS =/= eps .
  eq lenAux(seqCursor, N) = N .
  eq lenAux(seqCursor T TS, N) = lenAux(seqCursor TS, N + 1) .
  eq | TS | = len(TS) .

  eq typecheck(seq(TS), iterOpt(TYPE)) =
    typecheck(TS, TYPE) and len(TS) <= 1 .
  eq typecheck(seq(TS), iterList(TYPE)) = typecheck(TS, TYPE) .
  eq typecheck(seq(TS), iterList1(TYPE)) =
    typecheck(TS, TYPE) and 0 < len(TS) .
  eq typecheck(seq(TS), iterListN(TYPE, N)) =
    typecheck(TS, TYPE) and len(TS) == N .

  --- IL MEM compares a value with a list of values; failed operands remain kinds.
  op _<-_ : SpectecTerminal SpectecTerminals ~> Bool .
  eq T <- eps = false .
  eq T <- (T TS) = true .
  ceq T <- (U TS) = T <- TS
    if T =/= U .

  op _++_ : SpectecTerminals SpectecTerminals -> SpectecTerminals .
  eq TS ++ WTS = TS WTS .

  op indexDefined : SpectecTerminals Nat -> Bool .
  op index : SpectecTerminals Nat ~> SpectecTerminal .
  eq indexDefined(TS, N) = N < len(TS) .
  eq index(T TS, 0) = T .
  eq index(T TS, s(N)) = index(TS, N) .

  op _[_] : SpectecTerminals Nat ~> SpectecTerminal
    [prec 10 gather (E e)] .
  eq TS[N] = index(TS, N) .

  op take : SpectecTerminals Nat -> SpectecTerminals .
  op drop : SpectecTerminals Nat -> SpectecTerminals .
  op slice : SpectecTerminals Nat Nat ~> SpectecTerminals .

  op dropAux : SpectecTerminals Nat -> SpectecTerminals .
  --- Both cursors retain a deque during traversal, avoiding repeated suffix
  --- scans and deep recursion while constructing the same ordinary sequence.
  op takeAux : SpectecTerminals Nat SpectecTerminals -> SpectecTerminals .
  var PREFIX : SpectecTerminals .
  eq take(TS, N) = takeAux(seqCursor TS, N, seqCursor) .
  eq takeAux(seqCursor TS, 0, seqCursor PREFIX) = PREFIX .
  eq takeAux(seqCursor, N, seqCursor PREFIX) = PREFIX .
  eq takeAux(seqCursor T TS, s(N), seqCursor PREFIX) =
      takeAux(seqCursor TS, N, seqCursor PREFIX T) .

  eq drop(TS, 0) = TS .
  eq drop(eps, N) = eps .
  eq drop(T TS, s(N)) = dropAux(seqCursor TS, N) .
  eq dropAux(seqCursor TS, 0) = TS .
  eq dropAux(seqCursor, N) = eps .
  eq dropAux(seqCursor T TS, s(N)) = dropAux(seqCursor TS, N) .

  --- An out-of-bounds slice has no normal sequence result, including length 0.
  ceq slice(TS, N, I) = take(drop(TS, N), I)
    if N + I <= len(TS) .
  op _[_:_] : SpectecTerminals Nat Nat ~> SpectecTerminals
    [prec 10 gather (E e e)] .
  eq TS[N : I] = slice(TS, N, I) .

  op setAt : SpectecTerminals Nat SpectecTerminal ~> SpectecTerminals .
  op _[_=_] : SpectecTerminals Nat SpectecTerminal ~> SpectecTerminals
    [prec 10 gather (E e e)] .
  var NEW-K : [SpectecTerminal] .
  var NEW-TS : SpectecTerminals .

  ceq setAt(TS, N, NEW-K) = take(TS, N) NEW-K drop(TS, N + 1)
    if indexDefined(TS, N) .
  eq TS[N = NEW-K] = setAt(TS, N, NEW-K) .

  op splice : SpectecTerminals Nat Nat SpectecTerminals ~> SpectecTerminals .
  op _[_:_=_] : SpectecTerminals Nat Nat SpectecTerminals ~> SpectecTerminals
    [prec 10 gather (E e e e)] .
  op spliceAux : SpectecTerminals Nat Nat SpectecTerminals SpectecTerminals
    ~> SpectecTerminals .
  ceq splice(TS, N, I, NEW-TS)
    = spliceAux(seqCursor TS, N, I, NEW-TS, seqCursor)
    if N + I <= len(TS) .
  --- Retain the prefix while advancing to the replacement position once.
  eq spliceAux(seqCursor TS, 0, I, NEW-TS, seqCursor PREFIX)
    = PREFIX NEW-TS drop(TS, I) .
  eq spliceAux(seqCursor T TS, s(N), I, NEW-TS, seqCursor PREFIX)
    = spliceAux(seqCursor TS, N, I, NEW-TS, seqCursor PREFIX T) .
  eq TS[N : I = NEW-TS] = splice(TS, N, I, NEW-TS) .

  op lift : SpectecTerminals -> SpectecTerminals .
  eq lift(eps) = eps .
  eq lift(K ?) = K .

  --- Double the ordinary sequence, rather than introduce a compressed value.
  --- The recursive count halves, so large repetitions do not need linear depth.
  eq repeatSeq(0, WTS) = eps .
  eq repeatSeq(1, WTS) = WTS .
  ceq repeatSeq(N, WTS)
    = repeatSeq(N quo 2, WTS WTS) repeatSeq(N rem 2, WTS)
    if 1 < N .

endfm
