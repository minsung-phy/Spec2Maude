--- Typed lists are supplied by source hints before the common list extension.
--- Declaring the common operators here preserves their shared overloading.
fmod DSL-PRETYPE-COMMON is
  protecting DSL-TYPED-LISTS .

  sort SpectecTerminals .
  subsort SpectecTerminal < SpectecTerminals .
  op eps : -> SpectecTerminals [ctor] .
  op __ : SpectecTerminals SpectecTerminals -> SpectecTerminals
    [ctor assoc id: eps prec 25] .
  op seq : SpectecTerminals -> SpectecTerminal [ctor] .
  op unseq : SpectecTerminal ~> SpectecTerminals .

  var TS : SpectecTerminals .
  var TYPE : SpectecType .
  eq unseq(seq(TS)) = TS .
  eq typecheck(eps, TYPE) = true .
endfm

--- Shared associative lists expose the next element directly.
fmod DSL-PRETYPE-LISTS is
  protecting DSL-PRETYPE-COMMON .
  vars T U : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .
  var VALUE : [SpectecTerminal] .
  ceq typecheck(T U TS, TYPE) = typecheck(U TS, TYPE)
    if typecheck(T, TYPE) .
  eq typecheck(VALUE, TYPE) = false [owise] .
endfm

--- A distinct hinted list family can be an opaque generic suffix.
fmod DSL-PRETYPE-SEPARATE-LISTS is
  protecting DSL-PRETYPE-COMMON .
  var T : SpectecTerminal .
  var TS : SpectecTerminals .
  var TYPE : SpectecType .
  var VALUE : [SpectecTerminal] .
  ceq typecheck(T TS, TYPE) = typecheck(TS, TYPE)
    if TS =/= eps /\ typecheck(T, TYPE) .
  eq typecheck(VALUE, TYPE) = false [owise] .
endfm
