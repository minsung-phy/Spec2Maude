fmod SPECTEC-BUILTIN-TYPES is
  protecting SPEC2MAUDE-TYPES . --- in ../generated/typed.maude
  protecting CONVERSION . --- RAT, FLOAT, STRING, BOOL, NAT, INT
  protecting QID . --- for RECORD

  --- 기본 타입 (ast.ml line 28 & num.ml line 14)
  --- IMP처럼 native 값을 생성자로 감싼다. subsort로 두면 Bool, Rat, Float, String이
  --- SpectecTerminal과 한 kind가 되어 prelude의 같은 이름 연산이 충돌한다.
  op #_ : Bool -> SpectecTerminal [ctor] .
  op #_ : Rat -> SpectecTerminal [ctor] .
  op #_ : Float -> SpectecTerminal [ctor] .
  op #_ : String -> SpectecTerminal [ctor] .

  --- 매칭으로 꺼낼 수 없는 식 중간에서만 쓰는 부분 함수
  op #bool : SpectecTerminal ~> Bool .
  op #rat : SpectecTerminal ~> Rat .
  op #float : SpectecTerminal ~> Float .
  op #string : SpectecTerminal ~> String .

  ops bool nat int rat real text : -> SpectecType [ctor] .
  ops iterOpt iterList : SpectecType -> SpectecType [ctor] .

  op typecheck : SpectecTerminals SpectecType -> Bool .

  var B : Bool .
  var N : Nat .
  var I : Int .
  var R : Rat .
  var F : Float .
  var S : String .
  eq #bool(# B) = B .
  eq #rat(# R) = R .
  eq #float(# F) = F .
  eq #string(# S) = S .

  eq typecheck(# B, bool) = true .
  eq typecheck(# N, nat) = true .
  eq typecheck(# I, int) = true .
  eq typecheck(# R, rat) = true .
  eq typecheck(# F, real) = true .
  eq typecheck(# S, text) = true .
endfm
